# Public site metadata
SITE_URL=https://greenacreeaglesfc.com

# Supabase browser-safe values
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Supabase server-only values (store as an encrypted Cloudflare secret)
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-secret

# Cloudflare R2 bucket names and bindings
R2_PUBLIC_BUCKET_NAME=greenacre-eagles-public-media
R2_PRIVATE_BUCKET_NAME=greenacre-eagles-private-media
PUBLIC_MEDIA_BASE_URL=https://media.greenacreeaglesfc.com

# R2 S3-compatible maintenance credentials (never used by browser code)
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_S3_ENDPOINT=

# Media configuration
PUBLIC_MEDIA_MAX_FILE_SIZE=10485760
PRIVATE_MEDIA_MAX_FILE_SIZE=20971520
PUBLIC_MEDIA_ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/avif,application/pdf
PRIVATE_MEDIA_ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/avif,application/pdf
MEDIA_MAX_IMAGE_WIDTH=2560
MEDIA_MAX_IMAGE_HEIGHT=2560
MEDIA_IMAGE_QUALITY=82
MEDIA_THUMBNAIL_WIDTH=400
MEDIA_CARD_IMAGE_WIDTH=800
MEDIA_FULL_IMAGE_WIDTH=1600
PRIVATE_MEDIA_SIGNED_URL_TTL=900
PUBLIC_MEDIA_CACHE_MAX_AGE=86400
PUBLIC_MEDIA_CACHE_S_MAXAGE=604800
MEDIA_ORPHAN_CLEANUP_HOURS=24
MEDIA_AUDIT_LOGGING_ENABLED=true

# Payment configuration
# Club policy default: PAYMENT_PROVIDER=manual (pay-at-the-club). Do not change unless an
# online gateway (e.g. stripe, square) has been fully integrated and tested.
PAYMENT_PROVIDER=manual
# Only required when PAYMENT_PROVIDER is an online gateway; manual mode never calls a
# webhook and this value can be left as the placeholder below.
PAYMENT_WEBHOOK_SECRET=replace-with-long-random-shared-secret

# Cloudflare Turnstile
# PUBLIC_TURNSTILE_SITE_KEY is browser-safe. TURNSTILE_SECRET_KEY must be encrypted.
PUBLIC_TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret
TURNSTILE_ALLOWED_HOSTNAMES=greenacreeaglesfc.com,www.greenacreeaglesfc.com,website-4h5.pages.dev

# Email configuration (API credentials must be encrypted Cloudflare secrets)
SMTP_API_KEY=replace-with-smtp-secret
EMAIL_FROM_NAME=Greenacre Eagles FC
EMAIL_FROM_ADDRESS=notifications@auth.greenacreeaglesfc.com
EMAIL_REPLY_TO=replace-with-club-email
BREVO_API_KEY=replace-with-brevo-secret
