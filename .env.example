# Public site metadata

SITE_URL=https://website-4h5.pages.dev

# Supabase browser-safe values
# Use the project URL and publishable/anon key from Supabase Project Settings > API.

PUBLIC_SUPABASE_URL=https://qzqezldtklimtupajvxf.supabase.co
PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-publishable-or-anon-key

# Supabase server-only values
# Never expose these in browser code.

SUPABASE_SERVICE_ROLE_KEY=replace-only-in-secure-server-runtime

# Cloudflare R2 bucket names

R2_PUBLIC_BUCKET_NAME=greenacre-eagles-public-media
R2_PRIVATE_BUCKET_NAME=greenacre-eagles-private-media

# Cloudflare Pages R2 binding names
# Configure these through the Cloudflare Pages dashboard.

R2_PUBLIC_BUCKET_BINDING=PUBLIC_MEDIA_BUCKET
R2_PRIVATE_BUCKET_BINDING=PRIVATE_MEDIA_BUCKET

# Public media delivery URL
# Leave blank until public R2 delivery is configured.
# This can initially be an r2.dev URL and later a custom media domain.

PUBLIC_MEDIA_BASE_URL=

# R2 S3-compatible credentials
# Used only for local migration, bulk upload, backup or maintenance scripts.
# Production application requests should use Cloudflare R2 bindings.

CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_S3_ENDPOINT=

# Media upload limits
# Values are in bytes.

PUBLIC_MEDIA_MAX_FILE_SIZE=10485760
PRIVATE_MEDIA_MAX_FILE_SIZE=20971520

# Allowed upload MIME types

PUBLIC_MEDIA_ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/avif,application/pdf
PRIVATE_MEDIA_ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/avif,application/pdf

# Image processing
# Oversized uploaded images should be resized before permanent storage.

MEDIA_MAX_IMAGE_WIDTH=2560
MEDIA_MAX_IMAGE_HEIGHT=2560
MEDIA_IMAGE_QUALITY=82

# Generated responsive image widths

MEDIA_THUMBNAIL_WIDTH=400
MEDIA_CARD_IMAGE_WIDTH=800
MEDIA_FULL_IMAGE_WIDTH=1600

# Private media access
# Signed URL lifetime in seconds.

PRIVATE_MEDIA_SIGNED_URL_TTL=900

# Public media caching
# Cache lifetime in seconds.

PUBLIC_MEDIA_CACHE_MAX_AGE=86400
PUBLIC_MEDIA_CACHE_S_MAXAGE=604800

# Media cleanup
# Delete abandoned uploads after this many hours.

MEDIA_ORPHAN_CLEANUP_HOURS=24

# Media audit logging

MEDIA_AUDIT_LOGGING_ENABLED=true

# Payment configuration

PAYMENT_PROVIDER=manual
PAYMENT_WEBHOOK_SECRET=replace-with-long-random-shared-secret

# Cloudflare Turnstile

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
