---
import LogoLockup from "@components/LogoLockup.astro";
import { canAccessAdmin, hasAnyPermission } from "@lib/auth/permissions";
import type { PortalSession } from "@lib/auth/session";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface NavItem {
  href: string;
  label: string;
  permissions?: string[];
}

interface Props {
  title: string;
  section?: string;
  session: PortalSession;
}

const { title, section = "Portal", session } = Astro.props;
const pageTitle = `${title} | Greenacre Eagles FC`;

const portalNav: NavItem[] = [
  { href: "/portal/account/", label: "My account" },
  { href: "/portal/roles/", label: "My roles" },
  { href: "/portal/teams/", label: "Teams" },
  { href: "/portal/family/", label: "Family groups" },
  { href: "/portal/vouchers/", label: "Wallet" },
  { href: "/portal/canteen/", label: "Canteen" },
  { href: "/portal/canteen-staff/", label: "Canteen Staff", permissions: ["canteen.orders.fulfil"] },
  { href: "/portal/merchandise/", label: "Merchandise" },
  { href: "/portal/coaching/", label: "Coaching Resources", permissions: ["coaching_resources.read", "teams.manage"] },
  { href: "/portal/notice-board/", label: "Club Notice Board" }
];

const adminNav: NavItem[] = [
  { href: "/admin/", label: "Admin Overview", permissions: ["users.read", "content.manage", "events.manage", "merchandise.manage", "canteen.manage", "registrations.view", "club_structure.manage"] },
  { href: "/admin/canteen/", label: "Canteen", permissions: ["canteen.manage", "canteen.products.manage", "canteen.orders.manage", "canteen.reports.view"] },
  { href: "/admin/merchandise/", label: "Merchandise", permissions: ["merchandise.manage", "merchandise.store_access"] },
  { href: "/admin/events/", label: "Events", permissions: ["events.manage"] },
  { href: "/admin/event-tickets/", label: "Event tickets", permissions: ["events.manage", "events.orders.read", "events.tickets.scan", "events.tickets.redeem"] },
  { href: "/admin/news/", label: "News", permissions: ["content.manage"] },
  { href: "/admin/highlights/", label: "Social Hub", permissions: ["social_profiles.view", "social_profiles.manage", "social_posts.view", "social_posts.manage"] },
  { href: "/admin/coaching-resources/", label: "Coaching Resources", permissions: ["coaching_resources.manage"] },
  { href: "/admin/teams/", label: "Teams", permissions: ["club_structure.manage", "team_memberships.manage", "teams.manage"] },
  { href: "/admin/sponsors/", label: "Sponsors", permissions: ["sponsors.view", "sponsors.manage"] },
  { href: "/admin/wallets/", label: "Wallet", permissions: ["wallet.read", "wallet.adjust", "wallet.vouchers.manage", "finance.read"] },
  { href: "/admin/volunteers/", label: "Volunteers & WWCC", permissions: ["volunteers.view", "wwcc.view"] },
  { href: "/admin/roles/", label: "Roles & permissions", permissions: ["roles.read", "roles.manage"] },
  { href: "/admin/users/", label: "Users and Access", permissions: ["users.read"] }
];

const childNav = portalNav.filter((item) =>
  ["/portal/account/", "/portal/teams/", "/portal/vouchers/", "/portal/canteen/"].includes(item.href)
);
const visiblePortalNav = (session.isChildAccount ? childNav : portalNav).filter((item) => !item.permissions || hasAnyPermission(session.permissions, item.permissions));
const visibleAdminNav = adminNav.filter((item) => !item.permissions || hasAnyPermission(session.permissions, item.permissions));
const showAdmin = !session.isChildAccount && canAccessAdmin(session.permissions);
const activePath = Astro.url.pathname;
const inAdmin = activePath.startsWith("/admin/");
const displayName = session.profile.preferred_name || session.profile.full_name || session.user.email || "Greenacre Eagles member";
const isActiveNav = (href: string) => activePath === href || (href !== "/admin/" && href !== "/portal/" && activePath.startsWith(href));
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{pageTitle}</title>
    <meta name="description" content="Secure Greenacre Eagles FC portal." />
    <meta name="theme-color" content="#07875f" />
    <ClientRouter />
  </head>
  <body class="bg-eagles-mist">
    <div class="min-h-screen min-w-0 lg:grid lg:grid-cols-[minmax(0,16.5rem)_minmax(0,1fr)] xl:grid-cols-[minmax(0,17.5rem)_minmax(0,1fr)]">
      <aside class="min-w-0 border-b border-eagles-line bg-white lg:sticky lg:top-0 lg:h-screen lg:overflow-y-auto lg:border-b-0 lg:border-r">
        <div class="flex items-center justify-between gap-3 p-3 sm:gap-4 sm:p-4 lg:block lg:p-5">
          <div class="min-w-0 flex-1"><LogoLockup tone="dark" href="/" /></div>
          <form method="post" action="/api/auth/signout" class="lg:hidden">
            <button class="focus-ring whitespace-nowrap text-sm font-black text-eagles-pine hover:text-eagles-ink" type="submit">Sign out</button>
          </form>
        </div>
        <details class="mx-3 mb-3 border border-eagles-line bg-eagles-mist sm:mx-4 sm:mb-4 lg:hidden" style="border-radius:8px">
          <summary class="focus-ring flex min-h-11 cursor-pointer items-center justify-between gap-2 px-4 py-3 text-sm font-black text-eagles-ink">
            <span class="min-w-0">{inAdmin ? "Administration menu" : "Portal menu"}</span><span aria-hidden="true">☰</span>
          </summary>
          <div class="max-h-[min(70dvh,32rem)] overflow-y-auto overscroll-contain border-t border-eagles-line bg-white p-3">
            {!inAdmin && <nav class="grid gap-1 text-sm font-black" aria-label="Mobile portal navigation">{visiblePortalNav.map((item) => <a class="portal-nav-link whitespace-normal" href={item.href} aria-current={isActiveNav(item.href) ? "page" : undefined}>{item.label}</a>)}</nav>}
            {showAdmin && !inAdmin && <a class="focus-ring mt-3 inline-flex min-h-11 w-full items-center justify-center bg-eagles-ink px-4 py-3 text-sm font-black text-white hover:bg-eagles-pine" style="border-radius:8px" href="/admin/">Open administration</a>}
            {showAdmin && inAdmin && <><nav class="grid gap-1 text-sm font-black" aria-label="Mobile admin navigation">{visibleAdminNav.map((item) => <a class="portal-nav-link whitespace-normal" href={item.href} aria-current={isActiveNav(item.href) ? "page" : undefined}>{item.label}</a>)}</nav><a class="focus-ring mt-3 inline-flex min-h-11 items-center text-sm font-black text-eagles-pine" href="/portal/">Back to portal</a></>}
          </div>
        </details>
        {!inAdmin && (
          <nav class="hidden gap-2 px-4 pb-4 text-sm font-black lg:grid lg:px-6" aria-label="Portal navigation">
            {visiblePortalNav.map((item) => (
              <a class="portal-nav-link" href={item.href} aria-current={isActiveNav(item.href) ? "page" : undefined}>{item.label}</a>
            ))}
          </nav>
        )}
        {showAdmin && (
          <div class="hidden border-t border-eagles-line px-4 py-4 lg:block lg:px-6">
            {!inAdmin && <a class="focus-ring inline-flex min-h-11 w-full items-center justify-center bg-eagles-ink px-4 py-3 text-sm font-black text-white hover:bg-eagles-pine" style="border-radius:8px" href="/admin/">Admin</a>}
            {inAdmin && (
              <>
                <p class="text-xs font-black uppercase tracking-[.16em] text-eagles-pine">Administration</p>
                <nav class="mt-3 flex gap-2 overflow-x-auto text-sm font-black lg:grid" aria-label="Admin navigation">
                  {visibleAdminNav.map((item) => (
                    <a class="portal-nav-link" href={item.href} aria-current={isActiveNav(item.href) ? "page" : undefined}>{item.label}</a>
                  ))}
                </nav>
                <a class="focus-ring mt-4 inline-flex text-sm font-black text-eagles-pine hover:text-eagles-ink" href="/portal/">Back to portal</a>
              </>
            )}
          </div>
        )}
        <div class="hidden border-t border-eagles-line p-6 lg:block">
          <p class="text-sm font-black text-eagles-ink">{displayName}</p>
          <p class="mt-1 text-xs text-eagles-ink/60">{session.user.email}</p>
          <p class="mt-3 text-xs font-bold text-eagles-ink/60">{session.unreadNotifications} unread notifications</p>
          <form method="post" action="/api/auth/signout" class="mt-4">
            <button class="focus-ring text-sm font-black text-eagles-pine hover:text-eagles-ink" type="submit">Sign out</button>
          </form>
        </div>
      </aside>

      <div class="min-w-0">
        <header class="min-w-0 border-b border-eagles-line bg-white px-4 py-4 sm:px-6 sm:py-5 md:px-8">
          <p class="text-xs font-black uppercase tracking-[.14em] text-eagles-pine">{section}</p>
          <h1 class="page-title mt-2">{title}</h1>
        </header>
        <main class="min-w-0 px-4 py-5 sm:px-6 sm:py-6 md:px-8">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
