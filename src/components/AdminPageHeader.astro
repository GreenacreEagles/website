---
interface Props {
  title: string;
  intro?: string;
}

const { title, intro } = Astro.props;
---

<header class="surface flex flex-col gap-4 p-4 sm:p-5 md:flex-row md:items-start md:justify-between md:p-6">
  <div class="min-w-0 max-w-3xl">
    <h2 class="panel-title text-eagles-ink">{title}</h2>
    {intro && <p class="mt-2 text-sm leading-6 text-eagles-ink/70 md:mt-3 md:text-base">{intro}</p>}
  </div>
  <div class="grid w-full min-w-0 gap-2 sm:flex sm:w-auto sm:flex-wrap md:justify-end [&>*]:w-full sm:[&>*]:w-auto">
    <slot name="actions" />
  </div>
</header>
