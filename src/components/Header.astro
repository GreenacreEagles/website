---
import LogoLockup from "@components/LogoLockup.astro";
import Icon from "@components/Icon.astro";

const navItems = [
  { href: "/", label: "Home" },
  { href: "/about/", label: "About" },
  { href: "/teams/", label: "Teams" },
  { href: "/news/", label: "News" },
  { href: "/social/", label: "Follow us" },
  { href: "/events/", label: "Events" },
  { href: "/canteen/", label: "Canteen" },
  { href: "/merchandise/", label: "Merchandise" },
  { href: "/sponsors/", label: "Sponsors" },
  { href: "/contact/", label: "Contact" }
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-eagles-line/80 bg-white/95 shadow-sm backdrop-blur">
  <div class="header-shell min-h-[4.5rem]">
    <LogoLockup tone="dark" />
    <nav class="hidden min-w-0 flex-1 items-center justify-end gap-0.5 2xl:flex" aria-label="Primary navigation">
      {
        navItems.map((item) => (
          <a
            class="nav-link"
            href={item.href}
            aria-current={currentPath === item.href ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="/portal/"
        class="focus-ring ml-2 inline-flex shrink-0 items-center gap-2 whitespace-nowrap bg-eagles-pine px-3.5 py-2.5 text-sm font-black text-white hover:bg-eagles-ink"
        style="border-radius:8px"
      >
        Portal
      </a>
    </nav>
    <button
      class="focus-ring inline-flex h-11 w-11 shrink-0 items-center justify-center border border-eagles-line text-eagles-ink hover:border-eagles-green hover:bg-eagles-mist 2xl:hidden"
      style="border-radius:8px"
      type="button"
      aria-label="Open navigation"
      aria-expanded="false"
      data-menu-toggle
    >
      <span data-menu-open-icon><Icon name="menu" class="h-5 w-5" /></span>
      <span class="hidden" data-menu-close-icon><Icon name="x" class="h-5 w-5" /></span>
    </button>
  </div>
  <nav class="hidden max-h-[calc(100dvh-4.5rem)] overflow-y-auto overscroll-contain border-t border-eagles-line bg-white 2xl:hidden" data-mobile-menu aria-label="Mobile navigation">
    <div class="section-shell grid gap-1 py-3">
      {
        navItems.map((item) => (
          <a
            class="nav-link justify-between whitespace-normal"
            href={item.href}
            aria-current={currentPath === item.href ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a class="focus-ring mt-2 bg-eagles-pine px-4 py-3 text-center text-sm font-black text-white hover:bg-eagles-ink" style="border-radius:8px" href="/portal/">
        Portal login
      </a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.querySelector("[data-mobile-menu]");
  const openIcon = document.querySelector("[data-menu-open-icon]");
  const closeIcon = document.querySelector("[data-menu-close-icon]");

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!isOpen));
    toggle.setAttribute("aria-label", isOpen ? "Open navigation" : "Close navigation");
    menu?.classList.toggle("hidden", isOpen);
    openIcon?.classList.toggle("hidden", !isOpen);
    closeIcon?.classList.toggle("hidden", isOpen);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || toggle?.getAttribute("aria-expanded") !== "true") return;
    toggle.setAttribute("aria-expanded", "false");
    toggle.setAttribute("aria-label", "Open navigation");
    menu?.classList.add("hidden");
    openIcon?.classList.remove("hidden");
    closeIcon?.classList.add("hidden");
    toggle.focus();
  });
</script>
