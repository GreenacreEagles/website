---
import Icon from "@components/Icon.astro";
import { formatDate } from "@lib/content";
import type { PublicArticle } from "@lib/public-content";

interface Props {
  article: PublicArticle;
}

const { article } = Astro.props;
const href = `/news/${article.slug}/`;
---

<a href={href} class="surface block overflow-hidden">
  <img src={article.image ?? "/media/placeholders/matchday-card.svg"} alt="" class="aspect-[16/10] w-full object-cover" loading="lazy" />
  <div class="p-4">
    <div class="flex flex-wrap items-center gap-2 text-sm font-bold text-eagles-green sm:gap-3">
      <span>{article.category}</span>
      <span class="inline-flex items-center gap-1 text-eagles-ink/60">
        <Icon name="calendar" class="h-4 w-4" />
        {formatDate(new Date(article.date))}
      </span>
    </div>
    <h3 class="card-title mt-2 text-eagles-ink">{article.title}</h3>
    <p class="mt-2.5 line-clamp-3 text-sm leading-6 text-eagles-ink/70 sm:text-base sm:leading-7">{article.summary}</p>
  </div>
</a>
