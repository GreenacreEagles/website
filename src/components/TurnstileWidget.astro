---
import { getTurnstileSiteKey } from "@lib/security/turnstile";

type Props = {
  action: string;
};

const { action } = Astro.props;
const siteKey = getTurnstileSiteKey();
---

{siteKey && (
  <div
    class="cf-turnstile"
    data-sitekey={siteKey}
    data-action={action}
    data-theme="light"
    data-size="flexible"
  />
)}
