---
import type { PublicTeamSummary } from "@lib/public-teams";
interface Props { team: PublicTeamSummary; }
const { team } = Astro.props;
const details = [team.seasonName, team.division || team.competition].filter(Boolean);
---
<a class="surface block overflow-hidden" href={`/teams/${team.slug}/`}>
  {team.imageUrl ? (
    <img src={team.imageUrl} alt="" class="aspect-[16/10] w-full object-cover" loading="lazy" />
  ) : (
    <div class="flex aspect-[16/10] items-center justify-center bg-eagles-green text-white">
      <span class="font-display text-4xl font-black uppercase" aria-hidden="true">GEFC</span>
    </div>
  )}
  <div class="p-4">
    <h3 class="card-title text-eagles-ink">{team.name}</h3>
    {details.length > 0 && <p class="mt-2 text-sm font-bold text-eagles-ink/60">{details.join(" · ")}</p>}
    {team.summary && <p class="mt-2.5 text-sm leading-6 text-eagles-ink/70 sm:text-base sm:leading-7">{team.summary}</p>}
    <p class="mt-4 font-black text-eagles-green">View team</p>
  </div>
</a>
