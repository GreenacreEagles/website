---
import type { CollectionEntry } from "astro:content";
import { money, progressPercent } from "@lib/content";
import ButtonLink from "@components/ButtonLink.astro";
import Icon from "@components/Icon.astro";

interface Props {
  fundraiser: CollectionEntry<"fundraisers">;
}

const { fundraiser } = Astro.props;
const percent = progressPercent(fundraiser.data.currentAmount, fundraiser.data.goalAmount);
---

<article class="grid min-w-0 overflow-hidden border border-eagles-green/20 bg-white shadow-match-card md:grid-cols-[minmax(0,.95fr)_minmax(0,1.05fr)]" style="border-radius:8px">
  <img src={fundraiser.data.image ?? "/media/placeholders/fundraiser-community.svg"} alt="" class="aspect-[16/10] h-full max-h-72 w-full object-cover md:aspect-auto md:min-h-0" loading="lazy" />
  <div class="bg-eagles-pine p-5 text-white sm:p-6 md:p-7">
    <p class="inline-flex items-center gap-2 text-sm font-black uppercase text-eagles-lime">
      <Icon name="heartHandshake" class="h-4 w-4" /> {fundraiser.data.status}
    </p>
    <h3 class="panel-title mt-3 text-white">{fundraiser.data.title}</h3>
    <p class="mt-3 text-sm leading-6 text-white/70 sm:text-base sm:leading-7">{fundraiser.data.description}</p>
    <div class="mt-5">
      <div class="flex items-end justify-between gap-4">
        <span class="font-display text-2xl font-black sm:text-3xl">{money(fundraiser.data.currentAmount)}</span>
        <span class="text-sm font-bold text-white/65">Goal {money(fundraiser.data.goalAmount)}</span>
      </div>
      <div class="mt-3 h-3 overflow-hidden bg-white/20" style="border-radius:8px">
        <div class="h-full bg-white" style={`width:${percent}%`}></div>
      </div>
    </div>
    <div class="mt-7">
      <ButtonLink href={fundraiser.data.ctaLink} variant="light">{fundraiser.data.ctaText}</ButtonLink>
    </div>
  </div>
</article>
