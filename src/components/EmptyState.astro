---
interface Props {
  title: string;
  text: string;
  href?: string;
  action?: string;
}

const { title, text, href, action } = Astro.props;
---

<article class="border border-dashed border-eagles-line bg-white p-5 text-center sm:p-6" style="border-radius:8px">
  <h2 class="font-display text-2xl font-black uppercase leading-none text-eagles-ink">{title}</h2>
  <p class="mx-auto mt-3 max-w-2xl text-sm leading-6 text-eagles-ink/70">{text}</p>
  {href && action && (
    <a class="focus-ring mt-4 inline-flex min-h-11 max-w-full items-center justify-center bg-eagles-pine px-4 py-3 text-center text-sm font-black text-white hover:bg-eagles-ink" style="border-radius:8px" href={href}>
      {action}
    </a>
  )}
</article>
