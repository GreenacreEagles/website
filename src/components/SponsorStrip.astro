---
import type { PublicSponsor } from "@lib/public-content";

interface Props {
  sponsors: PublicSponsor[];
}

const { sponsors } = Astro.props;
const initials = (name: string) =>
  name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 3)
    .map((word) => word[0])
    .join("");
---

<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  {
    sponsors.map((sponsor) => (
      <a
        class="surface flex min-h-0 flex-col justify-between p-4 hover:border-eagles-green sm:p-5"
        href={sponsor.website}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Visit ${sponsor.name} website`}
      >
        {
          sponsor.logo ? (
            <img src={sponsor.logo} alt={`${sponsor.name} logo`} class="h-16 w-full object-contain object-left" loading="lazy" />
          ) : (
            <div class="flex h-16 w-16 items-center justify-center bg-eagles-green font-display text-2xl font-black text-white" style="border-radius:8px">
              {initials(sponsor.name)}
            </div>
          )
        }
        <div class="mt-5">
          {sponsor.tier && <p class="text-xs font-black uppercase text-eagles-green">{sponsor.tier}</p>}
          <h3 class="mt-1 font-display text-xl font-black uppercase leading-none">{sponsor.name}</h3>
          {sponsor.description && <p class="mt-2 text-sm leading-6 text-eagles-ink/65">{sponsor.description}</p>}
        </div>
      </a>
    ))
  }
</div>
