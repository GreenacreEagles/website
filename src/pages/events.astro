---
import BaseLayout from "@layouts/BaseLayout.astro";
import SectionHeading from "@components/SectionHeading.astro";
import { createSupabaseServerClient } from "@lib/supabase/server";
import { getPublicEvents,type PublicEventSummary } from "@lib/public-events";
import { formatDateTime,formatMoney } from "@lib/format";
export const prerender=false;
let events:PublicEventSummary[]=[]; try{events=await getPublicEvents(createSupabaseServerClient(Astro),Astro)}catch(error){console.error("Unable to load events",error)}
---
<BaseLayout title="Events" description="Discover upcoming Greenacre Eagles FC events, club activities and ticketed community experiences.">
 <section class="section-pad bg-eagles-mist"><div class="section-shell">
  <SectionHeading eyebrow="Events" title="What is coming up" intro="Club events, activities and ticketed community experiences for Eagles families and supporters." />
  {events.length===0?<p class="surface mt-10 p-6 text-lg">There are no upcoming club events available at the moment. Check back soon for new Greenacre Eagles events.</p>:
  <div class="mt-10 grid gap-5 lg:grid-cols-3">{events.map(event=><article class="surface overflow-hidden">
   <img src={event.imageUrl??"/media/placeholders/matchday-card.svg"} alt={event.imageUrl?`${event.name} event`:""} class="aspect-[16/10] w-full object-cover" loading="lazy"/>
   <div class="p-4 sm:p-5"><p class="eyebrow">{formatDateTime(event.startsAt)}</p><h2 class="card-title mt-2 text-eagles-ink">{event.name}</h2>
   {event.summary&&<p class="mt-3 line-clamp-3 text-eagles-ink/70">{event.summary}</p>}<p class="mt-4 text-sm font-bold">{event.venueName??"Venue to be confirmed"}{event.venueSuburb?`, ${event.venueSuburb}`:""}</p>
   <p class="mt-2 font-black text-eagles-green">{event.isFree?"Free":`From ${formatMoney(event.minimumPriceCents??0)}`}</p>
   <a class="focus-ring mt-5 inline-flex bg-eagles-green px-4 py-3 font-black text-white" style="border-radius:8px" href={`/portal/events/${event.slug}/`}>{event.isSoldOut?"View event":"Get tickets"}</a></div>
  </article>)}</div>}
 </div></section>
</BaseLayout>
