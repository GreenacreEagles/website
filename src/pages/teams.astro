---
import BaseLayout from "@layouts/BaseLayout.astro";
import ButtonLink from "@components/ButtonLink.astro";
import SectionHeading from "@components/SectionHeading.astro";
import TeamCard from "@components/TeamCard.astro";
import AnimatedTeamCount from "@components/AnimatedTeamCount.astro";
import EmptyState from "@components/EmptyState.astro";
import { createSupabaseServerClient } from "@lib/supabase/server";
import { getPublicTeams } from "@lib/public-teams";

export const prerender = false;
const supabase = createSupabaseServerClient(Astro);
const { activeTeamCount, teams } = await getPublicTeams(supabase, Astro);
---
<BaseLayout title="Teams" description="Meet the active junior, youth and senior teams representing Greenacre Eagles FC.">
  <section class="section-pad bg-eagles-mist text-eagles-ink">
    <div class="section-shell grid min-w-0 gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(16rem,21.25rem)] lg:items-end">
      <div class="min-w-0">
        <p class="eyebrow">Teams</p>
        <h1 class="mt-4 break-words font-display text-4xl font-black uppercase leading-none sm:text-5xl md:text-6xl lg:text-7xl">Football for every stage</h1>
        <p class="mt-6 max-w-3xl text-xl leading-9 text-eagles-ink/75">
          Greenacre Eagles supports players through junior, youth and senior football. Every squad has its own character and ambitions, while sharing the same commitment to teammates, families and the wider club.
        </p>
      </div>
      <AnimatedTeamCount total={activeTeamCount} />
    </div>
  </section>

  <section class="section-pad bg-white">
    <div class="section-shell">
      <div>
        <SectionHeading eyebrow="Our squads" title="Public teams" intro="Explore the Greenacre Eagles teams currently sharing their squad information with the community." />
      </div>
      {teams.length ? <div class="mt-10 grid gap-5 lg:grid-cols-3">{teams.map((team) => <TeamCard team={team} />)}</div> :
        <div class="mt-10"><EmptyState title="Team profiles coming soon" text="Our active teams are being prepared for public display. Contact the club if you would like help finding the right team." /></div>}

      <article class="mt-10 grid gap-6 border border-eagles-green bg-eagles-ink p-6 text-white md:grid-cols-[1fr_auto] md:items-center md:p-8" style="border-radius:12px">
        <div class="min-w-0">
          <p class="eyebrow text-eagles-lime">Club portal</p>
          <h2 class="mt-2 font-display text-3xl font-black uppercase leading-none">Looking for your team?</h2>
          <p class="mt-3 max-w-2xl leading-7 text-white/75">Log in to the Greenacre Eagles portal to view the teams you are connected to, team posts and club updates.</p>
        </div>
        <ButtonLink href="/login/?returnTo=%2Fportal%2Fteams%2F" variant="light">View my teams</ButtonLink>
      </article>
    </div>
  </section>
</BaseLayout>
