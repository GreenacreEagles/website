---
import BaseLayout from "@layouts/BaseLayout.astro";
import ButtonLink from "@components/ButtonLink.astro";
import SectionHeading from "@components/SectionHeading.astro";
import SponsorStrip from "@components/SponsorStrip.astro";
import EmptyState from "@components/EmptyState.astro";
import { fetchPublicSponsors, type PublicSponsor } from "@lib/public-content";
import { createSupabaseServerClient } from "@lib/supabase/server";

let sponsors: PublicSponsor[] = [];
try { sponsors = await fetchPublicSponsors(createSupabaseServerClient(Astro), Astro, 80); } catch {}

export const prerender = false;
---

<BaseLayout title="Club Sponsors" description="Meet the businesses and community partners supporting Greenacre Eagles Football Club.">
  <section class="section-pad bg-eagles-mist text-eagles-ink">
    <div class="section-shell grid min-w-0 gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
      <div class="min-w-0">
        <p class="text-sm font-black uppercase text-eagles-green">Sponsors</p>
        <h1 class="mt-4 break-words font-display text-4xl font-black uppercase leading-none sm:text-5xl md:text-6xl lg:text-7xl">Our club sponsors</h1>
        <p class="mt-6 max-w-3xl text-xl leading-9 text-eagles-ink/75">Greenacre Eagles Football Club is proud to be supported by local businesses and community partners who help us provide football opportunities for players and families across the club.</p>
      </div>
      <ButtonLink href="/contact/?type=sponsorship" variant="primary">Ask about sponsorship</ButtonLink>
    </div>
  </section>
  <section class="section-pad bg-white">
    <div class="section-shell">
      <SectionHeading eyebrow="Partners" title="Supporting the Eagles" intro="We appreciate every sponsor who contributes to the club and helps us continue building a strong football community at Allum Park." />
      <div class="mt-10">
        {sponsors.length > 0 ? <SponsorStrip sponsors={sponsors} /> : <EmptyState title="Club partners coming soon" text="Our current club partners will be displayed here soon." href="/contact/?type=sponsorship" action="Ask about sponsoring Greenacre Eagles" />}
      </div>
    </div>
  </section>
</BaseLayout>

