---
import BaseLayout from "@layouts/BaseLayout.astro";
import ButtonLink from "@components/ButtonLink.astro";
import TurnstileWidget from "@components/TurnstileWidget.astro";
import { getPortalSession } from "@lib/auth/session";
import { safeAuthReturnPath } from "@lib/forms";
import { getTurnstileSiteKey } from "@lib/security/turnstile";

export const prerender = false;

const session = await getPortalSession(Astro);
const returnTo = safeAuthReturnPath(Astro.url.searchParams.get("returnTo"));
if (session) return Astro.redirect(returnTo);

const success = Astro.url.searchParams.get("success");
const error = Astro.url.searchParams.get("error");
const turnstileSiteKey = getTurnstileSiteKey();
---

<BaseLayout title="Login" description="Sign in to the Greenacre Eagles FC portal.">
  <section class="section-pad bg-eagles-mist">
    <div class="section-shell grid gap-10 lg:grid-cols-[.85fr_1.15fr] lg:items-start">
      <div>
        <p class="eyebrow">Club portal</p>
        <h1 class="mt-3 page-title">Sign in</h1>
        <p class="mt-5 text-lg leading-8 text-eagles-ink/70">
          Access your Greenacre Eagles account for your profile, assigned roles, access requests and approved club administration tools.
        </p>
        <div class="mt-7 flex flex-col gap-3 sm:flex-row">
          <ButtonLink href="/" variant="secondary">Back to website</ButtonLink>
          <ButtonLink href="/contact/" variant="secondary">Contact the club</ButtonLink>
        </div>
      </div>

      <div class="surface p-5 md:p-7">
        {success && <p class="mb-5 border border-eagles-green bg-green-50 p-4 text-sm font-bold text-eagles-pine" style="border-radius:8px">{success}</p>}
        {error && <p class="mb-5 border border-red-200 bg-red-50 p-4 text-sm font-bold text-red-700" style="border-radius:8px">{error}</p>}

        <form class="grid gap-5" method="post" action="/api/auth/signin">
          <input type="hidden" name="returnTo" value={returnTo} />
          <div>
            <h2 class="panel-title text-eagles-ink">Welcome back</h2>
            <p class="mt-3 text-base leading-7 text-eagles-ink/70">Sign in with your email address, or a child username if a family manager created one for you.</p>
          </div>
          <label>
            <span class="label">Email or child username</span>
            <input class="field" name="email" type="text" autocomplete="username" required />
          </label>
          <label>
            <span class="label">Password</span>
            <input class="field" name="password" type="password" autocomplete="current-password" required />
          </label>
          <TurnstileWidget action="signin" />
          <button class="focus-ring inline-flex items-center justify-center bg-eagles-green px-5 py-3 text-sm font-black text-white hover:bg-eagles-ink" style="border-radius:8px" type="submit">
            Sign in
          </button>
        </form>
        <div class="mt-6 flex flex-col gap-3 border-t border-eagles-line pt-6 text-sm">
          <a class="focus-ring inline-flex w-fit font-black text-eagles-green hover:text-eagles-ink" href="/forgot-password/">Forgot your password?</a>
          <p class="text-eagles-ink/70">Don’t have an account? <a class="font-black text-eagles-green hover:text-eagles-ink" href="/signup/">Create one</a></p>
        </div>
      </div>
    </div>
  </section>
  {turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
</BaseLayout>
