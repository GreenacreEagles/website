---
import AdminPageHeader from "@components/AdminPageHeader.astro";import EmptyState from "@components/EmptyState.astro";import PortalLayout from "@layouts/PortalLayout.astro";import StatusBadge from "@components/StatusBadge.astro";import{requirePermission}from"@lib/auth/guards";import{formatDateTime,formatMoney,statusLabel}from"@lib/format";
export const prerender=false;const session=await requirePermission(Astro,["events.manage"]);if(!session)return Astro.redirect("/login/");const id=Astro.params.id!;const[{data:event},{data:registrations},{data:orders},{data:tickets}]=await Promise.all([(session.supabase as any).from("club_events").select("id,title,description,status,visibility,starts_at,ends_at,venue,club_event_ticket_types(id,name,price_cents,capacity,active,sort_order)").eq("id",id).maybeSingle(),(session.supabase as any).from("event_registrations").select("id,status,created_at,checked_in_at,profiles:attendee_id(full_name,preferred_name)").eq("event_id",id).order("created_at",{ascending:false}),(session.supabase as any).from("club_event_orders").select("id,order_number,user_id,status,payment_status,total_cents,created_at,completed_at,profiles:user_id(full_name,preferred_name),club_event_order_items(ticket_name,quantity,line_total_cents)").eq("event_id",id).order("created_at",{ascending:false}),(session.supabase as any).from("club_event_tickets").select("id,status,issued_at,redeemed_at,profiles:owner_user_id(full_name,preferred_name),club_event_ticket_types:ticket_type_id(name)").eq("event_id",id).order("issued_at",{ascending:false})]);if(!event)return Astro.redirect("/admin/events/");
---
<PortalLayout title={event.title} section="Administration" session={session}><div class="grid gap-6"><AdminPageHeader title={event.title} intro="Review event setup, registrations, ticket orders and attendance."><Fragment slot="actions"><a class="focus-ring inline-flex min-h-11 items-center rounded-lg border border-eagles-line px-4 py-2 text-sm font-black text-eagles-pine" href="/admin/events/">Back to events</a></Fragment></AdminPageHeader><section class="surface p-4 sm:p-5 md:p-6"><div class="flex flex-wrap gap-2"><StatusBadge label={statusLabel(event.status)} tone={event.status==="active"?"green":"amber"}/><StatusBadge label={statusLabel(event.visibility)} tone="ink"/></div><dl class="mt-4 grid gap-3 text-sm sm:grid-cols-2 lg:grid-cols-4"><div><dt class="font-black">Starts</dt><dd>{formatDateTime(event.starts_at)}</dd></div><div><dt class="font-black">Ends</dt><dd>{formatDateTime(event.ends_at)}</dd></div><div><dt class="font-black">Venue</dt><dd>{event.venue??"TBC"}</dd></div><div><dt class="font-black">Ticket types</dt><dd>{event.club_event_ticket_types?.length??0}</dd></div></dl>{event.description&&<p class="mt-4 text-sm leading-6 text-eagles-ink/70">{event.description}</p>}</section><section class="surface p-4 sm:p-5 md:p-6"><h2 class="panel-title">Registrations</h2><div class="mt-4 grid gap-3">{(registrations??[]).length===0&&<EmptyState title="No registrations" text="Registrants will appear here only for this event."/>}{(registrations??[]).map((row:any)=><article class="rounded-lg border border-eagles-line p-3"><div class="flex flex-wrap justify-between gap-2"><strong>{row.profiles?.preferred_name||row.profiles?.full_name||"Registered member"}</strong><StatusBadge label={statusLabel(row.status)} tone={row.status==="attended"?"green":"ink"}/></div><p class="mt-1 text-sm text-eagles-ink/65">Registered {formatDateTime(row.created_at)} · {row.checked_in_at?"Checked in "+formatDateTime(row.checked_in_at):"Not checked in"}</p></article>)}</div></section><section class="surface p-4 sm:p-5 md:p-6"><h2 class="panel-title">Ticket orders</h2><div class="mt-4 grid gap-3">{(orders??[]).length===0&&<EmptyState title="No ticket orders" text="Paid and pending ticket orders will appear here."/>}{(orders??[]).map((order:any)=><article class="rounded-lg border border-eagles-line p-3"><div class="flex flex-wrap justify-between gap-2"><strong>Order {order.order_number} · {order.profiles?.preferred_name||order.profiles?.full_name||"Member"}</strong><span class="flex gap-2"><StatusBadge label={statusLabel(order.payment_status)} tone={order.payment_status==="paid"?"green":"amber"}/><StatusBadge label={statusLabel(order.status)} tone="ink"/></span></div><p class="mt-1 text-sm text-eagles-ink/65">{formatDateTime(order.created_at)} · {formatMoney(order.total_cents)}</p><div class="mt-2 grid gap-1">{(order.club_event_order_items??[]).map((item:any)=><p class="text-sm">{item.quantity} × {item.ticket_name}</p>)}</div></article>)}</div></section><section class="surface p-4 sm:p-5 md:p-6"><h2 class="panel-title">Attendance and redemption</h2><div class="mt-4 grid gap-2">{(tickets??[]).length===0&&<p class="text-sm text-eagles-ink/65">No issued tickets.</p>}{(tickets??[]).map((ticket:any)=><p class="rounded-lg border border-eagles-line p-3 text-sm"><strong>{ticket.profiles?.preferred_name||ticket.profiles?.full_name||"Ticket holder"}</strong> · {ticket.club_event_ticket_types?.name??"Ticket"} · {ticket.redeemed_at?"Redeemed "+formatDateTime(ticket.redeemed_at):statusLabel(ticket.status)}</p>)}</div></section></div></PortalLayout>
