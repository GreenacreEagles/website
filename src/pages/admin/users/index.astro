---
import PortalLayout from "@layouts/PortalLayout.astro";
import StatusBadge from "@components/StatusBadge.astro";
import { requirePermission } from "@lib/auth/guards";
import { formatDate } from "@lib/format";

export const prerender = false;

const session = await requirePermission(Astro, ["users.read"]);
if (!session) return Astro.redirect("/login/");

const q = Astro.url.searchParams.get("q")?.trim() ?? "";
const status = Astro.url.searchParams.get("status") ?? "";
const { data: directory, error: directoryError } = await (session.supabase as any).rpc("admin_user_directory", {
  search_text: q || null, page_limit: 100, page_offset: 0, target_user_id: null
});
const users = ((directory ?? []) as any[]).filter((user) => !status || user.account_status === status);
const count = users.length ? users[0].total_count : 0;
const emailLabel = (user: any) => user.child_account ? "Username-only child account" : user.email ?? "No personal email";
---

<PortalLayout title="Users and Access" section="Administration" session={session}>
  <section class="surface p-5 md:p-7">
    <form class="grid gap-4 md:grid-cols-[1fr_180px_auto]" method="get">
      <label>
        <span class="label">Search users</span>
        <input class="field" name="q" value={q} placeholder="Name, username, email or mobile" />
      </label>
      <label>
        <span class="label">Status</span>
        <select class="field" name="status">
          <option value="">All</option>
          {["active", "suspended", "deleted_requested"].map((option) => <option selected={status === option} value={option}>{option}</option>)}
        </select>
      </label>
      <button class="self-end bg-eagles-green px-5 py-3 text-sm font-black text-white" style="border-radius:8px" type="submit">Search</button>
    </form>
    {directoryError && <p class="mt-4 border border-red-200 bg-red-50 p-3 text-sm font-bold text-red-700">User search is temporarily unavailable.</p>}
    <p class="mt-4 text-sm font-bold text-eagles-ink/60">{count ?? 0} matching users</p>
    <div class="mt-6 grid gap-3 md:hidden" aria-label="Matching users">
      {(users ?? []).map((user) => (
        <article class="border border-eagles-line bg-eagles-mist p-4" style="border-radius:8px">
          <div class="flex min-w-0 items-start justify-between gap-3">
            <div class="min-w-0">
              <h2 class="break-words font-black">{user.preferred_name || user.full_name || "Unnamed member"}</h2>
              <p class="mt-1 break-all text-sm text-eagles-ink/65">{emailLabel(user)}</p>
            </div>
            <StatusBadge label={user.account_status} tone={user.account_status === "active" ? "green" : "amber"} />
          </div>
          <dl class="mt-4 grid gap-2 border-t border-eagles-line pt-4 text-sm">
            <div class="flex justify-between gap-3"><dt class="font-black">Mobile</dt><dd class="text-right">{user.mobile ?? "Not recorded"}</dd></div>
            <div class="flex justify-between gap-3"><dt class="font-black">Profile</dt><dd>{user.onboarding_completed_at ? "Complete" : "Incomplete"}</dd></div>
            <div class="flex justify-between gap-3"><dt class="font-black">Joined</dt><dd>{formatDate(user.created_at)}</dd></div>
          </dl>
          <a class="focus-ring mt-4 inline-flex min-h-11 w-full items-center justify-center bg-eagles-pine px-4 py-3 font-black text-white hover:bg-eagles-ink" style="border-radius:8px" href={`/admin/users/${user.id}/`}>Open user</a>
        </article>
      ))}
    </div>
    <div class="mt-6 hidden overflow-x-auto md:block">
      <table class="w-full min-w-[760px] text-left text-sm">
        <thead class="border-b border-eagles-line text-xs uppercase text-eagles-ink/60">
          <tr><th class="py-3">Name</th><th>Email</th><th>Mobile</th><th>Status</th><th>Profile</th><th>Joined</th><th></th></tr>
        </thead>
        <tbody>
          {(users ?? []).map((user) => (
            <tr class="border-b border-eagles-line">
              <td class="py-4 font-bold">{user.preferred_name || user.full_name || "Unnamed member"}</td>
              <td>{emailLabel(user)}</td>
              <td>{user.mobile ?? "Not recorded"}</td>
              <td><StatusBadge label={user.account_status} tone={user.account_status === "active" ? "green" : "amber"} /></td>
              <td>{user.onboarding_completed_at ? "Complete" : "Incomplete"}</td>
              <td>{formatDate(user.created_at)}</td>
              <td><a class="font-black text-eagles-green" href={`/admin/users/${user.id}/`}>Open</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</PortalLayout>
