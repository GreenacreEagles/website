---
import AdminDialog from "@components/AdminDialog.astro";
import AdminFeedback from "@components/AdminFeedback.astro";
import AdminPageHeader from "@components/AdminPageHeader.astro";
import FormActions from "@components/FormActions.astro";
import PortalLayout from "@layouts/PortalLayout.astro";
import StatusBadge from "@components/StatusBadge.astro";
import { requirePermission } from "@lib/auth/guards";
import { formatDateTime, statusLabel } from "@lib/format";

export const prerender = false;
const session = await requirePermission(Astro, ["users.read"]);
if (!session) return Astro.redirect("/login/");
const id = Astro.params.id!;
const returnTo = `/admin/users/${id}/`;
const success = Astro.url.searchParams.get("success");
const error = Astro.url.searchParams.get("error");
const [{ data: profile }, { data: assignments }, { data: roles }, { data: teams }, { data: complianceData }, { data: staff }, { data: playerRecords }] = await Promise.all([
  session.supabase.from("profiles").select("*").eq("id", id).single(),
  session.supabase.from("user_role_assignments").select("id,status,starts_at,ends_at,reason,roles(id,name,key)").eq("user_id", id).is("team_id", null).is("season_id", null).order("created_at", { ascending: false }),
  session.supabase.from("role_catalog").select("id,key,name,role_kind").neq("key", "general_user").order("sort_order"),
  session.supabase.from("teams").select("id,name,seasons(name)").eq("status", "active").order("name"),
  session.supabase.from("member_compliance").select("*").eq("user_id", id).maybeSingle(),
  session.supabase.from("team_staff").select("id,staff_role,status,starts_on,ends_on,teams(name,seasons(name))").eq("user_id", id).order("created_at", { ascending: false }),
  session.supabase.from("player_records").select("id,team_players(id,status,starts_on,ends_on,teams(name)),seasons(name)").eq("user_id", id)
]);
if (!profile) return Astro.redirect("/admin/users/");
const compliance = complianceData;
const canAssign = session.permissions.has("*") || session.permissions.has("roles.assign") || session.permissions.has("roles.manage");
const canAssignTeams = session.permissions.has("*") || session.permissions.has("team_memberships.manage") || session.permissions.has("club_structure.manage");
const teamAssignments = [...(staff ?? []).map((item) => ({...item, position: item.staff_role === "team_manager" ? "Team Manager" : "Coach", seasonLabel: item.teams?.seasons?.name})), ...(playerRecords ?? []).flatMap((record) => (record.team_players ?? []).map((item) => ({...item, position: "Player", teams: item.teams, seasonLabel: record.seasons?.name})))];
---

<PortalLayout title={profile.full_name || "User detail"} section="User management" session={session}>
  <div class="grid gap-6">
    <AdminFeedback success={success} error={error} />
    <AdminPageHeader title={profile.preferred_name || profile.full_name || "User detail"} intro="Manage global roles and team-scoped positions. WWCC decisions are handled in the dedicated review workspace.">
      <Fragment slot="actions">
        {canAssign && <AdminDialog id="assign-user-role" title="Assign global role" actionLabel="Global role" size="lg"><form class="grid gap-4" method="post" action="/api/admin/assign-role"><input type="hidden" name="user_id" value={id} /><input type="hidden" name="return_to" value={returnTo} /><label><span class="label">Role</span><select class="field" name="role_id" required><option value="">Select</option>{(roles ?? []).map((role) => <option value={role.id}>{role.name}</option>)}</select></label><label><span class="label">Starts</span><input class="field" type="datetime-local" name="starts_at" /></label><label><span class="label">Expires</span><input class="field" type="datetime-local" name="ends_at" /></label><label><span class="label">Reason</span><textarea class="field min-h-24" name="reason" minlength="10" required></textarea></label><FormActions submitLabel="Assign global role" /></form></AdminDialog>}
        {canAssignTeams && <AdminDialog id="assign-team-position" title="Assign team position" actionLabel="Team position" size="lg"><form class="grid gap-4" method="post" action="/api/admin/team-assignment"><input type="hidden" name="user_id" value={id} /><input type="hidden" name="return_to" value={returnTo} /><label><span class="label">Team</span><select class="field" name="team_id" required><option value="">Select</option>{(teams ?? []).map((team) => <option value={team.id}>{team.name} · {team.seasons?.name}</option>)}</select></label><label><span class="label">Position</span><select class="field" name="position"><option value="player">Player</option><option value="coach">Coach</option><option value="team_manager">Team Manager</option></select></label><div class="grid gap-3 md:grid-cols-2"><label><span class="label">Starts</span><input class="field" type="date" name="starts_on" /></label><label><span class="label">Ends</span><input class="field" type="date" name="ends_on" /></label></div><FormActions submitLabel="Save team position" /></form></AdminDialog>}
      </Fragment>
    </AdminPageHeader>

    <section class="surface p-4 sm:p-5 md:p-6"><div class="flex min-w-0 flex-col gap-3 sm:flex-row sm:justify-between"><div class="min-w-0"><h2 class="panel-title text-eagles-ink">{profile.preferred_name || profile.full_name}</h2><p class="mt-2 break-words text-sm text-eagles-ink/70">{profile.email ?? "No email"} · {profile.mobile ?? "No mobile"}</p></div><StatusBadge label={profile.account_status} tone={profile.account_status === "active" ? "green" : "amber"} /></div></section>

    <div class="grid gap-5 xl:grid-cols-2 xl:gap-6">
      <section class="surface p-4 sm:p-5 md:p-6"><h2 class="panel-title text-eagles-ink">Global role history</h2><div class="mt-4 grid gap-3 sm:mt-5">{(assignments ?? []).map((assignment) => <article class="border border-eagles-line p-3 sm:p-4" style="border-radius:8px"><div class="flex min-w-0 flex-wrap items-start justify-between gap-2 sm:gap-3"><p class="min-w-0 font-black">{assignment.roles?.name}</p><StatusBadge label={statusLabel(assignment.status)} tone={assignment.status === "active" ? "green" : "amber"} /></div><p class="mt-2 text-sm text-eagles-ink/70">Expires {formatDateTime(assignment.ends_at)}</p>{canAssign && assignment.status === "active" && assignment.roles?.key !== "general_user" && <form class="mt-3 grid gap-2 sm:grid-cols-[minmax(0,1fr)_auto]" method="post" action="/api/admin/revoke-role"><input type="hidden" name="assignment_id" value={assignment.id} /><input type="hidden" name="return_to" value={returnTo} /><input class="field" name="reason" minlength="10" placeholder="Revocation reason" required /><button class="min-h-11 px-4 py-2 text-sm font-black text-red-700" type="submit">Revoke</button></form>}</article>)}</div></section>
      <section class="surface p-4 sm:p-5 md:p-6"><h2 class="panel-title text-eagles-ink">Team positions</h2><div class="mt-4 grid gap-3 sm:mt-5">{teamAssignments.length === 0 && <p class="text-sm text-eagles-ink/70">No team positions assigned.</p>}{teamAssignments.map((item) => <article class="border border-eagles-line p-3 sm:p-4" style="border-radius:8px"><div class="flex min-w-0 flex-wrap items-start justify-between gap-2 sm:gap-3"><p class="min-w-0 font-black">{item.position}</p><StatusBadge label={statusLabel(item.status)} tone={item.status === "active" ? "green" : "ink"} /></div><p class="mt-2 text-sm text-eagles-ink/70">{item.teams?.name ?? "Team"} · {item.seasonLabel ?? "Season"}</p></article>)}</div></section>
    </div>

    <section class="surface p-4 sm:p-5 md:p-6"><h2 class="panel-title text-eagles-ink">Volunteer & WWCC status</h2><p class="mt-3 text-sm text-eagles-ink/70">This summary is read-only. Supporting documents and review decisions are handled in WWCC management. <a class="font-black text-eagles-pine underline" href="/admin/volunteers/">Open WWCC management</a>.</p><dl class="mt-4 grid gap-4 sm:mt-5 sm:grid-cols-3"><div><dt class="font-black">Volunteer</dt><dd>{statusLabel(compliance?.volunteer_status ?? "pending")}</dd></div><div><dt class="font-black">WWCC</dt><dd>{statusLabel(compliance?.wwcc_status ?? "not_supplied")}</dd></div><div><dt class="font-black">Expiry</dt><dd>{compliance?.wwcc_expiry_date ?? "Not recorded"}</dd></div></dl></section>
  </div>
</PortalLayout>