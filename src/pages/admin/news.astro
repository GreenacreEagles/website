---
import AdminDialog from "@components/AdminDialog.astro";import AdminFeedback from "@components/AdminFeedback.astro";import AdminPageHeader from "@components/AdminPageHeader.astro";import EmptyState from "@components/EmptyState.astro";import FormActions from "@components/FormActions.astro";import ImageUploadField from "@components/ImageUploadField.astro";import PortalLayout from "@layouts/PortalLayout.astro";import StatusBadge from "@components/StatusBadge.astro";import{requirePermission}from"@lib/auth/guards";import{formatDateTime,statusLabel}from"@lib/format";import{getMediaCapabilities,getSafeExternalImageUrl}from"@lib/media";
export const prerender=false;const session=await requirePermission(Astro,["content.manage"]);if(!session)return Astro.redirect("/login/");const media=getMediaCapabilities(Astro);const imageUploadConfigured=media.publicMediaConfigured&&media.publicMediaDeliveryConfigured;const q=Astro.url.searchParams.get("q")?.trim().toLowerCase()??"";const status=Astro.url.searchParams.get("status")??"";const{data:articles}=await session.supabase.from("content_articles").select("id,title,slug,summary,body,category,workflow_status,publish_at,featured_image_url,tags,updated_at").neq("category","Highlight").order("updated_at",{ascending:false}).limit(150);const rows=((articles??[])as any[]).filter(a=>(!q||[a.title,a.summary,a.category].filter(Boolean).join(" ").toLowerCase().includes(q))&&(!status||a.workflow_status===status));const bodyText=(body:any)=>typeof body==="string"?body:body?.text??body?.content?.[0]?.text??"";const csv=(value:any)=>Array.isArray(value)?value.join(", "):"";
---
<PortalLayout title="News" section="Administration" session={session}><div class="grid gap-6"><AdminFeedback success={Astro.url.searchParams.get("success")} error={Astro.url.searchParams.get("error")}/><AdminPageHeader title="News" intro="Create, edit and remove club news articles."><Fragment slot="actions"><AdminDialog id="add-news" title="Add News Article" actionLabel="Add News Article" size="xl"><form class="grid gap-4" method="post" action="/api/admin/content-entry" enctype="multipart/form-data"><input type="hidden" name="entity" value="article"/><label><span class="label">Title</span><input class="field" name="title" required/></label><label><span class="label">Slug</span><input class="field" name="slug" placeholder="Auto-generated if empty"/></label><label><span class="label">Summary</span><textarea class="field min-h-20" name="summary"></textarea></label><label><span class="label">Main content</span><textarea class="field min-h-36" name="body" required></textarea></label><div class="grid gap-3 md:grid-cols-2"><label><span class="label">Category</span><input class="field" name="category" value="News"/></label><label><span class="label">Status</span><select class="field" name="workflow_status"><option value="active">Active</option><option value="inactive">Inactive</option></select></label></div><label><span class="label">Publish date</span><input class="field" name="publish_at" type="datetime-local"/></label><ImageUploadField name="image" label="Upload featured image" maxSizeMb={8} configured={imageUploadConfigured}/><label><span class="label">Tags</span><input class="field" name="tags" placeholder="club, juniors, community"/></label><FormActions submitLabel="Save news"/></form></AdminDialog></Fragment></AdminPageHeader>
<form class="surface grid gap-3 p-4 md:grid-cols-[1fr_180px_auto]" method="get"><label><span class="label">Search</span><input class="field" name="q" value={q}/></label><label><span class="label">Status</span><select class="field" name="status"><option value="">All</option><option value="active" selected={status==="active"}>Active</option><option value="inactive" selected={status==="inactive"}>Inactive</option></select></label><div class="flex items-end"><button class="w-full bg-eagles-green px-4 py-3 text-sm font-black text-white" style="border-radius:8px">Filter</button></div></form>
<section class="surface p-5 md:p-7"><div class="grid gap-3">{rows.length===0&&<EmptyState title="No news articles" text="News articles will appear here."/>}{rows.map(article=><article class="border border-eagles-line bg-white p-4" style="border-radius:8px"><div class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between"><div><p class="font-black">{article.title}</p><p class="text-sm text-eagles-ink/70">{article.category??"News"} · updated {formatDateTime(article.updated_at)}</p>{article.summary&&<p class="mt-2 text-sm text-eagles-ink/65">{article.summary}</p>}</div><div class="flex items-center gap-2"><StatusBadge label={statusLabel(article.workflow_status)} tone={article.workflow_status==="active"?"green":"amber"}/><AdminDialog id={"edit-news-"+article.id} title={"Edit "+article.title} actionLabel="Edit" tone="secondary" size="xl"><form class="grid gap-4" method="post" action="/api/admin/content-entry" enctype="multipart/form-data"><input type="hidden" name="entity" value="article"/><input type="hidden" name="id" value={article.id}/><label><span class="label">Title</span><input class="field" name="title" value={article.title} required/></label><label><span class="label">Slug</span><input class="field" name="slug" value={article.slug}/></label><label><span class="label">Summary</span><textarea class="field min-h-20" name="summary">{article.summary??""}</textarea></label><label><span class="label">Main content</span><textarea class="field min-h-36" name="body" required>{bodyText(article.body)}</textarea></label><div class="grid gap-3 md:grid-cols-2"><label><span class="label">Category</span><input class="field" name="category" value={article.category??"News"}/></label><label><span class="label">Status</span><select class="field" name="workflow_status"><option value="active" selected={article.workflow_status==="active"}>Active</option><option value="inactive" selected={article.workflow_status==="inactive"}>Inactive</option></select></label></div><label><span class="label">Publish date</span><input class="field" name="publish_at" type="datetime-local" value={article.publish_at?.slice(0,16)??""}/></label><ImageUploadField name="image" label="Upload featured image" currentUrl={getSafeExternalImageUrl(article.featured_image_url)} currentAlt={article.title} hasCurrent={Boolean(article.featured_image_url)} removeName="remove_image" maxSizeMb={8} configured={imageUploadConfigured}/><label><span class="label">Tags</span><input class="field" name="tags" value={csv(article.tags)}/></label><FormActions submitLabel="Save changes"/><button class="text-sm font-black text-red-700" name="intent" value="delete" formnovalidate onclick="return confirm('Delete this news article?')">Delete article</button></form></AdminDialog></div></div></article>)}</div></section></div></PortalLayout>
