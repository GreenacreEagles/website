---
import PortalLayout from "@layouts/PortalLayout.astro";
import { requireAdmin } from "@lib/auth/guards";

export const prerender = false;

const session = await requireAdmin(Astro);
if (!session) return Astro.redirect("/login/");

const { data: summaryData, error: summaryError } = await session.supabase.rpc("admin_dashboard_summary");
const summary = (summaryData ?? {}) as Record<string, number>;

const cards = [
  ["Total users", summary.total_users ?? 0],
  ["New users", summary.new_users ?? 0],
  ["Active players", summary.active_players ?? 0],
  ["Active families", summary.active_families ?? 0],
  ["Teams", summary.teams ?? 0],
  ["Active volunteers", summary.active_volunteers ?? 0],
  ["Upcoming events", summary.upcoming_events ?? 0],
  ["Event registrations", summary.event_registrations ?? 0],
  ["Canteen orders today", summary.canteen_orders_today ?? 0],
  ["Orders awaiting action", summary.canteen_orders_open ?? 0],
  ["Ready to collect", summary.canteen_orders_ready ?? 0],
  ["Team access requests", summary.team_access_requests ?? 0],
  ["Unclaimed vouchers", summary.active_vouchers ?? 0],
  ["Vouchers expiring soon", summary.expiring_vouchers ?? 0],
  ["Active news", summary.active_news ?? 0]
];
---

<PortalLayout title="Admin Overview" section="Administration" session={session}>
  {summaryError && <p class="mb-5 border border-red-200 bg-red-50 p-4 text-sm font-bold text-red-700" style="border-radius:8px">Dashboard totals are temporarily unavailable.</p>}
  <section class="grid gap-5 md:grid-cols-2 xl:grid-cols-4">
    {cards.map(([label, value]) => (
      <article class="surface p-5">
        <p class="text-sm font-black uppercase tracking-[.14em] text-eagles-green">{label}</p>
        <p class="mt-3 text-5xl font-black text-eagles-ink">{value}</p>
      </article>
    ))}
  </section>
  <section class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
    {[
      ["Add News", "/admin/news/"],
      ["Add Event", "/admin/events/"],
      ["Review Team Requests", "/admin/teams/"],
      ["Open Canteen", "/admin/canteen/"],
      ["Issue Vouchers", "/admin/wallets/"],
      ["Manage Sponsors", "/admin/sponsors/"]
    ].map(([label, href]) => (
      <a class="surface p-5 font-black text-eagles-green hover:border-eagles-green hover:text-eagles-ink" href={href}>{label}</a>
    ))}
  </section>
</PortalLayout>
