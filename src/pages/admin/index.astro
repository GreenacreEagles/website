---
import PortalLayout from "@layouts/PortalLayout.astro";
import { requireAdmin } from "@lib/auth/guards";
import { hasAnyPermission } from "@lib/auth/permissions";

export const prerender = false;

const session = await requireAdmin(Astro);
if (!session) return Astro.redirect("/login/");

const { data: summaryData, error: summaryError } = await session.supabase.rpc("admin_dashboard_summary");
const summary = (summaryData ?? {}) as Record<string, number>;

const cardDefinitions = [
  ["Total users", summary.total_users ?? 0, ["users.read"]],
  ["New users", summary.new_users ?? 0, ["users.read"]],
  ["Active players", summary.active_players ?? 0, ["registrations.view", "players.manage"]],
  ["Active families", summary.active_families ?? 0, ["registrations.view", "families.manage"]],
  ["Teams", summary.teams ?? 0, ["team_memberships.manage", "club_structure.manage"]],
  ["Active volunteers", summary.active_volunteers ?? 0, ["volunteers.view"]],
  ["Upcoming events", summary.upcoming_events ?? 0, ["events.view", "events.manage"]],
  ["Event registrations", summary.event_registrations ?? 0, ["events.view", "events.manage"]],
  ["Canteen orders today", summary.canteen_orders_today ?? 0, ["canteen.reports.view", "canteen.manage"]],
  ["Orders awaiting action", summary.canteen_orders_open ?? 0, ["canteen.orders.manage", "canteen.manage"]],
  ["Ready to collect", summary.canteen_orders_ready ?? 0, ["canteen.orders.manage", "canteen.manage"]],
  ["Unclaimed vouchers", summary.active_vouchers ?? 0, ["wallet.read", "canteen.manage"]],
  ["Vouchers expiring soon", summary.expiring_vouchers ?? 0, ["wallet.read", "canteen.manage"]],
  ["Active news", summary.active_news ?? 0, ["content.view", "content.manage"]]
] as const;
const cards = cardDefinitions.filter(([, , permissions]) => hasAnyPermission(session.permissions, permissions));
const actions = [
  ["Add News", "/admin/news/", ["content.manage"]],
  ["Add Event", "/admin/events/", ["events.manage"]],
  ["Manage Teams", "/admin/teams/", ["team_memberships.manage", "club_structure.manage"]],
  ["Open Canteen", "/admin/canteen/", ["canteen.manage"]],
  ["Issue Vouchers", "/admin/wallets/", ["wallet.vouchers.manage"]],
  ["Manage Sponsors", "/admin/sponsors/", ["sponsors.manage"]]
] as const;
---

<PortalLayout title="Admin Overview" section="Administration" session={session}>
  {summaryError && <p class="mb-5 border border-red-200 bg-red-50 p-4 text-sm font-bold text-red-700" style="border-radius:8px">Dashboard totals are temporarily unavailable.</p>}
  <section class="grid gap-5 md:grid-cols-2 xl:grid-cols-4">
    {cards.map(([label, value]) => (
      <article class="surface p-5">
        <p class="text-sm font-black uppercase tracking-[.14em] text-eagles-green">{label}</p>
        <p class="mt-3 text-5xl font-black text-eagles-ink">{value}</p>
      </article>
    ))}
  </section>
  <section class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
    {actions.filter(([, , permissions]) => hasAnyPermission(session.permissions, permissions)).map(([label, href]) => (
      <a class="surface p-5 font-black text-eagles-green hover:border-eagles-green hover:text-eagles-ink" href={href}>{label}</a>
    ))}
  </section>
</PortalLayout>
