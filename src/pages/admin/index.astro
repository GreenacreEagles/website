---
import PortalLayout from "@layouts/PortalLayout.astro";
import { requireAdmin } from "@lib/auth/guards";
import { hasAnyPermission } from "@lib/auth/permissions";
export const prerender=false;
const session=await requireAdmin(Astro);if(!session)return Astro.redirect("/login/");
const actions=[
 ["Add news article","/admin/news/#add-news",["content.manage"]],
 ["Add event","/admin/events/#add-event",["events.manage"]],
 ["Add social post","/admin/highlights/?section=posts#new-post",["social_posts.manage"]],
 ["Manage social profiles","/admin/highlights/?section=profiles",["social_profiles.manage"]],
 ["Add team","/admin/teams/#create-team",["club_structure.manage","teams.manage"]],
 ["Manage teams","/admin/teams/",["club_structure.manage","teams.manage","team_memberships.manage"]],
 ["Add sponsor","/admin/sponsors/#new-sponsor",["sponsors.manage"]],
 ["Add coaching resource","/admin/coaching-resources/#add-resource",["coaching_resources.manage"]],
 ["View canteen orders","/admin/canteen/?section=orders",["canteen.orders.manage","canteen.orders.fulfil"]],
 ["Manage canteen products","/admin/canteen/?section=products",["canteen.manage"]],
 ["Search users","/admin/users/",["users.read"]],
 ["Search wallets","/admin/wallets/",["wallet.read"]],
 ["Review volunteers","/admin/volunteers/",["volunteers.view","wwcc.view","wwcc.verify"]]
] as const;
---
<PortalLayout title="Admin Overview" section="Administration" session={session}>
 <section class="surface p-4 sm:p-5 md:p-6">
  <h2 class="panel-title">Quick actions</h2>
  <p class="mt-2 text-sm leading-6 text-eagles-ink/70">Open the admin task you need.</p>
  <nav class="mt-5 grid min-w-0 grid-cols-2 gap-2 sm:gap-3 md:grid-cols-3 xl:grid-cols-4" aria-label="Admin quick actions">
   {actions.filter(([, ,permissions])=>hasAnyPermission(session.permissions,permissions)).map(([label,href])=><a class="focus-ring flex min-h-11 min-w-0 items-center rounded-lg border border-eagles-line bg-white px-3 py-2.5 text-sm font-black leading-5 text-eagles-pine hover:border-eagles-green hover:bg-eagles-mist sm:px-4" href={href}>{label}</a>)}
  </nav>
 </section>
</PortalLayout>
