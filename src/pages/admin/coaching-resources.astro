---
import AdminDialog from "@components/AdminDialog.astro";
import AdminFeedback from "@components/AdminFeedback.astro";
import AdminPageHeader from "@components/AdminPageHeader.astro";
import EmptyState from "@components/EmptyState.astro";
import FormActions from "@components/FormActions.astro";
import PortalLayout from "@layouts/PortalLayout.astro";
import StatusBadge from "@components/StatusBadge.astro";
import { requirePermission } from "@lib/auth/guards";
import { formatDateTime, statusLabel } from "@lib/format";
export const prerender=false;
const session=await requirePermission(Astro,["coaching_resources.manage"]);if(!session)return Astro.redirect("/login/");
const q=Astro.url.searchParams.get("q")?.trim().toLowerCase()??"";
const {data:resources}=await(session.supabase as any).from("coaching_resources").select("id,title,slug,summary,body,resource_type,status,visibility,external_url,duration_minutes,age_group_tags,skill_level_tags,equipment_required,review_due_on,updated_at").order("updated_at",{ascending:false}).limit(150);
const rows=((resources??[])as any[]).filter(r=>!q||[r.title,r.summary,r.resource_type,r.visibility].filter(Boolean).join(" ").toLowerCase().includes(q));
const bodyText=(body:any)=>typeof body==="string"?body:body?.text??body?.content?.[0]?.text??"";
const csv=(value:any)=>Array.isArray(value)?value.join(", "):"";
const types=["drill","session_plan","program","policy","video","document","external_link"];
const visibilities=["coaches","team_staff","admins","public"];
---
<PortalLayout title="Coaching Resources" section="Administration" session={session}>
<div class="grid gap-6"><AdminFeedback success={Astro.url.searchParams.get("success")} error={Astro.url.searchParams.get("error")}/>
<AdminPageHeader title="Coaching Resources" intro="Create, edit and remove resources for coaches, managers and authorised staff."><Fragment slot="actions"><AdminDialog id="add-resource" title="Add Coaching Resource" actionLabel="Add Coaching Resource" size="xl"><form class="grid gap-4" method="post" action="/api/admin/content-entry/"><input type="hidden" name="entity" value="coaching_resource"/>
<label><span class="label">Title</span><input class="field" name="title" required/></label><label><span class="label">Slug</span><input class="field" name="slug" placeholder="Auto-generated if empty"/></label>
<div class="grid gap-3 md:grid-cols-2"><label><span class="label">Category</span><select class="field" name="resource_type">{types.map(item=><option value={item}>{statusLabel(item)}</option>)}</select></label><label><span class="label">Visibility</span><select class="field" name="visibility">{visibilities.map(item=><option value={item}>{statusLabel(item)}</option>)}</select></label></div>
<label><span class="label">Description</span><textarea class="field min-h-20" name="summary"></textarea></label><label><span class="label">Content</span><textarea class="field min-h-32" name="body"></textarea></label><label><span class="label">Attachment or external link</span><input class="field" name="external_url" type="url"/></label>
<div class="grid gap-3 md:grid-cols-2"><label><span class="label">Duration minutes</span><input class="field" name="duration_minutes" type="number" min="0"/></label><label><span class="label">Review due</span><input class="field" name="review_due_on" type="date"/></label></div>
<label><span class="label">Age groups</span><input class="field" name="age_group_tags" placeholder="U8, U12, Seniors"/></label><label><span class="label">Skill levels</span><input class="field" name="skill_level_tags" placeholder="beginner, intermediate, advanced"/></label><label><span class="label">Equipment</span><input class="field" name="equipment_required" placeholder="cones, bibs, mini goals"/></label><label><span class="label">Status</span><select class="field" name="status"><option value="active">Active</option><option value="inactive">Inactive</option></select></label><FormActions submitLabel="Save resource"/></form></AdminDialog></Fragment></AdminPageHeader>
<form class="surface grid gap-3 p-4 md:grid-cols-[1fr_auto]" method="get"><label><span class="label">Search</span><input class="field" name="q" value={q}/></label><div class="flex items-end"><button class="w-full bg-eagles-green px-4 py-3 text-sm font-black text-white" style="border-radius:8px">Search</button></div></form>
<section class="surface p-5 md:p-7"><div class="grid gap-3">{rows.length===0&&<EmptyState title="No coaching resources" text="Resources will appear here."/>}{rows.map(resource=><article class="border border-eagles-line bg-white p-4" style="border-radius:8px"><div class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between"><div><p class="font-black">{resource.title}</p><p class="text-sm text-eagles-ink/70">{statusLabel(resource.resource_type)} · {statusLabel(resource.visibility)} · updated {formatDateTime(resource.updated_at)}</p>{resource.summary&&<p class="mt-2 text-sm text-eagles-ink/65">{resource.summary}</p>}</div><div class="flex items-center gap-2"><StatusBadge label={statusLabel(resource.status)} tone={resource.status==="active"?"green":"amber"}/><AdminDialog id={"edit-resource-"+resource.id} title={"Edit "+resource.title} actionLabel="Edit" tone="secondary" size="xl"><form class="grid gap-4" method="post" action="/api/admin/content-entry/"><input type="hidden" name="entity" value="coaching_resource"/><input type="hidden" name="id" value={resource.id}/>
<label><span class="label">Title</span><input class="field" name="title" value={resource.title} required/></label><label><span class="label">Slug</span><input class="field" name="slug" value={resource.slug??""}/></label><div class="grid gap-3 md:grid-cols-2"><label><span class="label">Category</span><select class="field" name="resource_type">{types.map(item=><option value={item} selected={item===resource.resource_type}>{statusLabel(item)}</option>)}</select></label><label><span class="label">Visibility</span><select class="field" name="visibility">{visibilities.map(item=><option value={item} selected={item===resource.visibility}>{statusLabel(item)}</option>)}</select></label></div>
<label><span class="label">Description</span><textarea class="field min-h-20" name="summary">{resource.summary??""}</textarea></label><label><span class="label">Content</span><textarea class="field min-h-32" name="body">{bodyText(resource.body)}</textarea></label><label><span class="label">Attachment or external link</span><input class="field" name="external_url" type="url" value={resource.external_url??""}/></label><div class="grid gap-3 md:grid-cols-2"><label><span class="label">Duration minutes</span><input class="field" name="duration_minutes" type="number" min="0" value={resource.duration_minutes??""}/></label><label><span class="label">Review due</span><input class="field" name="review_due_on" type="date" value={resource.review_due_on??""}/></label></div><label><span class="label">Age groups</span><input class="field" name="age_group_tags" value={csv(resource.age_group_tags)}/></label><label><span class="label">Skill levels</span><input class="field" name="skill_level_tags" value={csv(resource.skill_level_tags)}/></label><label><span class="label">Equipment</span><input class="field" name="equipment_required" value={csv(resource.equipment_required)}/></label><label><span class="label">Status</span><select class="field" name="status"><option value="active" selected={resource.status==="active"}>Active</option><option value="inactive" selected={resource.status==="inactive"}>Inactive</option></select></label><FormActions submitLabel="Save changes"/><button class="text-sm font-black text-red-700" name="intent" value="delete" formnovalidate onclick="return confirm('Delete this coaching resource?')">Delete resource</button></form></AdminDialog></div></div></article>)}</div></section></div></PortalLayout>
