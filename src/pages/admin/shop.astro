---
import AdminFeedback from "@components/AdminFeedback.astro";
import EmptyState from "@components/EmptyState.astro";
import StatusBadge from "@components/StatusBadge.astro";
import PortalLayout from "@layouts/PortalLayout.astro";
import { requirePermission } from "@lib/auth/guards";
import { formatDateTime, formatMoney, statusLabel } from "@lib/format";

export const prerender = false;
const session = await requirePermission(Astro, [
  "shop.products.view", "shop.products.manage", "shop.orders.view", "shop.orders.manage",
  "shop.canteen.redeem", "shop.merchandise.fulfil", "canteen.manage", "merchandise.manage"
]);
if (!session) return Astro.redirect("/login/");

const canRedeem = session.permissions.has("*") || session.permissions.has("shop.canteen.redeem");
const canCanteen = session.permissions.has("*") || session.permissions.has("canteen.manage");
const canMerch = session.permissions.has("*") || session.permissions.has("merchandise.manage");
const [{ data: orders }, { count: canteenCount }, { count: merchCount }] = await Promise.all([
  (session.supabase as any).from("shop_orders").select("id,order_number,status,payment_status,total_cents,created_at,profiles:user_id(full_name,email),shop_order_items(product_type,product_name_snapshot,variant_name_snapshot,quantity,status)").order("created_at", { ascending: false }).limit(100),
  (session.supabase as any).from("canteen_products").select("id", { count: "exact", head: true }),
  (session.supabase as any).from("merchandise_products").select("id", { count: "exact", head: true })
]);
---
<PortalLayout title="Shop operations" section="Administration" session={session}>
  <div class="grid gap-6">
    <AdminFeedback success={Astro.url.searchParams.get("success")} error={Astro.url.searchParams.get("error")} />

    <section class="surface p-5">
      <h2 class="font-display text-3xl font-black uppercase">Unified product catalogue</h2>
      <p class="mt-2 max-w-3xl text-sm leading-6 text-eagles-ink/70">Manage both sides of the club shop from this operational area. Product, variant, pricing and stock controls remain grouped by fulfilment workflow.</p>
      <div class="mt-5 flex flex-wrap gap-3">
        {canCanteen && <a class="bg-eagles-green px-5 py-3 font-black text-white" style="border-radius:8px" href="/admin/canteen/">Manage canteen ({canteenCount ?? 0})</a>}
        {canMerch && <a class="bg-eagles-ink px-5 py-3 font-black text-white" style="border-radius:8px" href="/admin/merchandise/">Manage merchandise ({merchCount ?? 0})</a>}
      </div>
    </section>

    {canRedeem && <section class="surface p-5">
      <h2 class="font-display text-3xl font-black uppercase">Canteen collection</h2>
      <p class="mt-2 text-sm text-eagles-ink/70">Scan a wallet QR code or enter its collection code. Redemption is atomic and duplicate scans are reported safely.</p>
      <form class="mt-4 flex flex-col gap-3 sm:flex-row" method="post" action="/api/admin/redeem-shop-collection/">
        <label class="grow"><span class="label">QR payload or collection code</span><input class="field" name="code" required autocomplete="off" /></label>
        <button class="self-end bg-eagles-green px-5 py-3 font-black text-white" type="submit" style="border-radius:8px">Redeem collection</button>
      </form>
    </section>}

    <section class="surface p-5">
      <h2 class="font-display text-3xl font-black uppercase">Unified orders</h2>
      {(orders ?? []).length === 0
        ? <div class="mt-5"><EmptyState title="No shop orders yet" text="Completed checkouts will appear here." /></div>
        : <div class="mt-5 grid gap-4">{orders.map((order: any) => <article class="border-t border-eagles-line pt-4">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div><p class="font-black">{order.order_number} · {formatMoney(order.total_cents)}</p><p class="text-sm text-eagles-ink/70">{order.profiles?.full_name ?? order.profiles?.email ?? "Member"} · {formatDateTime(order.created_at)}</p></div>
              <div class="flex gap-2"><StatusBadge label={statusLabel(order.payment_status)} tone={order.payment_status === "paid" || order.payment_status === "not_required" ? "green" : "amber"} /><StatusBadge label={statusLabel(order.status)} tone={order.status === "completed" || order.status === "ready" ? "green" : "amber"} /></div>
            </div>
            <ul class="mt-3 grid gap-1 text-sm">{order.shop_order_items?.map((item: any) => <li>{item.quantity} × {item.product_name_snapshot}{item.variant_name_snapshot ? ` — ${item.variant_name_snapshot}` : ""} · {statusLabel(item.status)}</li>)}</ul>
          </article>)}</div>}
    </section>
  </div>
</PortalLayout>
