---
import PortalLayout from "@layouts/PortalLayout.astro";import AdminFeedback from "@components/AdminFeedback.astro";import StatusBadge from "@components/StatusBadge.astro";import{requirePermission}from"@lib/auth/guards";import{formatDateTime,formatMoney,statusLabel}from"@lib/format";
export const prerender=false;const session=await requirePermission(Astro,["events.manage","events.orders.read","events.tickets.scan","events.tickets.redeem"]);if(!session)return Astro.redirect("/login/");
const canRedeem=session.permissions.has("*")||session.permissions.has("events.tickets.redeem");
const{data:orders}=await(session.supabase as any).from("club_event_orders").select("id,order_number,status,payment_status,total_cents,created_at,club_events(title),profiles:user_id(full_name,email),club_event_order_items(quantity,ticket_name),club_event_tickets(status,redeemed_at)").order("created_at",{ascending:false}).limit(150);
---
<PortalLayout title="Event tickets" section="Administration" session={session}><div class="grid gap-6"><AdminFeedback success={Astro.url.searchParams.get("success")} error={Astro.url.searchParams.get("error")}/>
 {canRedeem&&<section class="surface p-5"><h1 class="panel-title">Scan or redeem ticket</h1><form class="mt-4 flex flex-col gap-3 sm:flex-row" method="post" action="/api/admin/redeem-event-ticket"><label class="grow"><span class="label">Ticket QR code or code</span><input class="field" name="code" required autocomplete="off"/></label><button class="self-end bg-eagles-green px-5 py-3 font-black text-white" type="submit" style="border-radius:8px">Redeem ticket</button></form></section>}
 <section class="surface p-5"><div class="flex justify-between gap-4"><h2 class="panel-title">Orders and attendees</h2><a class="font-black text-eagles-green" href="/api/admin/event-attendees.csv">Export CSV</a></div><div class="mt-5 grid gap-3">{(orders??[]).map((order:any)=><article class="border-t border-eagles-line pt-4"><div class="flex flex-wrap justify-between gap-3"><div><p class="font-black">{order.club_events?.title} · {order.order_number}</p><p class="text-sm">{order.profiles?.full_name??order.profiles?.email??"Purchaser"} · {order.club_event_order_items?.reduce((n:number,i:any)=>n+i.quantity,0)??0} ticket(s) · {formatMoney(order.total_cents)}</p><p class="text-xs text-eagles-ink/60">{formatDateTime(order.created_at)}</p></div><div class="flex gap-2"><StatusBadge label={statusLabel(order.payment_status)} tone={order.payment_status==="paid"||order.payment_status==="not_required"?"green":"amber"}/><StatusBadge label={statusLabel(order.status)} tone={order.status==="completed"?"green":"amber"}/></div></div></article>)}</div></section>
</div></PortalLayout>
