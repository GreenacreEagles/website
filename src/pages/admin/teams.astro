---
import AdminDialog from "@components/AdminDialog.astro";
import AdminFeedback from "@components/AdminFeedback.astro";
import AdminPageHeader from "@components/AdminPageHeader.astro";
import FormActions from "@components/FormActions.astro";
import ImageUploadField from "@components/ImageUploadField.astro";
import PortalLayout from "@layouts/PortalLayout.astro";
import StatusBadge from "@components/StatusBadge.astro";
import { requirePermission } from "@lib/auth/guards";
import { formatDate, statusLabel } from "@lib/format";
import { getMediaCapabilities, getPublicMediaUrl } from "@lib/media";

export const prerender = false;

const session = await requirePermission(Astro, ["club_structure.manage", "teams.manage", "team_memberships.manage"]);
if (!session) return Astro.redirect("/login/");

const success = Astro.url.searchParams.get("success");
const error = Astro.url.searchParams.get("error");
const { publicMediaConfigured } = getMediaCapabilities(Astro);
const requestedSeasonId = Astro.url.searchParams.get("season");
const requestedTeamId = Astro.url.searchParams.get("team");
const q=Astro.url.searchParams.get("q")?.trim().toLowerCase()??"";
const statusFilter=Astro.url.searchParams.get("status")??"";
const competitionFilter=Astro.url.searchParams.get("competition")??"";
const [{ data: seasons }, { data: teams }, { data: competitions }, { data: profiles }, { data: teamStaff }, { data: teamPlayers }] = await Promise.all([
  session.supabase.from("seasons").select("*").order("starts_on", { ascending: false }),
  (session.supabase as any).from("teams").select("id,name,slug,season_id,competition_id,public,summary,sort_order,division,colour,status,external_fixture_url,image_object_key,seasons(id,name),competitions(id,name)").order("name"),
  session.supabase.from("competitions").select("id,name").order("name"),
  session.supabase.from("profiles").select("id,full_name,preferred_name,email").order("full_name").limit(300),
  session.supabase.from("team_staff").select("id,team_id,staff_role,status,starts_on,ends_on,profiles:user_id(full_name,preferred_name,email)").order("created_at", { ascending: false }).limit(300),
  session.supabase.from("team_players").select("id,team_id,status,squad_number,player_records(id,profiles:user_id(full_name,preferred_name,email))").order("created_at", { ascending: false }).limit(400)
]);

const seasonList = seasons ?? [];
const teamList = teams ?? [];
const selectedSeason = seasonList.find((season) => season.id === requestedSeasonId)
  ?? seasonList.find((season) => season.status === "active")
  ?? seasonList[0]
  ?? null;
const filteredTeams = selectedSeason ? teamList.filter((team: any) => team.season_id === selectedSeason.id) : [];
const selectedTeam = filteredTeams.find((team: any) => team.id === requestedTeamId) ?? null;
const selectedTeamPlayers = selectedTeam ? (teamPlayers ?? []).filter((item: any) => item.team_id === selectedTeam.id) : [];
const selectedTeamStaff = selectedTeam ? (teamStaff ?? []).filter((item: any) => item.team_id === selectedTeam.id) : [];
const canManage = session.permissions.has("*") || session.permissions.has("club_structure.manage") || session.permissions.has("teams.manage");
const canAssign = session.permissions.has("*") || session.permissions.has("club_structure.manage") || session.permissions.has("team_memberships.manage");
const seasonUrl = (seasonId: string) => "/admin/teams/?season=" + encodeURIComponent(seasonId);
const teamUrl = (teamId: string) => seasonUrl(selectedSeason?.id ?? "") + "&team=" + encodeURIComponent(teamId) + "#team-details";
const searchedTeams=filteredTeams.filter((team:any)=>{const haystack=[team.name,team.division,team.seasons?.name,team.competitions?.name].filter(Boolean).join(" ").toLowerCase();return (!q||haystack.includes(q))&&(!statusFilter||team.status===statusFilter)&&(!competitionFilter||team.competition_id===competitionFilter);});
---

<PortalLayout title="Seasons & teams" section="Administration" session={session}>
  <div class="grid gap-6">
    <AdminFeedback success={success} error={error} />
    <AdminPageHeader title="Seasons and teams" intro="Choose a season, open a team, then manage its players and staff from one focused workspace.">
      <Fragment slot="actions">
        {canManage && <AdminDialog id="create-competition" title="Create competition" actionLabel="Competition" size="lg">
          <form class="grid gap-4" method="post" action="/api/admin/create-record">
            <input type="hidden" name="action" value="competition" />
            <label><span class="label">Name</span><input class="field" name="name" placeholder="Bankstown Premier League" required /></label>
            <label><span class="label">Season</span><select class="field" name="season_id"><option value="">No season</option>{seasonList.map((season) => <option value={season.id} selected={season.id === selectedSeason?.id}>{season.name}</option>)}</select></label>
            <label><span class="label">External link</span><input class="field" name="external_url" type="url" /></label>
            <FormActions submitLabel="Create competition" />
          </form>
        </AdminDialog>}
        {canManage && <AdminDialog id="create-season" title="Create season" actionLabel="Season" size="lg">
          <form class="grid gap-4" method="post" action="/api/admin/create-season">
            <label><span class="label">Name</span><input class="field" name="name" placeholder="Season 2027" required /></label>
            <label><span class="label">Year</span><input class="field" name="year" type="number" min="2000" max="2100" required /></label>
            <div class="grid gap-3 md:grid-cols-2">
              <label><span class="label">Starts</span><input class="field" name="starts_on" type="date" required /></label>
              <label><span class="label">Ends</span><input class="field" name="ends_on" type="date" required /></label>
            </div>
            <label><span class="label">Status</span><select class="field" name="status">{["draft", "active", "completed", "archived"].map((item) => <option value={item}>{item}</option>)}</select></label>
            <FormActions submitLabel="Create season" />
          </form>
        </AdminDialog>}
        {canManage && <AdminDialog id="create-team" title="Create team" actionLabel="Team" size="xl">
          <form class="grid gap-4" method="post" action="/api/admin/create-team" enctype="multipart/form-data">
            <label><span class="label">Season</span><select class="field" name="season_id" required><option value="">Select season</option>{seasonList.map((season) => <option value={season.id} selected={season.id === selectedSeason?.id}>{season.name}</option>)}</select></label>
            <label><span class="label">Competition</span><select class="field" name="competition_id"><option value="">Not set</option>{(competitions ?? []).map((competition) => <option value={competition.id}>{competition.name}</option>)}</select></label>
            <label><span class="label">Name</span><input class="field" name="name" required /></label>
            <label><span class="label">Public URL slug</span><input class="field" name="slug" pattern="[a-z0-9]+(?:-[a-z0-9]+)*" placeholder="u6-green-koalas" required /></label>
            <label><span class="label">Public summary</span><textarea class="field min-h-24" name="summary" maxlength="500"></textarea></label>
            <div class="grid gap-3 md:grid-cols-2">
              <label><span class="label">Display order</span><input class="field" name="sort_order" type="number" min="0" value="100" /></label>
              <label class="flex items-center gap-3 pt-7 text-sm font-bold"><input type="checkbox" name="public" />Show on public website</label>
            </div>
            <label><span class="label">Division</span><input class="field" name="division" /></label>
            <label><span class="label">Colour</span><input class="field" name="colour" placeholder="Green" /></label>
            <label><span class="label">Fixture link</span><input class="field" name="external_fixture_url" type="url" /></label>
            <ImageUploadField name="image" label="Upload team image" maxSizeMb={8} configured={publicMediaConfigured} />
            <label><span class="label">Status</span><select class="field" name="status">{["active", "inactive"].map((item) => <option value={item}>{statusLabel(item)}</option>)}</select></label>
            <FormActions submitLabel="Create team" />
          </form>
        </AdminDialog>}
      </Fragment>
    </AdminPageHeader>
    <form class="surface grid gap-3 p-4 sm:grid-cols-2 xl:grid-cols-5" method="get"><label class="sm:col-span-2"><span class="label">Search teams</span><input class="field" type="search" name="q" value={q} placeholder="Team, season, competition or division"/></label><label><span class="label">Season</span><select class="field" name="season"><option value="">All</option>{(seasons??[]).map((item:any)=><option value={item.id} selected={requestedSeasonId===item.id}>{item.name}</option>)}</select></label><label><span class="label">Competition</span><select class="field" name="competition"><option value="">All</option>{(competitions??[]).map((item:any)=><option value={item.id} selected={competitionFilter===item.id}>{item.name}</option>)}</select></label><label><span class="label">Status</span><select class="field" name="status"><option value="">All</option><option value="active" selected={statusFilter==="active"}>Active</option><option value="inactive" selected={statusFilter==="inactive"}>Inactive</option></select></label><button class="min-h-11 rounded-lg bg-eagles-green px-4 py-2 text-sm font-black text-white xl:col-start-5">Filter</button></form>

    <section class="surface p-5 md:p-7">
      <div>
        <p class="text-xs font-black uppercase tracking-[0.18em] text-eagles-green">Filter teams</p>
        <h2 class="mt-1 panel-title">Seasons</h2>
      </div>
      {seasonList.length === 0 ? (
        <p class="mt-5 text-sm text-eagles-ink/70">No seasons have been created yet.</p>
      ) : (
        <div class="mt-5 flex gap-3 overflow-x-auto pb-2">
          {seasonList.map((season) => (
            <a
              href={seasonUrl(season.id)}
              aria-current={season.id === selectedSeason?.id ? "page" : undefined}
              class:list={[
                "min-w-52 border p-4 transition hover:-translate-y-0.5",
                season.id === selectedSeason?.id ? "border-eagles-green bg-eagles-green text-white" : "border-eagles-line bg-white text-eagles-ink"
              ]}
              style="border-radius:8px"
            >
              <div class="flex items-start justify-between gap-3">
                <p class="font-black">{season.name}</p>
                <StatusBadge label={season.status} tone={season.status === "active" ? "green" : "ink"} />
              </div>
              <p class:list={["mt-2 text-xs", season.id === selectedSeason?.id ? "text-white/75" : "text-eagles-ink/60"]}>{formatDate(season.starts_on)} to {formatDate(season.ends_on)}</p>
            </a>
          ))}
        </div>
      )}
    </section>

    <section class="surface p-5 md:p-7">
      <div class="flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="text-xs font-black uppercase tracking-[0.18em] text-eagles-green">{selectedSeason?.name ?? "Select a season"}</p>
          <h2 class="mt-1 panel-title">Teams</h2>
        </div>
        <p class="text-sm text-eagles-ink/60">{searchedTeams.length} {searchedTeams.length === 1 ? "team" : "teams"}</p>
      </div>
      <div class="mt-5 grid gap-3 lg:grid-cols-2">
        {selectedSeason && searchedTeams.length === 0 && <p class="text-sm text-eagles-ink/70">No teams are attached to this season yet.</p>}
        {searchedTeams.map((team: any) => (
          <article class:list={["border p-4", team.id === selectedTeam?.id ? "border-eagles-green bg-eagles-mist" : "border-eagles-line bg-white"]} style="border-radius:8px">
            <div class="flex items-start justify-between gap-4">
              <a class="min-w-0 flex-1" href={teamUrl(team.id)}>
                <p class="font-black text-eagles-ink hover:text-eagles-green">{team.name}</p>
                <p class="mt-1 text-sm text-eagles-ink/60">{team.competitions?.name ?? "No competition"}{team.division ? " - " + team.division : ""}</p>
                <p class="mt-2 text-xs font-bold text-eagles-green">View squad and staff →</p>
              </a>
              <div class="flex shrink-0 items-center gap-2">
                <StatusBadge label={team.status} tone={team.status === "active" ? "green" : "ink"} />
                {canManage && <AdminDialog id={`team-image-${team.id}`} title={`Team image — ${team.name}`} actionLabel="Image" tone="secondary" size="md"><form class="grid gap-4" method="post" action="/api/admin/team-image" enctype="multipart/form-data"><input type="hidden" name="team_id" value={team.id}/><ImageUploadField name="image" label="Upload team image" currentUrl={getPublicMediaUrl(team.image_object_key,Astro)} currentAlt={team.name} hasCurrent={Boolean(team.image_object_key)} removeName="remove_image" maxSizeMb={8} configured={publicMediaConfigured}/><FormActions submitLabel="Save team image"/></form></AdminDialog>}
                {canAssign && <AdminDialog id={"add-team-member-" + team.id} title={"Add person to " + team.name} actionLabel="+" size="lg">
                  <form class="grid gap-4" method="post" action="/api/admin/team-assignment">
                    <input type="hidden" name="team_id" value={team.id} />
                    <input type="hidden" name="status" value="active" />
                    <input type="hidden" name="return_to" value={teamUrl(team.id)} />
                    <label><span class="label">Person</span><select class="field" name="user_id" required><option value="">Select person</option>{(profiles ?? []).map((profile: any) => <option value={profile.id}>{profile.preferred_name || profile.full_name || profile.email}</option>)}</select></label>
                    <label><span class="label">Add as</span><select class="field" name="position" required><option value="player">Player</option><option value="coach">Coach</option><option value="team_manager">Team Manager</option></select></label>
                    <div class="grid gap-3 md:grid-cols-2">
                      <label><span class="label">Starts</span><input class="field" name="starts_on" type="date" /></label>
                      <label><span class="label">Ends</span><input class="field" name="ends_on" type="date" /></label>
                    </div>
                    <FormActions submitLabel="Add to team" />
                  </form>
                </AdminDialog>}
              </div>
            </div>
            <p class="mt-3 text-xs text-eagles-ink/55">{team.public ? "/teams/" + team.slug + "/" : "Private team"}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="team-details" class="surface p-5 md:p-7">
      {selectedTeam ? (
        <>
          <div>
            <p class="text-xs font-black uppercase tracking-[0.18em] text-eagles-green">{selectedSeason?.name}</p>
            <h2 class="mt-1 panel-title">{selectedTeam.name}</h2>
            <p class="mt-2 text-sm text-eagles-ink/65">Only this team’s players and staff are shown below.</p>
          </div>
          <div class="mt-6 grid gap-6 xl:grid-cols-2">
            <section class="grid content-start gap-3">
              <div class="flex items-center justify-between gap-3"><h3 class="text-sm font-black uppercase text-eagles-green">Players</h3><span class="text-xs font-bold text-eagles-ink/50">{selectedTeamPlayers.length}</span></div>
              {selectedTeamPlayers.length === 0 && <p class="text-sm text-eagles-ink/70">No players are assigned to this team.</p>}
              {selectedTeamPlayers.map((link: any) => (
                <p class="border border-eagles-line bg-white p-3 text-sm" style="border-radius:8px">
                  <strong>{link.player_records?.profiles?.preferred_name || link.player_records?.profiles?.full_name || "Player"}</strong><br />
                  {link.squad_number !== null ? "#" + link.squad_number + " - " : ""}{statusLabel(link.status)}
                </p>
              ))}
            </section>
            <section class="grid content-start gap-3">
              <div class="flex items-center justify-between gap-3"><h3 class="text-sm font-black uppercase text-eagles-green">Staff</h3><span class="text-xs font-bold text-eagles-ink/50">{selectedTeamStaff.length}</span></div>
              {selectedTeamStaff.length === 0 && <p class="text-sm text-eagles-ink/70">No coaches or Team Managers are assigned to this team.</p>}
              {selectedTeamStaff.map((staff: any) => (
                <p class="border border-eagles-line bg-white p-3 text-sm" style="border-radius:8px">
                  <strong>{staff.profiles?.preferred_name || staff.profiles?.full_name || staff.profiles?.email}</strong><br />
                  {statusLabel(staff.staff_role)} - {statusLabel(staff.status)}
                </p>
              ))}
            </section>
          </div>
        </>
      ) : (
        <div class="py-6 text-center">
          <h2 class="panel-title">Squad and staff</h2>
          <p class="mt-3 text-sm text-eagles-ink/65">Select a team above to view only the players and staff attached to it.</p>
        </div>
      )}
    </section>
  </div>
</PortalLayout>
