---
import EmptyState from "@components/EmptyState.astro";
import AdminDialog from "@components/AdminDialog.astro";
import AdminFeedback from "@components/AdminFeedback.astro";
import AdminPageHeader from "@components/AdminPageHeader.astro";
import FormActions from "@components/FormActions.astro";
import ImageUploadField from "@components/ImageUploadField.astro";
import PortalLayout from "@layouts/PortalLayout.astro";
import StatusBadge from "@components/StatusBadge.astro";
import { requirePermission } from "@lib/auth/guards";
import { formatDateTime, formatMoney, statusLabel } from "@lib/format";
import { getMediaCapabilities, getPublicMediaUrl, getSafeExternalImageUrl } from "@lib/media";

export const prerender = false;

const session = await requirePermission(Astro, ["events.manage"]);
if (!session) return Astro.redirect("/login/");

const success = Astro.url.searchParams.get("success");
const error = Astro.url.searchParams.get("error");
const { publicMediaConfigured } = getMediaCapabilities(Astro);
const [{ data: events }, { data: registrations }] = await Promise.all([
  (session.supabase as any).from("club_events").select("id,title,slug,description,status,visibility,starts_at,ends_at,registration_opens_at,registration_closes_at,capacity,price_cents,image_url,image_object_key,venue,club_event_ticket_types(id,name,description,price_cents,capacity,max_per_order,active,sort_order)").order("starts_at", { ascending: false }).limit(80),
  session.supabase.from("event_registrations").select("id,status,created_at,club_events(title),profiles:attendee_id(full_name,email)").order("created_at", { ascending: false }).limit(80)
]);
---

<PortalLayout title="Event management" section="Administration" session={session}>
  <div class="grid gap-6">
    <AdminFeedback success={success} error={error} />
    <AdminPageHeader title="Event management" intro="Plan club events, publish registration windows and keep attendance visible from the same workspace.">
      <Fragment slot="actions">
        <AdminDialog id="add-event" title="Add event" actionLabel="Add event" intro="Create the event shell now; registrations and payments can be managed once it is live." size="xl">
          <form class="grid gap-4" method="post" action="/api/admin/event-entry">
            <label><span class="label">Title</span><input class="field" name="title" required /></label>
            <label><span class="label">Slug</span><input class="field" name="slug" placeholder="Auto-generated if empty" /></label>
            <label><span class="label">Description</span><textarea class="field min-h-24" name="description"></textarea></label>
            <label><span class="label">Venue</span><input class="field" name="venue" maxlength="240" placeholder="e.g. Greenacre Community Hall" /></label>
            <div class="grid gap-3 md:grid-cols-2">
              <label><span class="label">Starts</span><input class="field" name="starts_at" type="datetime-local" required /></label>
              <label><span class="label">Ends</span><input class="field" name="ends_at" type="datetime-local" /></label>
            </div>
            <div class="grid gap-3 md:grid-cols-2">
              <label><span class="label">Registration opens</span><input class="field" name="registration_opens_at" type="datetime-local" /></label>
              <label><span class="label">Registration closes</span><input class="field" name="registration_closes_at" type="datetime-local" /></label>
            </div>
            <div class="grid gap-3 md:grid-cols-2">
              <label><span class="label">Capacity</span><input class="field" name="capacity" type="number" min="1" /></label>
              <label><span class="label">Price</span><input class="field" name="price" type="number" min="0" step="0.01" value="0" /></label>
            </div>
            <div class="grid gap-3 md:grid-cols-2">
              <label><span class="label">Visibility</span><select class="field" name="visibility">{["public", "members", "private"].map((item) => <option value={item}>{statusLabel(item)}</option>)}</select></label>
              <label><span class="label">Status</span><select class="field" name="status">{["active", "inactive", "cancelled", "completed"].map((item) => <option value={item}>{statusLabel(item)}</option>)}</select></label>
            </div>
            <FormActions submitLabel="Add event" />
          </form>
        </AdminDialog>
      </Fragment>
    </AdminPageHeader>
  </div>
  <div class="grid gap-6 xl:grid-cols-[1fr_380px]">
    <section class="surface p-5 md:p-7">
      <h2 class="font-display text-3xl font-black uppercase leading-none">Events</h2>
      <div class="mt-5 grid gap-3">
        {(events ?? []).length === 0 && <EmptyState title="No events" text="Club events and registration windows will appear here." />}
        {(events ?? []).map((event: any) => (
          <article class="border border-eagles-line bg-white p-4" style="border-radius:8px">
            <p class="font-black">{event.title}</p>
            <p class="text-sm text-eagles-ink/70">{formatDateTime(event.starts_at)} - {event.venue ?? "venue TBC"} - {formatMoney(event.price_cents)}</p>
            <div class="mt-2 flex gap-2"><StatusBadge label={statusLabel(event.status)} tone={event.status === "active" ? "green" : "amber"} /><StatusBadge label={statusLabel(event.visibility)} tone="ink" /></div>
            <div class="mt-3 flex flex-wrap items-center gap-3">
              <AdminDialog id={"edit-event-"+event.id} title={"Edit "+event.title} actionLabel="Edit" tone="secondary" size="xl">
                <form class="grid gap-4" method="post" action="/api/admin/event-entry"><input type="hidden" name="id" value={event.id}/>
                  <label><span class="label">Title</span><input class="field" name="title" value={event.title} required/></label><label><span class="label">Slug</span><input class="field" name="slug" value={event.slug}/></label><label><span class="label">Description</span><textarea class="field min-h-24" name="description">{event.description??""}</textarea></label><label><span class="label">Venue</span><input class="field" name="venue" maxlength="240" value={event.venue??""}/></label>
                  <div class="grid gap-3 md:grid-cols-2"><label><span class="label">Starts</span><input class="field" name="starts_at" type="datetime-local" value={event.starts_at?.slice(0,16)} required/></label><label><span class="label">Ends</span><input class="field" name="ends_at" type="datetime-local" value={event.ends_at?.slice(0,16)??""}/></label></div>
                  <div class="grid gap-3 md:grid-cols-2"><label><span class="label">Registration opens</span><input class="field" name="registration_opens_at" type="datetime-local" value={event.registration_opens_at?.slice(0,16)??""}/></label><label><span class="label">Registration closes</span><input class="field" name="registration_closes_at" type="datetime-local" value={event.registration_closes_at?.slice(0,16)??""}/></label></div>
                  <div class="grid gap-3 md:grid-cols-2"><label><span class="label">Capacity</span><input class="field" name="capacity" type="number" min="1" value={event.capacity??""}/></label><label><span class="label">Price</span><input class="field" name="price" type="number" min="0" step=".01" value={(event.price_cents/100).toFixed(2)}/></label></div>
                  <div class="grid gap-3 md:grid-cols-2"><label><span class="label">Visibility</span><select class="field" name="visibility">{["public","members","private"].map(item=><option value={item} selected={item===event.visibility}>{statusLabel(item)}</option>)}</select></label><label><span class="label">Status</span><select class="field" name="status">{["active","inactive","cancelled","completed"].map(item=><option value={item} selected={item===event.status}>{statusLabel(item)}</option>)}</select></label></div>
                  <FormActions submitLabel="Save changes"/><button class="text-sm font-black text-red-700" name="intent" value="delete" formnovalidate onclick="return confirm('Delete this event and its registrations and ticket types?')">Delete event</button>
                </form>
              </AdminDialog>
              <AdminDialog id={`image-${event.id}`} title={`Event image — ${event.title}`} actionLabel="Event image" tone="secondary">
                <form class="grid gap-4" method="post" action="/api/admin/event-image" enctype="multipart/form-data"><input type="hidden" name="event_id" value={event.id}/><ImageUploadField name="image" label="Upload event image" currentUrl={getPublicMediaUrl(event.image_object_key,Astro)??getSafeExternalImageUrl(event.image_url)} currentAlt={event.title} hasCurrent={Boolean(event.image_object_key||event.image_url)} removeName="remove_image" maxSizeMb={8} configured={publicMediaConfigured}/><FormActions submitLabel="Save event image"/></form>
              </AdminDialog>
              <AdminDialog id={`ticket-${event.id}`} title={`New ticket type — ${event.title}`} actionLabel="Manage tickets" tone="secondary">
                <form class="grid gap-4" method="post" action="/api/admin/event-ticket-type"><input type="hidden" name="event_id" value={event.id}/>
                  <label><span class="label">Ticket name</span><input class="field" name="name" required maxlength="120"/></label><label><span class="label">Description</span><textarea class="field" name="description"></textarea></label>
                  <div class="grid gap-3 md:grid-cols-2"><label><span class="label">Price (AUD)</span><input class="field" name="price" type="number" min="0" step=".01" value="0"/></label><label><span class="label">Capacity</span><input class="field" name="capacity" type="number" min="1"/></label></div>
                  <div class="grid gap-3 md:grid-cols-2"><label><span class="label">Maximum per order</span><input class="field" name="max_per_order" type="number" min="1" max="50" value="10"/></label><label><span class="label">Sort order</span><input class="field" name="sort_order" type="number" min="0" value="100"/></label></div>
                  <label class="flex gap-2"><input name="active" type="checkbox" checked/> Active</label><FormActions submitLabel="Add ticket type"/>
                </form>
                <div class="mt-6 grid gap-4 border-t border-eagles-line pt-4">
                  {(event.club_event_ticket_types??[]).map((type:any)=><form class="grid gap-3 border border-eagles-line p-3" style="border-radius:8px" method="post" action="/api/admin/event-ticket-type"><input type="hidden" name="id" value={type.id}/><input type="hidden" name="event_id" value={event.id}/>
                    <label><span class="label">Ticket name</span><input class="field" name="name" value={type.name} required/></label><label><span class="label">Description</span><textarea class="field" name="description">{type.description??""}</textarea></label>
                    <div class="grid gap-3 md:grid-cols-2"><label><span class="label">Price</span><input class="field" name="price" type="number" min="0" step=".01" value={(type.price_cents/100).toFixed(2)}/></label><label><span class="label">Capacity</span><input class="field" name="capacity" type="number" min="1" value={type.capacity??""}/></label></div>
                    <div class="grid gap-3 md:grid-cols-2"><label><span class="label">Maximum per order</span><input class="field" name="max_per_order" type="number" min="1" max="50" value={type.max_per_order}/></label><label><span class="label">Sort order</span><input class="field" name="sort_order" type="number" min="0" value={type.sort_order}/></label></div>
                    <label class="flex gap-2"><input name="active" type="checkbox" checked={type.active}/> Active</label><FormActions submitLabel="Save ticket type"/><button class="text-left text-sm font-black text-red-700" name="intent" value="delete" formnovalidate onclick="return confirm('Delete this ticket type?')">Delete ticket type</button>
                  </form>)}
                </div>
              </AdminDialog>
              <a class="text-sm font-black text-eagles-green" href="/admin/event-tickets/">View orders</a>
            </div>
          </article>
        ))}
      </div>
    </section>
    <aside class="grid gap-5 content-start">
      <article class="surface p-5">
        <h2 class="font-display text-2xl font-black uppercase leading-none">Registrations</h2>
        <div class="mt-4 grid gap-3">
          {(registrations ?? []).length === 0 && <p class="text-sm leading-6 text-eagles-ink/70">No event registrations yet.</p>}
          {(registrations ?? []).map((registration: any) => <p class="border-t border-eagles-line pt-3 text-sm"><strong>{registration.profiles?.full_name ?? registration.profiles?.email ?? "Attendee"}</strong><br />{registration.club_events?.title ?? "Event"} - {statusLabel(registration.status)}</p>)}
        </div>
      </article>
    </aside>
  </div>
</PortalLayout>
