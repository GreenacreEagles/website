---
import AdminDialog from "@components/AdminDialog.astro";
import AdminFeedback from "@components/AdminFeedback.astro";
import AdminPageHeader from "@components/AdminPageHeader.astro";
import CanteenProductForm from "@components/CanteenProductForm.astro";
import EmptyState from "@components/EmptyState.astro";
import FormActions from "@components/FormActions.astro";
import StatusBadge from "@components/StatusBadge.astro";
import PortalLayout from "@layouts/PortalLayout.astro";
import { requirePermission } from "@lib/auth/guards";
import { formatDateTime, formatMoney, statusLabel } from "@lib/format";
import { getMediaCapabilities, getPublicMediaUrl, getSafeExternalImageUrl } from "@lib/media";

export const prerender = false;
const session = await requirePermission(Astro, ["canteen.manage", "canteen.orders.manage", "canteen.vouchers.manage", "canteen.vouchers.redeem"]);
if (!session) return Astro.redirect("/login/");

const service = session.supabase as any;
const { publicMediaConfigured } = getMediaCapabilities(Astro);
const now = new Date().toISOString();
const [{ data: categories }, { data: products }, { data: orders }, { count: voucherCount }] = await Promise.all([
  service.from("canteen_categories").select("id,name,is_active,display_order").order("display_order").order("name"),
  service.from("canteen_products").select("id,category_id,name,description,price_cents,image_url,image_object_key,dietary_info,allergen_info,stock_quantity,low_stock_threshold,voucher_valid_days,is_active,is_sold_out,canteen_categories(name)").order("is_active", { ascending: false }).order("name").limit(200),
  service.from("canteen_orders").select("id,order_number,order_status,payment_status,payment_method,subtotal_cents,voucher_discount_cents,wallet_credit_cents,amount_due_cents,total_cents,created_at,special_instructions,pickup_code,profiles:customer_id(full_name,email),recipient:recipient_id(full_name,email),canteen_order_items(product_name_snapshot,quantity,line_total_cents)").in("order_status", ["awaiting_payment", "paid", "accepted", "preparing", "ready_for_pickup"]).order("created_at", { ascending: false }).limit(100),
  service.from("voucher_issuances").select("id", { count: "exact", head: true }).eq("status", "active").is("claimed_at", null).gt("remaining_value_cents", 0).or(`expires_at.is.null,expires_at.gt.${now}`),
]);

const canManageCatalog = session.permissions.has("*") || session.permissions.has("canteen.manage");
const canManageOrders = session.permissions.has("*") || session.permissions.has("canteen.orders.manage");
const canManageVouchers = session.permissions.has("*") || session.permissions.has("canteen.vouchers.manage");
const canRedeem = canManageOrders || session.permissions.has("*") || session.permissions.has("canteen.vouchers.redeem");
const soldOutCount = (products ?? []).filter((p: any) => p.is_active && p.is_sold_out).length;
const lowStockCount = (products ?? []).filter((p: any) => p.is_active && !p.is_sold_out && p.stock_quantity !== null && p.stock_quantity <= p.low_stock_threshold).length;
const dietaryOptions = ["vegetarian", "vegan", "halal", "gluten-free", "dairy-free"];
const allergenOptions = ["gluten", "dairy", "egg", "peanuts", "tree nuts", "soy", "sesame", "fish", "shellfish"];
const success = Astro.url.searchParams.get("success");
const error = Astro.url.searchParams.get("error");
const requestKey = crypto.randomUUID();
---

<PortalLayout title="Canteen operations" section="Administration" session={session}>
  <div class="grid gap-6">
    <AdminFeedback success={success} error={error} />
    <AdminPageHeader title="Canteen operations" intro="Manage live orders and the canteen product catalogue.">
      <Fragment slot="actions">
        {canRedeem && (
          <AdminDialog id="scan-canteen-code" title="Scan canteen code" actionLabel="Scan code" intro="Scan or enter an order, wallet or voucher code. Every redemption is confirmed before it is saved." size="xl">
            <div class="grid gap-5">
              <section class="grid gap-4 border border-eagles-line bg-eagles-mist p-4 md:grid-cols-[1fr_260px]" style="border-radius:8px">
                <video class="aspect-video w-full bg-eagles-ink object-cover" style="border-radius:8px" data-qr-video muted playsinline></video>
                <div class="grid content-between gap-3">
                  <p class="text-sm font-bold leading-6 text-eagles-ink/70" aria-live="polite" data-qr-status>Start the camera or enter a code below.</p>
                  <div class="flex flex-wrap gap-2">
                    <button class="bg-eagles-green px-4 py-3 text-sm font-black text-white" style="border-radius:8px" type="button" data-qr-start>Start camera</button>
                    <button class="border border-eagles-line bg-white px-4 py-3 text-sm font-black" style="border-radius:8px" type="button" data-qr-stop>Stop</button>
                  </div>
                </div>
              </section>
              <form class="grid gap-4 border border-eagles-line p-4" style="border-radius:8px" method="post" action="/api/admin/complete-canteen-order">
                <input type="hidden" name="order_id" value="" />
                <input type="hidden" name="source" value="qr" />
                <h4 class="font-display text-2xl font-black uppercase">Order collection</h4>
                <label><span class="label">Order QR or code</span><input class="field" name="order_code" data-scan-code data-code-type="order" placeholder="GEORDER:..." required /></label>
                <FormActions submitLabel="Confirm collection" />
              </form>
              <div class="grid gap-4 lg:grid-cols-2">
                <form class="grid gap-4 border border-eagles-line p-4" style="border-radius:8px" method="post" action="/api/admin/wallet-qr-purchase">
                  <input type="hidden" name="return_to" value="/admin/canteen/" />
                  <h4 class="font-display text-2xl font-black uppercase">Wallet purchase</h4>
                  <label><span class="label">Wallet code</span><input class="field" name="code" data-scan-code data-code-type="wallet" placeholder="GEWALLET:..." required /></label>
                  <label><span class="label">Amount</span><input class="field" name="amount" type="number" min="0.01" step="0.01" required /></label>
                  <input type="hidden" name="description" value="Canteen purchase" />
                  <FormActions submitLabel="Confirm wallet purchase" />
                </form>
                <form class="grid gap-4 border border-eagles-line p-4" style="border-radius:8px" method="post" action="/api/admin/redeem-voucher">
                  <input type="hidden" name="return_to" value="/admin/canteen/" />
                  <input type="hidden" name="device_label" value="Admin canteen scanner" />
                  <h4 class="font-display text-2xl font-black uppercase">Voucher claim</h4>
                  <label><span class="label">Voucher code</span><input class="field" name="redemption_code" data-scan-code data-code-type="voucher" placeholder="GEVOUCHER:..." required /></label>
                  <label><span class="label">Amount</span><input class="field" name="amount" type="number" min="0.01" step="0.01" required /></label>
                  <FormActions submitLabel="Confirm voucher claim" />
                </form>
              </div>
            </div>
          </AdminDialog>
        )}
        {canManageVouchers && (
          <AdminDialog id="issue-benefit" title="Issue canteen benefit" actionLabel="Issue voucher" intro="Select members, teams, or both. Duplicate members are automatically removed." size="xl">
            <form class="grid gap-5" method="post" action="/api/admin/canteen-benefits" data-benefit-form>
              <input type="hidden" name="request_key" value={requestKey} />
              <div class="grid gap-4 md:grid-cols-2">
                <div>
                  <label><span class="label">Find members</span><input class="field" type="search" data-recipient-search="member" autocomplete="off" placeholder="Search name or email" /></label>
                  <div class="mt-2 max-h-48 overflow-auto border border-eagles-line" data-search-results="member" aria-live="polite"></div>
                </div>
                <div>
                  <label><span class="label">Find teams</span><input class="field" type="search" data-recipient-search="team" autocomplete="off" placeholder="Search team name" /></label>
                  <div class="mt-2 max-h-48 overflow-auto border border-eagles-line" data-search-results="team" aria-live="polite"></div>
                </div>
              </div>
              <div class="border border-eagles-line bg-eagles-mist p-3" style="border-radius:8px">
                <p class="label">Selected recipients</p>
                <div class="mt-2 flex flex-wrap gap-2" data-selected-recipients><span class="text-sm text-eagles-ink/60">None selected.</span></div>
              </div>
              <div class="grid gap-4 md:grid-cols-2">
                <label><span class="label">Benefit</span><select class="field" name="benefit_type" data-benefit-type><option value="amount">Add wallet value</option><option value="item">Item voucher</option></select></label>
                <label data-amount-field><span class="label">Wallet value</span><input class="field" name="amount" type="number" min="0.01" step="0.01" value="5.00" /></label>
                <label class="hidden" data-product-field><span class="label">Active product</span><select class="field" name="product_id"><option value="">Select product</option>{(products ?? []).filter((p: any) => p.is_active && !p.is_sold_out).map((p: any) => <option value={p.id}>{p.name}</option>)}</select></label>
                <label><span class="label">Expires (optional)</span><input class="field" name="expires_at" type="datetime-local" /></label>
              </div>
              <label><span class="label">Reason</span><input class="field" name="issue_reason" maxlength="300" placeholder="Volunteer meal, player reward…" /></label>
              <p class="text-sm font-bold text-eagles-ink/70" data-benefit-summary aria-live="polite">No recipients selected.</p>
              <FormActions submitLabel="Review and issue" />
            </form>
          </AdminDialog>
        )}
        {canManageCatalog && (
          <AdminDialog id="new-canteen-product" title="New product" actionLabel="New product" size="xl">
            <CanteenProductForm categories={categories ?? []} dietaryOptions={dietaryOptions} allergenOptions={allergenOptions} mediaConfigured={publicMediaConfigured} />
          </AdminDialog>
        )}
        {canManageCatalog && (
          <AdminDialog id="manage-canteen-categories" title="Manage categories" actionLabel="Manage categories" tone="secondary" size="lg">
            <div class="grid gap-5">
              {(categories ?? []).map((category: any, index: number) => (
                <form class="grid gap-3 border border-eagles-line p-4 md:grid-cols-[1fr_130px_auto]" style="border-radius:8px" method="post" action="/api/admin/canteen-category">
                  <input type="hidden" name="category_id" value={category.id} />
                  <label><span class="label">Name</span><input class="field" name="name" value={category.name} required /></label>
                  <label><span class="label">Position</span><select class="field" name="position">{(categories ?? []).map((_: any, optionIndex: number) => <option value={optionIndex + 1} selected={index === optionIndex}>{optionIndex + 1}</option>)}</select></label>
                  <div class="flex flex-wrap items-end gap-3 pb-1"><label class="text-sm font-bold"><input type="checkbox" name="is_active" checked={category.is_active} /> Active</label><button class="bg-eagles-green px-3 py-2 text-xs font-black text-white" style="border-radius:8px">Save</button><button class="text-xs font-black text-red-700" name="intent" value="delete" formnovalidate onclick="return confirm('Delete this category? Products will become uncategorised.')">Delete</button></div>
                </form>
              ))}
              <form class="grid gap-3 border-t border-eagles-line pt-5 md:grid-cols-[1fr_130px_auto]" method="post" action="/api/admin/canteen-category">
                <input type="hidden" name="category_id" value="" />
                <label><span class="label">New category</span><input class="field" name="name" required /></label>
                <label><span class="label">Position</span><select class="field" name="position">{[...(categories ?? []), null].map((_: any, index: number) => <option value={index + 1} selected={index === (categories ?? []).length}>{index + 1}</option>)}</select></label>
                <div class="flex items-end gap-3 pb-1"><label class="text-sm font-bold"><input type="checkbox" name="is_active" checked /> Active</label><button class="bg-eagles-green px-3 py-2 text-xs font-black text-white" style="border-radius:8px">Add</button></div>
              </form>
            </div>
          </AdminDialog>
        )}
      </Fragment>
    </AdminPageHeader>

    <section class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4" aria-label="Canteen summary">
      {[
        ["Active orders", (orders ?? []).length],
        ["Active vouchers", voucherCount ?? 0],
        ["Sold out", soldOutCount],
        ["Low stock", lowStockCount],
      ].map(([label, value]) => <article class="surface p-4"><p class="text-xs font-black uppercase tracking-wide text-eagles-ink/60">{label}</p><p class="mt-2 font-display text-4xl font-black text-eagles-green">{value}</p></article>)}
    </section>

    <section class="surface p-5 md:p-7">
      <h2 class="font-display text-3xl font-black uppercase">Orders</h2>
      <p class="mt-1 text-sm text-eagles-ink/65">Only orders that still need action are shown.</p>
      <div class="mt-5 grid gap-3">
        {(orders ?? []).length === 0 && <EmptyState title="No active orders" text="New paid canteen orders will appear here." />}
        {(orders ?? []).map((order: any) => (
          <article class="border border-eagles-line p-4" style="border-radius:8px">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <p class="font-black">Order {order.order_number} · {formatMoney(order.total_cents)}</p>
                <p class="text-sm text-eagles-ink/65">{order.profiles?.full_name ?? order.profiles?.email ?? "Customer"} · {formatDateTime(order.created_at)}</p>
              </div>
              <div class="flex gap-2"><StatusBadge label={statusLabel(order.order_status)} tone="green" /><StatusBadge label={statusLabel(order.payment_status)} tone="ink" /></div>
            </div>
            <div class="mt-3 grid gap-1">{(order.canteen_order_items ?? []).map((item: any) => <p class="text-sm"><strong>{item.quantity}×</strong> {item.product_name_snapshot}</p>)}</div>
            <p class="mt-3 text-sm font-bold text-eagles-muted">{order.payment_method === "pay_at_club" ? `Pay at club · $${((order.amount_due_cents ?? 0) / 100).toFixed(2)} due` : "Paid with member benefits"}</p>
            {order.special_instructions && <p class="mt-3 bg-eagles-mist p-3 text-sm font-bold" style="border-radius:8px">{order.special_instructions}</p>}
            {canManageOrders && <div class="mt-4 flex flex-wrap gap-2">{order.payment_status !== "paid" && <form method="post" action="/api/admin/canteen-order-status"><input type="hidden" name="order_id" value={order.id} /><input type="hidden" name="payment_status" value="paid" /><input type="hidden" name="order_status" value="accepted" /><input type="hidden" name="reason" value="Payment received at club" /><button class="bg-eagles-ink px-4 py-3 text-sm font-black text-white" style="border-radius:8px">Mark payment received</button></form>}{order.payment_status === "paid" && <form method="post" action="/api/admin/complete-canteen-order"><input type="hidden" name="order_id" value={order.id} /><input type="hidden" name="source" value="manual" /><button class="bg-eagles-green px-4 py-3 text-sm font-black text-white" style="border-radius:8px">Complete order</button></form>}</div>}
          </article>
        ))}
      </div>
    </section>

    <section class="surface p-5 md:p-7">
      <h2 class="font-display text-3xl font-black uppercase">Products</h2>
      <div class="mt-5 grid gap-3 md:grid-cols-2 xl:grid-cols-3">
        {(products ?? []).map((product: any) => (
          <article class="border border-eagles-line p-4" style="border-radius:8px">
            <div class="flex items-start justify-between gap-3"><div><p class="font-black">{product.name}</p><p class="text-sm text-eagles-ink/65">{product.canteen_categories?.name ?? "Uncategorised"} · {formatMoney(product.price_cents)}</p></div><StatusBadge label={product.is_sold_out ? "Sold out" : product.is_active ? "Active" : "Inactive"} tone={product.is_sold_out ? "red" : product.is_active ? "green" : "ink"} /></div>
            <p class="mt-3 text-sm font-bold">{product.stock_quantity === null ? "Open stock" : `${product.stock_quantity} in stock`}</p>
            {canManageCatalog && <div class="mt-4"><AdminDialog id={`edit-product-${product.id}`} title={`Edit ${product.name}`} actionLabel="Edit" tone="secondary" size="xl"><CanteenProductForm product={product} categories={categories ?? []} dietaryOptions={dietaryOptions} allergenOptions={allergenOptions} mediaConfigured={publicMediaConfigured} currentUrl={getPublicMediaUrl(product.image_object_key,Astro)??getSafeExternalImageUrl(product.image_url)} /></AdminDialog></div>}
          </article>
        ))}
      </div>
    </section>
  </div>
</PortalLayout>

<script is:inline>
  (() => {
    const scanner = document.getElementById("scan-canteen-code");
    if (scanner && scanner.dataset.bound !== "true") {
      scanner.dataset.bound = "true";
      const video = scanner.querySelector("[data-qr-video]");
      const status = scanner.querySelector("[data-qr-status]");
      let stream, detector, scanning = false;
      const stop = () => { scanning = false; stream?.getTracks().forEach(t => t.stop()); stream = null; if (video) video.srcObject = null; };
      const apply = raw => {
        const code = String(raw || "").trim();
        const upper = code.toUpperCase();
        const type = upper.startsWith("GEORDER:") ? "order" : upper.startsWith("GEVOUCHER:") ? "voucher" : "wallet";
        const field = scanner.querySelector(`[data-code-type="${type}"]`);
        if (field) { field.value = code; field.focus(); status.textContent = "Code scanned. Check the details and confirm."; }
        stop();
      };
      const tick = async () => { if (!scanning) return; try { const codes = await detector.detect(video); if (codes?.[0]?.rawValue) return apply(codes[0].rawValue); } catch {} window.setTimeout(tick, 300); };
      scanner.querySelector("[data-qr-start]")?.addEventListener("click", async () => {
        if (!("BarcodeDetector" in window) || !navigator.mediaDevices?.getUserMedia) { status.textContent = "Camera scanning is unavailable. Enter the code manually."; return; }
        try { detector = new BarcodeDetector({ formats: ["qr_code"] }); stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: "environment" } }); video.srcObject = stream; await video.play(); scanning = true; status.textContent = "Point the camera at a QR code."; tick(); } catch { status.textContent = "Camera access was unavailable. Enter the code manually."; }
      });
      scanner.querySelector("[data-qr-stop]")?.addEventListener("click", stop);
      scanner.addEventListener("close", stop);
    }

    document.querySelectorAll("[data-benefit-form]").forEach(form => {
      const selected = new Map();
      const selectedBox = form.querySelector("[data-selected-recipients]");
      const summary = form.querySelector("[data-benefit-summary]");
      const render = () => {
        selectedBox.innerHTML = "";
        if (!selected.size) selectedBox.innerHTML = '<span class="text-sm text-eagles-ink/60">None selected.</span>';
        selected.forEach((entry, key) => {
          const label = document.createElement("label");
          label.className = "inline-flex items-center gap-2 bg-white px-3 py-2 text-sm font-bold";
          label.style.borderRadius = "8px";
          label.innerHTML = `<input type="checkbox" name="${entry.type}_ids" value="${entry.id}" checked> ${entry.label} <span aria-hidden="true">×</span>`;
          label.querySelector("input").addEventListener("change", () => { selected.delete(key); render(); });
          selectedBox.appendChild(label);
        });
        summary.textContent = selected.size ? `${selected.size} selected. You will confirm once more before issuing.` : "No recipients selected.";
      };
      form.querySelectorAll("[data-recipient-search]").forEach(input => {
        let timer;
        input.addEventListener("input", () => {
          clearTimeout(timer);
          timer = setTimeout(async () => {
            const type = input.dataset.recipientSearch;
            const box = form.querySelector(`[data-search-results="${type}"]`);
            box.textContent = "Searching…";
            try {
              const requestPath = `/api/admin/canteen-recipient-search?type=${type}&q=${encodeURIComponent(input.value)}`;
              const response = await fetch(requestPath, { credentials: "same-origin", headers: { Accept: "application/json" } });
              const contentType = response.headers.get("content-type") || "";
              if (!response.ok || !contentType.includes("application/json")) throw new Error(`${requestPath} returned HTTP ${response.status} (${contentType || "unknown content type"})`);
              const payload = await response.json();
              box.innerHTML = "";
              (payload.results || []).forEach(row => {
                const button = document.createElement("button");
                button.type = "button";
                button.className = "block w-full border-b border-eagles-line px-3 py-2 text-left text-sm hover:bg-eagles-mist";
                button.textContent = type === "team" ? row.name : `${row.full_name || "Member"}${row.email ? ` · ${row.email}` : ""}`;
                button.addEventListener("click", () => { selected.set(`${type}:${row.id}`, { type, id: row.id, label: button.textContent }); render(); });
                box.appendChild(button);
              });
              if (!box.children.length) box.textContent = "No matches.";
            } catch (error) { box.textContent = error instanceof Error ? `Search failed: ${error.message}` : "Search is temporarily unavailable."; }
          }, 250);
        });
      });
      const type = form.querySelector("[data-benefit-type]");
      type.addEventListener("change", () => {
        form.querySelector("[data-amount-field]").classList.toggle("hidden", type.value === "item");
        form.querySelector("[data-product-field]").classList.toggle("hidden", type.value !== "item");
      });
      form.addEventListener("submit", event => {
        if (!selected.size) { event.preventDefault(); window.alert("Select at least one member or team."); return; }
        if (!window.confirm(`Issue this benefit to the ${selected.size} selected member/team entries? Team members will be deduplicated.`)) event.preventDefault();
      }, { capture: true });
    });
  })();
</script>
