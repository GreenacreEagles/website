---
import AdminDialog from "@components/AdminDialog.astro";
import AdminFeedback from "@components/AdminFeedback.astro";
import AdminPageHeader from "@components/AdminPageHeader.astro";
import EmptyState from "@components/EmptyState.astro";
import FormActions from "@components/FormActions.astro";
import PortalLayout from "@layouts/PortalLayout.astro";
import StatusBadge from "@components/StatusBadge.astro";
import { requirePermission } from "@lib/auth/guards";
import { formatDateTime, statusLabel } from "@lib/format";

export const prerender = false;

const session = await requirePermission(Astro, ["content.manage"]);
if (!session) return Astro.redirect("/login/");

const success = Astro.url.searchParams.get("success");
const error = Astro.url.searchParams.get("error");
const { data: highlights } = await session.supabase
  .from("content_articles")
  .select("id,title,summary,workflow_status,publish_at,updated_at,featured_image_url")
  .eq("category", "Highlight")
  .order("updated_at", { ascending: false })
  .limit(120);
---

<PortalLayout title="Highlights" section="Administration" session={session}>
  <div class="grid gap-6">
    <AdminFeedback success={success} error={error} />
    <AdminPageHeader title="Highlights" intro="Manage club highlights with active and inactive status.">
      <Fragment slot="actions">
        <AdminDialog id="add-highlight" title="Add Highlight" actionLabel="Add Highlight" size="lg">
          <form class="grid gap-4" method="post" action="/api/admin/create-record/">
            <input type="hidden" name="action" value="article" />
            <input type="hidden" name="return_to" value="/admin/highlights/" />
            <input type="hidden" name="category" value="Highlight" />
            <label><span class="label">Title</span><input class="field" name="title" required /></label>
            <label><span class="label">Description</span><textarea class="field min-h-24" name="summary"></textarea></label>
            <label><span class="label">Content</span><textarea class="field min-h-32" name="body" required></textarea></label>
            <label><span class="label">Image or media URL</span><input class="field" name="featured_image_url" type="url" /></label>
            <label><span class="label">Date</span><input class="field" name="publish_at" type="datetime-local" /></label>
            <label><span class="label">Optional link/tag</span><input class="field" name="tags" placeholder="homepage, juniors" /></label>
            <label><span class="label">Status</span><select class="field" name="workflow_status"><option value="active">Active</option><option value="inactive">Inactive</option></select></label>
            <FormActions submitLabel="Save highlight" />
          </form>
        </AdminDialog>
      </Fragment>
    </AdminPageHeader>
    <section class="surface p-5 md:p-7">
      <div class="grid gap-3">
        {(highlights ?? []).length === 0 && <EmptyState title="No highlights" text="Club highlights will appear here." />}
        {(highlights ?? []).map((item: any) => (
          <article class="border border-eagles-line bg-white p-4" style="border-radius:8px">
            <div class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
              <div><p class="font-black">{item.title}</p><p class="text-sm text-eagles-ink/70">{item.summary ?? "Highlight"} - updated {formatDateTime(item.updated_at)}</p></div>
              <StatusBadge label={statusLabel(item.workflow_status)} tone={item.workflow_status === "active" ? "green" : "amber"} />
            </div>
          </article>
        ))}
      </div>
    </section>
  </div>
</PortalLayout>
