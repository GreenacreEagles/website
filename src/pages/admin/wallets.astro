---
import AdminDialog from "@components/AdminDialog.astro";import AdminFeedback from "@components/AdminFeedback.astro";import AdminPageHeader from "@components/AdminPageHeader.astro";import EmptyState from "@components/EmptyState.astro";import FormActions from "@components/FormActions.astro";import PortalLayout from "@layouts/PortalLayout.astro";import StatusBadge from "@components/StatusBadge.astro";import{requirePermission}from"@lib/auth/guards";import{formatDateTime,formatMoney,statusLabel}from"@lib/format";import{PAGE_BOUNDS,clampLimit,clampOffset,clampSearch}from"@lib/pagination";
export const prerender=false;const session=await requirePermission(Astro,["wallet.read","wallet.adjust","finance.read"]);if(!session)return Astro.redirect("/login/");const q=clampSearch(Astro.url.searchParams.get("q"))?.toLowerCase()??"";const canAdjust=session.permissions.has("*")||session.permissions.has("wallet.adjust");
const limit=clampLimit(Astro.url.searchParams.get("limit"),PAGE_BOUNDS.wallets);const offset=clampOffset(Astro.url.searchParams.get("offset"));const ledgerLimit=clampLimit(Astro.url.searchParams.get("ledger_limit"),PAGE_BOUNDS.ledger);
const[{data:wallets,count:walletCount},{data:ledger},{data:directory}]=await Promise.all([(session.supabase as any).from("wallet_accounts").select("id,owner_id,family_id,account_type,status,blocked_at,block_reason,created_at,wallet_balances(balance_cents),profiles:owner_id(full_name),families(name),wallet_qr_tokens(display_code,status)",{count:"exact"}).order("created_at",{ascending:false}).range(offset,offset+limit-1),(session.supabase as any).from("wallet_ledger_entries").select("id,wallet_account_id,amount_cents,direction,transaction_type,description,created_at").order("created_at",{ascending:false}).limit(ledgerLimit),(session.supabase as any).rpc("admin_user_directory",{search_text:null,page_limit:100,page_offset:0,target_user_id:null})]);
const emailById=new Map((directory??[]).map((u:any)=>[u.id,u.email]));const walletName=(w:any)=>w.profiles?.full_name||w.families?.name||"Club wallet";const searchable=(w:any)=>[walletName(w),emailById.get(w.owner_id),w.families?.name,w.wallet_qr_tokens?.[0]?.display_code,w.account_type].filter(Boolean).join(" ").toLowerCase();const rows=((wallets??[])as any[]).filter(w=>!q||searchable(w).includes(q));const recent=(id:string)=>((ledger??[])as any[]).filter(e=>e.wallet_account_id===id).slice(0,3);const requestKey=crypto.randomUUID();
const hasPrev=offset>0;const hasNext=offset+limit<(walletCount??0);const pageLink=(o:number)=>{const url=new URL(Astro.url);url.searchParams.set("offset",String(Math.max(0,o)));return`${url.pathname}${url.search}`;};
---
<PortalLayout title="Wallet administration" section="Administration" session={session}><div class="grid gap-6"><AdminFeedback success={Astro.url.searchParams.get("success")} error={Astro.url.searchParams.get("error")}/><AdminPageHeader title="Wallet administration" intro="Search wallets, review balances and use audited account actions."/><form class="surface grid gap-3 p-4 sm:grid-cols-[minmax(0,1fr)_auto]" method="get"><label><span class="label">Search wallets</span><input class="field" type="search" name="q" value={q} placeholder="Member, email, wallet code or family"/></label><button class="focus-ring min-h-11 self-end rounded-lg bg-eagles-green px-4 py-3 text-sm font-black text-white">Search</button></form><section class="surface p-4 sm:p-5 md:p-6"><div class="grid gap-3">{rows.length===0&&<EmptyState title="No wallets found" text="Try a different member, email, code or family name."/>}{(hasPrev||hasNext)&&<div class="flex items-center justify-between gap-3 border-b border-eagles-line pb-3"><a class:list={["focus-ring min-h-11 inline-flex items-center rounded-lg border border-eagles-line px-4 py-2 text-sm font-black",!hasPrev&&"pointer-events-none opacity-40"]} href={pageLink(offset-limit)} aria-disabled={!hasPrev}>Previous</a><span class="text-sm font-bold text-eagles-ink/60">Showing {offset+1}-{offset+rows.length} of {walletCount??rows.length}</span><a class:list={["focus-ring min-h-11 inline-flex items-center rounded-lg border border-eagles-line px-4 py-2 text-sm font-black",!hasNext&&"pointer-events-none opacity-40"]} href={pageLink(offset+limit)} aria-disabled={!hasNext}>Next</a></div>}{rows.map((wallet:any)=><article class="min-w-0 rounded-lg border border-eagles-line bg-white p-4"><div class="flex min-w-0 flex-col gap-3 sm:flex-row sm:items-start sm:justify-between"><div class="min-w-0"><h2 class="break-words font-black">{walletName(wallet)}</h2><p class="mt-1 break-all text-sm text-eagles-ink/65">{emailById.get(wallet.owner_id)??wallet.families?.name??statusLabel(wallet.account_type)}</p><p class="mt-2 text-2xl font-black text-eagles-pine">{formatMoney(wallet.wallet_balances?.[0]?.balance_cents??0)}</p></div><StatusBadge label={statusLabel(wallet.status)} tone={wallet.status==="active"?"green":"amber"}/></div><details class="mt-3 border-t border-eagles-line pt-3"><summary class="focus-ring min-h-11 cursor-pointer py-2 font-black text-eagles-pine">View ledger and actions</summary><div class="grid gap-3 pt-2">{recent(wallet.id).map((entry:any)=><p class="text-sm"><strong>{entry.direction==="credit"?"+":"-"}{formatMoney(entry.amount_cents)}</strong> {statusLabel(entry.transaction_type)} · {formatDateTime(entry.created_at)}</p>)}{recent(wallet.id).length===0&&<p class="text-sm text-eagles-ink/65">No recent transactions.</p>}{canAdjust&&<div class="flex flex-wrap gap-2"><AdminDialog id={"topup-"+wallet.id} title={"Manual top-up · "+walletName(wallet)} actionLabel="Add top-up" tone="secondary"><form class="grid gap-4" method="post" action="/api/admin/wallet-adjustment"><input type="hidden" name="wallet_id" value={wallet.id}/><input type="hidden" name="direction" value="credit"/><input type="hidden" name="transaction_type" value="manual_top_up"/><input type="hidden" name="idempotency_key" value={requestKey+":"+wallet.id}/><input type="hidden" name="return_to" value="/admin/wallets/"/><label><span class="label">Amount</span><input class="field" name="amount" type="number" min="0.01" step="0.01" required/></label><label><span class="label">Reason</span><textarea class="field min-h-20" name="description" minlength="3" required></textarea></label><FormActions submitLabel="Add top-up"/></form></AdminDialog><form class="grid gap-2 sm:grid-cols-[minmax(0,1fr)_auto]" method="post" action="/api/admin/wallet-status"><input type="hidden" name="wallet_id" value={wallet.id}/><input type="hidden" name="status" value={wallet.status==="active"?"frozen":"active"}/><input class="field" name="reason" maxlength="500" placeholder={wallet.status==="active"?"Reason for blocking":"Optional unblock note"}/><button class="focus-ring min-h-11 rounded-lg border border-eagles-line px-4 py-2 text-sm font-black text-eagles-pine">{wallet.status==="active"?"Block wallet":"Unblock wallet"}</button></form></div>}</div></details></article>)}</div></section></div></PortalLayout>
