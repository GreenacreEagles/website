---
import BaseLayout from "@layouts/BaseLayout.astro";
import ButtonLink from "@components/ButtonLink.astro";
export const prerender = true;
---

<BaseLayout title="Canteen" description="Order match-day food from the Greenacre Eagles FC canteen.">
  <section class="section-pad bg-eagles-mist">
    <div class="section-shell max-w-3xl">
      <p class="eyebrow">Canteen</p>
      <h1 class="mt-3 page-title">Order match-day food</h1>
      <p class="mt-5 text-lg leading-8 text-eagles-ink/70">Choose what you want, then pay when you collect it from the canteen.</p>
      <div class="mt-7">
        <ButtonLink href="/portal/canteen/shop/" variant="primary">Order from the canteen</ButtonLink>
      </div>
    </div>
  </section>
</BaseLayout>
