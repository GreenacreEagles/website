---
import BaseLayout from "@layouts/BaseLayout.astro";
import ButtonLink from "@components/ButtonLink.astro";
export const prerender=true;
---
<BaseLayout title="Canteen" description="Find out about the Greenacre Eagles FC canteen, order match-day food through the portal."><section class="section-pad bg-eagles-mist"><div class="section-shell grid gap-10 lg:grid-cols-[.9fr_1.1fr] lg:items-center"><div><p class="eyebrow">Canteen</p><h1 class="mt-3 font-display text-5xl font-black uppercase leading-none md:text-7xl">Match-day food at the Eagles</h1><p class="mt-5 text-lg leading-8 text-eagles-ink/70">Match-day favourites, cold drinks and quick snacks are available through the Greenacre Eagles canteen.</p><p class="mt-3 text-lg leading-8 text-eagles-ink/70">Club members can order ahead through the dedicated canteen area in the portal.</p><div class="mt-7 flex flex-col gap-3 sm:flex-row"><ButtonLink href="/portal/canteen/" variant="primary">Order from the canteen</ButtonLink><ButtonLink href="/contact/" variant="secondary">Contact the club</ButtonLink></div></div><article class="surface p-6"><h2 class="font-display text-3xl font-black uppercase">Made for match day</h2><p class="mt-4 leading-7 text-eagles-ink/70">The canteen supports players, families, volunteers and visitors throughout club match days.</p></article></div></section></BaseLayout>
