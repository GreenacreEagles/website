---
import BaseLayout from "@layouts/BaseLayout.astro";
import TurnstileWidget from "@components/TurnstileWidget.astro";
import { getPortalSession } from "@lib/auth/session";
import { getTurnstileSiteKey } from "@lib/security/turnstile";

export const prerender = false;

const session = await getPortalSession(Astro);
if (session) return Astro.redirect("/portal/");

const success = Astro.url.searchParams.get("success");
const error = Astro.url.searchParams.get("error");
const turnstileSiteKey = getTurnstileSiteKey();
---

<BaseLayout title="Reset password" description="Request a secure Greenacre Eagles FC password reset email.">
  <section class="section-pad bg-eagles-mist">
    <div class="section-shell grid gap-10 lg:grid-cols-[.85fr_1.15fr] lg:items-start">
      <div>
        <p class="eyebrow">Club portal</p>
        <h1 class="mt-3 page-title">Reset password</h1>
        <p class="mt-5 text-lg leading-8 text-eagles-ink/70">
          Enter your email address and we will send a secure link to reset your password.
        </p>
      </div>

      <div class="surface p-5 md:p-7">
        {success && <p class="mb-5 border border-eagles-green bg-green-50 p-4 text-sm font-bold text-eagles-pine" style="border-radius:8px">{success}</p>}
        {error && <p class="mb-5 border border-red-200 bg-red-50 p-4 text-sm font-bold text-red-700" style="border-radius:8px">{error}</p>}

        <form class="grid gap-5" method="post" action="/api/auth/reset-password">
          <label>
            <span class="label">Email</span>
            <input class="field" name="email" type="email" autocomplete="email" required />
          </label>
          <TurnstileWidget action="reset_password" />
          <button class="focus-ring inline-flex items-center justify-center bg-eagles-green px-5 py-3 text-sm font-black text-white hover:bg-eagles-ink" style="border-radius:8px" type="submit">
            Send reset link
          </button>
        </form>

        <p class="mt-6 border-t border-eagles-line pt-6 text-sm text-eagles-ink/70">
          Back to <a class="font-black text-eagles-green hover:text-eagles-ink" href="/login/">Sign in</a>
        </p>
      </div>
    </div>
  </section>
  {turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
</BaseLayout>
