---
import PortalLayout from"@layouts/PortalLayout.astro";import StatusBadge from"@components/StatusBadge.astro";import{requireUser}from"@lib/auth/guards";import{formatDateTime,formatMoney,statusLabel}from"@lib/format";export const prerender=false;const session=await requireUser(Astro);if(!session)return Astro.redirect(`/login/?returnTo=${encodeURIComponent(Astro.url.pathname)}`);const{data:orders}=await(session.supabase as any).from("shop_orders").select("id,order_number,status,payment_status,total_cents,created_at,shop_order_items(product_name_snapshot,variant_name_snapshot,quantity,product_type,status)").eq("user_id",session.user.id).order("created_at",{ascending:false});
---
<PortalLayout title="My orders" section="Club shop" session={session}><section class="grid gap-5"><h1 class="font-display text-5xl font-black uppercase">My orders</h1>{(orders??[]).length===0?<p class="surface p-5">You have not placed any club orders yet.</p>:(orders??[]).map((order:any)=><article class="surface p-5"><div class="flex flex-wrap justify-between gap-3"><div><h2 class="font-display text-2xl font-black uppercase">{order.order_number}</h2><p class="text-sm">{formatDateTime(order.created_at)} · {formatMoney(order.total_cents)}</p></div><div class="flex gap-2"><StatusBadge label={statusLabel(order.payment_status)} tone={["paid","not_required"].includes(order.payment_status)?"green":"amber"}/><StatusBadge label={statusLabel(order.status)} tone={["ready","completed"].includes(order.status)?"green":"amber"}/></div></div><div class="mt-4 grid gap-1">{order.shop_order_items.map((item:any)=><p class="text-sm"><strong>{item.quantity}×</strong> {item.product_name_snapshot}{item.variant_name_snapshot?` — ${item.variant_name_snapshot}`:""} · {statusLabel(item.status)}</p>)}</div><a class="mt-4 inline-flex font-black text-eagles-green" href={`/portal/orders/${order.id}/`}>View order</a></article>)}</section></PortalLayout>
