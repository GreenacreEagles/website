---
import EmptyState from "@components/EmptyState.astro";
import PortalFeedback from "@components/PortalFeedback.astro";
import PortalLayout from "@layouts/PortalLayout.astro";
import { requireUser } from "@lib/auth/guards";
import { formatMoney } from "@lib/format";
import { getPublicMediaUrl, getSafeExternalImageUrl } from "@lib/media";
import { loadMerchandiseCart, merchandiseCartTotals } from "@lib/merchandise-store";

export const prerender = false;

const session = await requireUser(Astro);
if (!session) return Astro.redirect(`/login/?returnTo=${encodeURIComponent("/portal/shop/cart/")}`);
if (session.isChildAccount) return Astro.redirect("/portal/teams/");

const success = Astro.url.searchParams.get("success");
const error = Astro.url.searchParams.get("error");
const cart = await loadMerchandiseCart(session.supabase);
const totals = merchandiseCartTotals(cart.items);
---

<PortalLayout title="Your cart" section="Club Store" session={session}>
  <div class="grid gap-6">
    <PortalFeedback success={success} error={error ?? cart.error} />

    <header class="surface flex flex-col gap-4 p-6 md:flex-row md:items-end md:justify-between md:p-8">
      <div>
        <p class="eyebrow">Club Store</p>
        <h1 class="mt-2 page-title">Your cart</h1>
        <p class="mt-3 text-eagles-ink/70">{totals.quantity} {totals.quantity === 1 ? "item" : "items"} ready to review.</p>
      </div>
      <a class="font-black text-eagles-green hover:text-eagles-ink" href="/portal/shop/">← Continue shopping</a>
    </header>

    {cart.items.length === 0 ? (
      <EmptyState title="Your cart is empty" text="Browse the club store and add merchandise before checking out." href="/portal/shop/" action="Continue shopping" />
    ) : (
      <div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_minmax(0,20rem)]">
        <section class="grid gap-4" aria-label="Cart items">
          {cart.items.map((item) => {
            const image = getPublicMediaUrl(item.image_object_key, Astro) ?? getSafeExternalImageUrl(item.image_url);
            return (
              <article class="surface grid gap-4 p-4 sm:grid-cols-[140px_1fr] sm:p-5">
                {image
                  ? <img src={image} alt={item.product_name} class="aspect-square w-full object-cover" width="280" height="280" loading="lazy" style="border-radius:8px" />
                  : <div class="flex aspect-square items-center justify-center bg-eagles-mist p-3 text-center font-display text-xl font-black uppercase text-eagles-ink/35" role="img" aria-label={`${item.product_name} image unavailable`}>Eagles</div>}
                <div>
                  <p class="eyebrow">{item.category}</p>
                  <div class="mt-2 flex flex-col gap-2 md:flex-row md:items-start md:justify-between">
                    <div>
                      <h2 class="card-title text-eagles-ink">{item.product_name}</h2>
                      <p class="mt-2 text-sm font-bold text-eagles-ink/65">{item.variant_label ?? "Standard option"}</p>
                    </div>
                    <p class="text-lg font-black text-eagles-green">{formatMoney(item.unit_price_cents * item.quantity)}</p>
                  </div>
                  <p class="mt-2 text-sm text-eagles-ink/65">{formatMoney(item.unit_price_cents)} each</p>

                  {!item.is_available && (
                    <p class="mt-4 border border-red-200 bg-red-50 p-3 text-sm font-bold text-red-700" style="border-radius:8px" role="alert">
                      {item.availability_message ?? "This item needs attention before checkout."}
                    </p>
                  )}

                  <div class="mt-5 flex flex-wrap items-end gap-2">
                    <form method="post" action="/api/portal/merchandise-cart">
                      <input type="hidden" name="action" value="adjust" />
                      <input type="hidden" name="variant_id" value={item.variant_id} />
                      <input type="hidden" name="quantity" value="-1" />
                      <input type="hidden" name="return_to" value="/portal/shop/cart/" />
                      <button class="flex min-h-11 min-w-11 items-center justify-center border border-eagles-line bg-white text-xl font-black hover:border-eagles-green" style="border-radius:8px" type="submit" aria-label={`Decrease ${item.product_name} quantity`}>−</button>
                    </form>
                    <form class="flex items-end gap-2" method="post" action="/api/portal/merchandise-cart">
                      <input type="hidden" name="action" value="set" />
                      <input type="hidden" name="variant_id" value={item.variant_id} />
                      <input type="hidden" name="return_to" value="/portal/shop/cart/" />
                      <label>
                        <span class="label">Quantity</span>
                        <input class="field w-24" name="quantity" type="number" inputmode="numeric" min="0" max="50" value={item.quantity} aria-label={`${item.product_name} quantity`} />
                      </label>
                      <button class="min-h-11 bg-eagles-ink px-4 py-2 text-sm font-black text-white hover:bg-eagles-green" style="border-radius:8px" type="submit">Update</button>
                    </form>
                    <form method="post" action="/api/portal/merchandise-cart">
                      <input type="hidden" name="action" value="adjust" />
                      <input type="hidden" name="variant_id" value={item.variant_id} />
                      <input type="hidden" name="quantity" value="1" />
                      <input type="hidden" name="return_to" value="/portal/shop/cart/" />
                      <button class="flex min-h-11 min-w-11 items-center justify-center border border-eagles-line bg-white text-xl font-black hover:border-eagles-green" style="border-radius:8px" type="submit" aria-label={`Increase ${item.product_name} quantity`}>+</button>
                    </form>
                    <form class="ml-auto" method="post" action="/api/portal/merchandise-cart">
                      <input type="hidden" name="action" value="remove" />
                      <input type="hidden" name="variant_id" value={item.variant_id} />
                      <input type="hidden" name="quantity" value="0" />
                      <input type="hidden" name="return_to" value="/portal/shop/cart/" />
                      <button class="min-h-11 px-3 py-2 text-sm font-black text-red-700 hover:bg-red-50" style="border-radius:8px" type="submit">Remove</button>
                    </form>
                  </div>
                </div>
              </article>
            );
          })}
        </section>

        <aside class="surface h-fit p-5 xl:sticky xl:top-24">
          <h2 class="panel-title text-eagles-ink">Order summary</h2>
          <dl class="mt-5 grid gap-3">
            <div class="flex justify-between gap-4"><dt>Items</dt><dd class="font-bold">{totals.quantity}</dd></div>
            <div class="flex justify-between gap-4 border-t border-eagles-line pt-3 text-lg"><dt class="font-black">Total</dt><dd class="font-black">{formatMoney(totals.totalCents)}</dd></div>
          </dl>
          <p class="mt-4 text-sm leading-6 text-eagles-ink/65">Collection is from the club. Product prices and stock are checked again when you place the order.</p>
          {totals.canCheckout
            ? <a class="mt-5 flex min-h-12 items-center justify-center bg-eagles-green px-5 py-3 font-black text-white hover:bg-eagles-ink" style="border-radius:8px" href="/portal/shop/checkout/">Proceed to checkout</a>
            : <p class="mt-5 border border-amber-200 bg-amber-50 p-3 text-sm font-bold text-amber-900" style="border-radius:8px">Update or remove unavailable items before checkout.</p>}
          <a class="mt-3 flex min-h-11 items-center justify-center font-black text-eagles-green" href="/portal/shop/">Continue shopping</a>
          <form class="mt-3 border-t border-eagles-line pt-3" method="post" action="/api/portal/merchandise-cart">
            <input type="hidden" name="action" value="clear" />
            <input type="hidden" name="return_to" value="/portal/shop/cart/" />
            <button class="w-full min-h-11 text-sm font-black text-red-700 hover:bg-red-50" style="border-radius:8px" type="submit">Clear cart</button>
          </form>
        </aside>
      </div>
    )}
  </div>
</PortalLayout>
