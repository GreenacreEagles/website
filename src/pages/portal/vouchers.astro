---
import PortalLayout from "@layouts/PortalLayout.astro";
import StatusBadge from "@components/StatusBadge.astro";
import { requireUser } from "@lib/auth/guards";
import { formatDate, formatDateTime, formatMoney, statusLabel } from "@lib/format";
import QRCode from "qrcode";

export const prerender = false;

const session = await requireUser(Astro);
if (!session) return Astro.redirect("/login/");

const success = Astro.url.searchParams.get("success");
const error = Astro.url.searchParams.get("error");

const hashToken = async (token: string) => {
  const bytes = new TextEncoder().encode(token);
  const digest = await crypto.subtle.digest("SHA-256", bytes);
  return Array.from(new Uint8Array(digest))
    .map((byte) => byte.toString(16).padStart(2, "0"))
    .join("");
};

const [{ data: vouchers }, { data: wallets }, { data: ledger }, { data: payments }, {data:eventTickets}] = await Promise.all([
  session.supabase.from("voucher_issuances").select("id,redemption_code,voucher_type,status,original_value_cents,remaining_value_cents,valid_from,expires_at,issue_reason,canteen_venue,teams(name)").eq("beneficiary_id", session.user.id).order("created_at", { ascending: false }).limit(30),
  session.supabase.from("wallet_accounts").select("id,account_type,status,wallet_balances(balance_cents)").eq("owner_id", session.user.id).limit(10),
  session.supabase.from("wallet_ledger_entries").select("id,amount_cents,direction,transaction_type,description,created_at,wallet_accounts!inner(owner_id)").eq("wallet_accounts.owner_id", session.user.id).order("created_at", { ascending: false }).limit(20),
  session.supabase.from("payments" as any).select("id,provider,amount_cents,status,created_at,updated_at,metadata").eq("payer_id", session.user.id).eq("metadata->>purpose", "wallet_top_up").order("created_at", { ascending: false }).limit(10),
  (session.supabase as any).from("club_event_tickets").select("id,ticket_code,status,issued_at,redeemed_at,club_events(title,starts_at,venue),club_event_ticket_types(name)").eq("owner_user_id",session.user.id).order("issued_at",{ascending:false})
]);
const eventTicketCards=await Promise.all((eventTickets??[]).map(async(ticket:any)=>({...ticket,qrCode:ticket.status==="valid"?await QRCode.toDataURL(`GETICKET:${ticket.ticket_code}`,{margin:1,width:220,color:{dark:"#111111",light:"#ffffff"}}):null})));

const voucherCards = await Promise.all(
  (vouchers ?? []).map(async (voucher: any) => ({
    ...voucher,
    qrCode:
      voucher.redemption_code && voucher.status === "active" && voucher.remaining_value_cents > 0
        ? await QRCode.toDataURL(`GEVOUCHER:${voucher.redemption_code}`, { margin: 1, width: 220, color: { dark: "#111111", light: "#ffffff" } })
        : null
  }))
);

const walletCards = await Promise.all(
  ((wallets ?? []) as any[]).map(async (wallet) => {
    let { data: qrToken } = await (session.supabase as any)
      .from("wallet_qr_tokens")
      .select("display_code")
      .eq("wallet_account_id", wallet.id)
      .eq("status", "active")
      .maybeSingle();

    if (!qrToken) {
      const displayCode = `W${crypto.randomUUID().replaceAll("-", "").slice(0, 11).toUpperCase()}`;
      const tokenHash = await hashToken(displayCode);
      const { data: inserted } = await (session.supabase as any)
        .from("wallet_qr_tokens")
        .insert({ wallet_account_id: wallet.id, display_code: displayCode, token_hash: tokenHash })
        .select("display_code")
        .maybeSingle();
      qrToken = inserted;
    }

    return {
      ...wallet,
      displayCode: qrToken?.display_code ?? null,
      qrCode: qrToken?.display_code
        ? await QRCode.toDataURL(`GEWALLET:${qrToken.display_code}`, { margin: 1, width: 220, color: { dark: "#111111", light: "#ffffff" } })
        : null
    };
  })
);
---

<PortalLayout title="Wallet and vouchers" section="Payments" session={session}>
  <div class="grid gap-6 xl:grid-cols-[360px_1fr]">
    <aside class="grid gap-5 content-start">
      {success && <p class="border border-eagles-green bg-green-50 p-4 text-sm font-bold text-eagles-green" style="border-radius:8px">{success}</p>}
      {error && <p class="border border-red-200 bg-red-50 p-4 text-sm font-bold text-red-700" style="border-radius:8px">{error}</p>}
      {walletCards.map((wallet: any) => (
        <article class="surface p-5">
          <p class="eyebrow">{statusLabel(wallet.account_type)}</p>
          <p class="mt-2 text-4xl font-black text-eagles-green">{formatMoney(wallet.wallet_balances?.[0]?.balance_cents ?? 0)}</p>
          <p class="mt-2 text-sm text-eagles-ink/70">{statusLabel(wallet.status)}</p>
          {wallet.qrCode && (
            <details class="mt-4 border-t border-eagles-line pt-4">
              <summary class="focus-ring inline-flex min-h-11 cursor-pointer items-center rounded-full bg-eagles-green px-5 py-3 text-sm font-black text-white">Show wallet QR code</summary>
              <div class="mt-4">
                <img class="h-[min(220px,70vw)] w-[min(220px,70vw)] max-w-full border border-eagles-line bg-white p-2" style="border-radius:8px" src={wallet.qrCode} alt="Wallet QR code" loading="lazy" />
                <p class="mt-3 text-sm font-bold text-eagles-ink/70">Present this QR code at the club or canteen for an authorised wallet payment.</p>
              </div>
            </details>
          )}
        </article>
      ))}
      {(wallets ?? []).length === 0 && <article class="surface p-5"><h2 class="card-title">Wallet unavailable</h2><p class="mt-3 text-sm leading-6 text-eagles-ink/70">Your member wallet is created automatically with your account. Please contact the club if it is not visible here.</p></article>}
      {(wallets ?? []).length > 0 && (
        <form class="surface grid gap-4 p-5" method="post" action="/api/portal/wallet-top-up">
          <input type="hidden" name="return_to" value="/portal/vouchers/" />
          <h2 class="card-title">Top up wallet</h2>
          <label><span class="label">Wallet</span><select class="field" name="wallet_id">{(wallets ?? []).map((wallet: any) => <option value={wallet.id}>{statusLabel(wallet.account_type)} - {formatMoney(wallet.wallet_balances?.[0]?.balance_cents ?? 0)}</option>)}</select></label>
          <label><span class="label">Amount</span><input class="field" name="amount" type="number" min="1" max="1000" step="0.01" placeholder="25.00" required /></label>
          <label><span class="label">Payment method</span><select class="field" name="provider"><option value="manual">Manual settlement</option></select></label>
          <button class="bg-eagles-green px-4 py-3 text-sm font-black text-white" style="border-radius:8px" type="submit">Request top-up</button>
        </form>
      )}
      <article class="surface p-5">
        <h2 class="card-title">Top-up requests</h2>
        <div class="mt-4 grid gap-3">
          {(payments ?? []).length === 0 && <p class="text-sm leading-6 text-eagles-ink/70">Top-up requests will appear here.</p>}
          {(payments ?? []).map((payment: any) => (
            <p class="border-t border-eagles-line pt-3 text-sm">
              <strong>{formatMoney(payment.amount_cents)}</strong> - {statusLabel(payment.status)}<br />
              {payment.provider} - {formatDateTime(payment.updated_at ?? payment.created_at)}
            </p>
          ))}
        </div>
      </article>
    </aside>
    <section class="grid gap-5">
      <article class="surface p-4 sm:p-5 md:p-6">
        <h2 class="panel-title">Event tickets</h2>
        <div class="mt-5 grid gap-4">
          {eventTicketCards.length===0&&<p class="text-sm leading-6 text-eagles-ink/70">Your event tickets will appear here after a successful claim or purchase.</p>}
          {eventTicketCards.map((ticket:any)=><article class="border border-eagles-line p-4" style="border-radius:8px">
            <div class="flex flex-wrap justify-between gap-3"><div><p class="font-black">{ticket.club_events?.title??"Event ticket"}</p><p class="text-sm text-eagles-ink/70">{ticket.club_event_ticket_types?.name} · {formatDateTime(ticket.club_events?.starts_at)}</p><p class="text-sm">{ticket.club_events?.venue??"Venue TBC"}</p></div><StatusBadge label={statusLabel(ticket.status)} tone={ticket.status==="valid"?"green":"amber"}/></div>
            {ticket.qrCode&&<div class="mt-4 grid gap-4 border-t border-eagles-line pt-4 md:grid-cols-[220px_1fr] md:items-center"><img class="h-[min(220px,70vw)] w-[min(220px,70vw)] max-w-full border border-eagles-line bg-white p-2" src={ticket.qrCode} alt={`Entry QR code for ${ticket.club_events?.title??"event ticket"}`}/><div><p class="font-bold">Show this QR code to authorised event staff at entry.</p><p class="mt-3 inline-flex bg-eagles-mist px-3 py-2 font-mono text-lg font-black tracking-[.16em]">{ticket.ticket_code}</p></div></div>}
            {ticket.redeemed_at&&<p class="mt-3 text-sm">Redeemed {formatDateTime(ticket.redeemed_at)}</p>}
          </article>)}
        </div>
      </article>
      <article class="surface p-4 sm:p-5 md:p-6">
        <h2 class="panel-title">Vouchers</h2>
        <div class="mt-5 grid gap-3">
          {voucherCards.length === 0 && <p class="text-sm leading-6 text-eagles-ink/70">No active vouchers are linked to your account.</p>}
          {voucherCards.map((voucher: any) => (
            <div class="border border-eagles-line bg-white p-4" style="border-radius:8px">
              <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
                <div>
                  <p class="font-black">{statusLabel(voucher.voucher_type)}</p>
                  <p class="mt-1 text-sm text-eagles-ink/70">{voucher.issue_reason ?? "Club-issued canteen voucher"}</p>
                  <p class="mt-1 text-sm text-eagles-ink/70">Use at the club canteen</p>
                  <p class="mt-1 text-xs text-eagles-ink/60">Valid {formatDate(voucher.valid_from)} to {formatDate(voucher.expires_at)}</p>
                </div>
                <div class="md:text-right">
                  <p class="text-2xl font-black text-eagles-green">{formatMoney(voucher.remaining_value_cents)}</p>
                  <StatusBadge label={statusLabel(voucher.status)} tone={voucher.status === "active" ? "green" : "amber"} />
                </div>
              </div>
              {voucher.qrCode && (
                <div class="mt-4 grid gap-4 border-t border-eagles-line pt-4 md:grid-cols-[220px_1fr] md:items-center">
                  <img class="h-[min(220px,70vw)] w-[min(220px,70vw)] max-w-full border border-eagles-line bg-white p-2" style="border-radius:8px" src={voucher.qrCode} alt={`QR code for ${statusLabel(voucher.voucher_type)} voucher`} />
                  <div>
                    <p class="text-sm font-bold text-eagles-ink/70">Show this QR code at the canteen. Staff scan it or enter the code below to claim the voucher.</p>
                    <p class="mt-3 inline-flex bg-eagles-mist px-3 py-2 font-mono text-lg font-black tracking-[.16em] text-eagles-ink" style="border-radius:8px">{voucher.redemption_code}</p>
                  </div>
                </div>
              )}
              {!voucher.qrCode && voucher.status === "active" && (
                <p class="mt-4 border-t border-eagles-line pt-4 text-sm font-bold text-eagles-ink/70">This voucher was issued before wallet QR codes were enabled. Ask the canteen manager to reissue it if you need a scannable code.</p>
              )}
            </div>
          ))}
        </div>
      </article>
      <article class="surface p-4 sm:p-5 md:p-6">
        <h2 class="panel-title">Wallet activity</h2>
        <div class="mt-5 grid gap-3">
          {(ledger ?? []).length === 0 && <p class="text-sm leading-6 text-eagles-ink/70">Wallet activity will appear here.</p>}
          {(ledger ?? []).map((entry) => (
            <div class="border-t border-eagles-line pt-3">
              <p class="font-black">{statusLabel(entry.transaction_type)} - {formatMoney(entry.amount_cents)}</p>
              <p class="text-sm text-eagles-ink/70">{entry.description ?? statusLabel(entry.direction)} - {formatDateTime(entry.created_at)}</p>
            </div>
          ))}
        </div>
      </article>
    </section>
  </div>
</PortalLayout>
