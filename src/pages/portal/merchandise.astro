---
import EmptyState from "@components/EmptyState.astro";
import PortalLayout from "@layouts/PortalLayout.astro";
import StatusBadge from "@components/StatusBadge.astro";
import { requireUser } from "@lib/auth/guards";
import { formatDateTime,formatMoney,statusLabel } from "@lib/format";
import { getPublicMediaUrl } from "@lib/media";
import { createSupabaseServiceClient } from "@lib/supabase/server";
export const prerender=false;
const session=await requireUser(Astro);if(!session)return Astro.redirect("/login/");if(session.isChildAccount)return Astro.redirect("/portal/teams/");
const [{data:products},{data:orders}]=await Promise.all([
 (createSupabaseServiceClient(Astro) as any).from("merchandise_products").select("id,name,description,category,status,featured,image_url,image_object_key,merchandise_variants(id,size,colour,price_cents,sale_price_cents,stock_quantity,is_active)").eq("status","active").order("featured",{ascending:false}).order("sort_order").limit(80),
 (session.supabase as any).from("merchandise_orders").select("id,order_number,status,total_cents,pickup_or_delivery,created_at").eq("customer_id",session.user.id).order("created_at",{ascending:false}).limit(20)
]);
---
<PortalLayout title="Merchandise" section="Club merchandise" session={session}>
 <div class="grid gap-6 xl:grid-cols-[1fr_360px]"><section class="grid gap-4 md:grid-cols-2">
  {Astro.url.searchParams.get("success")&&<p class="border border-eagles-green bg-green-50 p-4 font-bold text-eagles-green md:col-span-2">{Astro.url.searchParams.get("success")}</p>}
  {Astro.url.searchParams.get("error")&&<p class="border border-red-200 bg-red-50 p-4 font-bold text-red-700 md:col-span-2">{Astro.url.searchParams.get("error")}</p>}
  {(products??[]).length===0&&<EmptyState title="Club merchandise coming soon" text="Kit, training gear and supporter items will appear here when available."/>}
  {(products??[]).map((p:any)=>{const variants=(p.merchandise_variants??[]).filter((v:any)=>v.is_active&&v.stock_quantity>0);const image=getPublicMediaUrl(p.image_object_key,Astro)??p.image_url;return <article class="surface overflow-hidden">{image&&<img src={image} alt={`${p.name} product`} class="h-52 w-full object-cover" loading="lazy"/>}<div class="p-5"><p class="eyebrow">{p.category??"Club merchandise"}</p><h2 class="mt-2 font-display text-2xl font-black uppercase">{p.name}</h2><p class="mt-3 text-sm text-eagles-ink/70">{p.description}</p>{variants.length>0?<form class="mt-5 grid gap-3" method="post" action="/api/portal/merchandise-order/"><label><span class="label">Option</span><select class="field" name="variant_id" required>{variants.map((v:any)=><option value={v.id}>{[v.size,v.colour].filter(Boolean).join(" / ")||p.name} · {formatMoney(v.sale_price_cents??v.price_cents)} · {v.stock_quantity} left</option>)}</select></label><label><span class="label">Quantity</span><input class="field" name="quantity" type="number" min="1" max="10" value="1"/></label><label><span class="label">Collection</span><select class="field" name="pickup_or_delivery"><option value="pickup">Pickup</option><option value="delivery">Delivery</option></select></label><label><span class="label">Notes</span><input class="field" name="notes"/></label><button class="bg-eagles-green px-4 py-3 font-black text-white" type="submit">Place merchandise order</button></form>:<p class="mt-4 font-bold">Currently out of stock.</p>}</div></article>})}
 </section><aside class="surface p-5"><h2 class="font-display text-2xl font-black uppercase">My merchandise orders</h2><div class="mt-4 grid gap-3">{(orders??[]).length===0&&<p class="text-sm">Your merchandise orders will appear here.</p>}{(orders??[]).map((o:any)=><article class="border-t border-eagles-line pt-3"><p class="font-black">{o.order_number}</p><p class="text-sm">{formatMoney(o.total_cents)} · {formatDateTime(o.created_at)}</p><StatusBadge label={statusLabel(o.status)} tone={["completed","collected"].includes(o.status)?"green":"amber"}/></article>)}</div></aside></div>
</PortalLayout>
