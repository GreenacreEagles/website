---
import PortalLayout from"@layouts/PortalLayout.astro";import StatusBadge from"@components/StatusBadge.astro";import{requireUser}from"@lib/auth/guards";import{formatMoney}from"@lib/format";import{getPublicMediaUrl}from"@lib/media";
export const prerender=false;const session=await requireUser(Astro);if(!session)return Astro.redirect(`/login/?returnTo=${encodeURIComponent(Astro.url.pathname+Astro.url.search)}`);const selected=["canteen","merchandise"].includes(Astro.url.searchParams.get("category")??"")?Astro.url.searchParams.get("category")!:"all";const now=new Date().toISOString();
const[{data:canteen},{data:merch},{data:cart}]=await Promise.all([(session.supabase as any).from("canteen_products").select("id,name,description,price_cents,stock_quantity,max_quantity_per_order,image_object_key,canteen_categories(name)").eq("is_active",true).eq("is_sold_out",false).or(`available_from.is.null,available_from.lte.${now}`).or(`available_until.is.null,available_until.gt.${now}`).order("sort_order"),(session.supabase as any).from("merchandise_products").select("id,name,description,category,image_object_key,image_url,merchandise_variants(id,size,colour,price_cents,sale_price_cents,stock_quantity,is_active)").eq("status","active").or(`available_from.is.null,available_from.lte.${now}`).or(`available_until.is.null,available_until.gt.${now}`).order("sort_order"),(session.supabase as any).from("shop_cart_items").select("id,product_type,canteen_product_id,merchandise_variant_id,quantity,canteen_products(name,price_cents),merchandise_variants(size,colour,price_cents,sale_price_cents,merchandise_products(name))").eq("user_id",session.user.id).order("created_at")]);
const products:any[]=[];if(selected!=="merchandise")for(const p of canteen??[])products.push({type:"canteen",id:p.id,name:p.name,description:p.description,image:getPublicMediaUrl(p.image_object_key,Astro),category:p.canteen_categories?.name??"Canteen",price:p.price_cents,stock:p.stock_quantity,max:p.max_quantity_per_order??20});
if(selected!=="canteen")for(const p of merch??[])for(const v of(p.merchandise_variants??[]).filter((x:any)=>x.is_active))products.push({type:"merchandise",id:v.id,name:p.name,description:p.description,image:getPublicMediaUrl(p.image_object_key,Astro)??p.image_url,category:"Club merchandise",variant:[v.size,v.colour].filter(Boolean).join(" / "),price:v.sale_price_cents??v.price_cents,stock:v.stock_quantity,max:Math.min(v.stock_quantity,10)});
const cartTotal=(cart??[]).reduce((sum:number,item:any)=>sum+item.quantity*(item.product_type==="canteen"?item.canteen_products?.price_cents??0:item.merchandise_variants?.sale_price_cents??item.merchandise_variants?.price_cents??0),0);
---
<PortalLayout title="Shop" section="Club shop" session={session}><div class="grid gap-6 xl:grid-cols-[1fr_360px]"><section><h1 class="font-display text-5xl font-black uppercase">Club shop</h1><nav class="mt-5 flex flex-wrap gap-2" aria-label="Shop categories">{[["all","All"],["canteen","Canteen"],["merchandise","Club merchandise"]].map(([value,label])=><a class:list={["focus-ring px-4 py-3 font-black",selected===value?"bg-eagles-green text-white":"border border-eagles-line bg-white"]} style="border-radius:8px" href={value==="all"?"/portal/shop/":`/portal/shop/?category=${value}`}>{label}</a>)}</nav>
{Astro.url.searchParams.get("success")&&<p class="mt-5 border border-eagles-green bg-green-50 p-4 font-bold text-eagles-green">{Astro.url.searchParams.get("success")}</p>}{Astro.url.searchParams.get("error")&&<p class="mt-5 border border-red-200 bg-red-50 p-4 font-bold text-red-700">{Astro.url.searchParams.get("error")}</p>}
<div class="mt-6 grid gap-5 md:grid-cols-2">{products.length===0?<p class="surface p-5 md:col-span-2">There are no active products available in this category at the moment.</p>:products.map(p=><article class="surface overflow-hidden"><img src={p.image??"/media/placeholders/matchday-card.svg"} alt={p.image?`${p.name} product`:""} class="h-48 w-full object-cover"/><div class="p-5"><p class="eyebrow">{p.category}</p><h2 class="mt-2 font-display text-2xl font-black uppercase">{p.name}</h2>{p.variant&&<p class="mt-1 font-bold">{p.variant}</p>}{p.description&&<p class="mt-3 text-sm text-eagles-ink/70">{p.description}</p>}<div class="mt-4 flex justify-between"><p class="text-2xl font-black text-eagles-green">{formatMoney(p.price)}</p><StatusBadge label={p.stock==null?"Available":p.stock>0?`${p.stock} available`:"Out of stock"} tone={p.stock===0?"amber":"green"}/></div>{p.stock!==0&&<form class="mt-4 flex gap-3" method="post" action="/api/portal/shop-cart/"><input type="hidden" name="product_type" value={p.type}/><input type="hidden" name="product_id" value={p.id}/><input type="hidden" name="return_to" value={Astro.url.pathname+Astro.url.search}/><label><span class="label">Quantity</span><input class="field w-24" name="quantity" type="number" min="1" max={p.max} value="1"/></label><button class="self-end bg-eagles-green px-4 py-3 font-black text-white" style="border-radius:8px">Add to cart</button></form>}</div></article>)}</div></section>
<aside class="surface h-fit p-5"><h2 class="font-display text-3xl font-black uppercase">Your cart</h2><div class="mt-4 grid gap-3">{(cart??[]).length===0?<p>Your cart is empty.</p>:(cart??[]).map((item:any)=>{const name=item.product_type==="canteen"?item.canteen_products?.name:item.merchandise_variants?.merchandise_products?.name;const price=item.product_type==="canteen"?item.canteen_products?.price_cents:item.merchandise_variants?.sale_price_cents??item.merchandise_variants?.price_cents;return <form class="border-t border-eagles-line pt-3" method="post" action="/api/portal/shop-cart-update/"><input type="hidden" name="id" value={item.id}/><p class="font-black">{name}</p><p class="text-sm">{formatMoney(price??0)} each</p><div class="mt-2 flex gap-2"><label><span class="sr-only">Quantity for {name}</span><input class="field w-20" name="quantity" type="number" min="0" max="50" value={item.quantity}/></label><button class="font-black text-eagles-green">Update</button></div></form>})}</div>{(cart??[]).length>0&&<><p class="mt-5 border-t border-eagles-line pt-4 text-2xl font-black">Total {formatMoney(cartTotal)}</p><p class="mt-2 text-sm text-eagles-ink/65">Club collection. Canteen and merchandise items will show separate fulfilment updates.</p><form class="mt-4" method="post" action="/api/portal/shop-checkout/"><button class="w-full bg-eagles-green px-4 py-3 font-black text-white" style="border-radius:8px">Checkout</button></form></>}</aside></div></PortalLayout>
