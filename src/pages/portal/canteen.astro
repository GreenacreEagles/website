---
import EmptyState from "@components/EmptyState.astro";
import PortalLayout from "@layouts/PortalLayout.astro";
import StatusBadge from "@components/StatusBadge.astro";
import { requireUser } from "@lib/auth/guards";
import { formatDateTime, formatMoney, statusLabel } from "@lib/format";
import { createSupabaseServiceClient } from "@lib/supabase/server";
export const prerender=false;
const session=await requireUser(Astro);if(!session)return Astro.redirect("/login/");if(session.isChildAccount)return Astro.redirect("/portal/vouchers/");
const [{data:venues},{data:products},{data:orders},{data:familyMembers}]=await Promise.all([
 session.supabase.from("canteen_venues").select("id,name,is_active").eq("is_active",true).order("name"),
 (createSupabaseServiceClient(Astro) as any).from("canteen_products").select("id,name,description,price_cents,fulfilment_type,stock_quantity,low_stock_threshold,max_quantity_per_order,dietary_info,allergen_info,canteen_categories(name)").eq("is_active",true).eq("is_sold_out",false).order("sort_order").order("name").limit(80),
 session.supabase.from("canteen_orders" as any).select("id,order_number,order_status,payment_status,total_cents,pickup_code,pickup_window_start,created_at").or(`customer_id.eq.${session.user.id},recipient_id.eq.${session.user.id}`).order("created_at",{ascending:false}).limit(20),
 session.supabase.from("family_members").select("user_id,profiles:user_id(full_name,preferred_name,email)").in("relationship",["child","player","dependent"]).eq("status","active").limit(50)
]);
const beneficiaries=[{user_id:session.user.id,label:"Me"},...(familyMembers??[]).map((m:any)=>({user_id:m.user_id,label:m.profiles?.preferred_name||m.profiles?.full_name||m.profiles?.email||"Family member"}))];
---
<PortalLayout title="Canteen" section="Match day" session={session}>
 <div class="grid gap-6 xl:grid-cols-[1fr_360px]"><section class="grid gap-4">
  {Astro.url.searchParams.get("success")&&<p class="border border-eagles-green bg-green-50 p-4 font-bold text-eagles-green">{Astro.url.searchParams.get("success")}</p>}
  {Astro.url.searchParams.get("error")&&<p class="border border-red-200 bg-red-50 p-4 font-bold text-red-700">{Astro.url.searchParams.get("error")}</p>}
  {(products??[]).length===0&&<EmptyState title="Canteen menu coming soon" text="Food, drinks and match-day items will appear here when available."/>}
  {(products??[]).map((p:any)=><article class="surface p-5"><div class="flex justify-between gap-4"><div><p class="eyebrow">{p.canteen_categories?.name??"Canteen"}</p><h2 class="mt-2 font-display text-3xl font-black uppercase">{p.name}</h2><p class="mt-3 text-sm text-eagles-ink/70">{p.description}</p><div class="mt-3 flex gap-2"><StatusBadge label={p.fulfilment_type==="item_voucher"?"Wallet voucher":"Pickup order"} tone="green"/>{p.stock_quantity!=null&&<StatusBadge label={`${p.stock_quantity} left`} tone={p.stock_quantity<=p.low_stock_threshold?"amber":"ink"}/>}</div></div><p class="text-2xl font-black text-eagles-green">{formatMoney(p.price_cents)}</p></div>
   <form class="mt-5 grid gap-3 md:grid-cols-2" method="post" action="/api/portal/canteen-order/"><input type="hidden" name="product_id" value={p.id}/><label><span class="label">Pickup venue</span><select class="field" name="venue_id"><option value="">Select on pickup</option>{(venues??[]).map(v=><option value={v.id}>{v.name}</option>)}</select></label><label><span class="label">For</span><select class="field" name="beneficiary_id">{beneficiaries.map(person=><option value={person.user_id}>{person.label}</option>)}</select></label><label><span class="label">Quantity</span><input class="field" name="quantity" type="number" min="1" max={p.max_quantity_per_order??20} value="1"/></label><label><span class="label">Pickup time</span><input class="field" name="pickup_window_start" type="datetime-local"/></label><label class="md:col-span-2"><span class="label">Notes</span><input class="field" name="special_instructions"/></label><button class="bg-eagles-green px-4 py-3 font-black text-white md:col-span-2" type="submit">{p.fulfilment_type==="item_voucher"?"Buy voucher":"Order pickup"}</button></form></article>)}
 </section><aside class="surface p-5"><h2 class="font-display text-2xl font-black uppercase">My canteen orders</h2><div class="mt-4 grid gap-3">{(orders??[]).length===0&&<p class="text-sm">Your canteen orders will appear here.</p>}{(orders??[]).map((o:any)=><article class="border-t border-eagles-line pt-3"><p class="font-black">{o.order_number}</p><p class="text-sm">{formatMoney(o.total_cents)} · {formatDateTime(o.pickup_window_start??o.created_at)}</p>{o.pickup_code&&<p class="mt-2 font-mono font-black">{o.pickup_code}</p>}<div class="mt-2 flex gap-2"><StatusBadge label={statusLabel(o.order_status)} tone="green"/><StatusBadge label={statusLabel(o.payment_status)} tone="ink"/></div></article>)}</div></aside></div>
</PortalLayout>
