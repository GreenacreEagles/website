---
import EmptyState from "@components/EmptyState.astro";
import PortalFeedback from "@components/PortalFeedback.astro";
import StatusBadge from "@components/StatusBadge.astro";
import PortalLayout from "@layouts/PortalLayout.astro";
import { requireUser } from "@lib/auth/guards";
import { formatDateTime, formatMoney } from "@lib/format";
import { canteenOrderLabel, canteenPaymentLabel } from "@lib/canteen-store";
export const prerender=false;
const session=await requireUser(Astro);if(!session)return Astro.redirect(`/login/?returnTo=${encodeURIComponent("/portal/canteen/")}`);if(session.isChildAccount)return Astro.redirect("/portal/vouchers/");
const [{data:orders,error:orderError},{data:wallets},{count:voucherCount}]=await Promise.all([
 (session.supabase as any).from("canteen_orders").select("id,order_number,order_status,payment_status,subtotal_cents,amount_due_cents,created_at,canteen_order_items(product_name_snapshot,quantity)").eq("customer_id",session.user.id).order("created_at",{ascending:false}).limit(30),
 (session.supabase as any).rpc("get_canteen_checkout_wallets"),
 (session.supabase as any).from("voucher_issuances").select("id",{count:"exact",head:true}).eq("beneficiary_id",session.user.id).eq("status","active").eq("voucher_type","specific_product")
]);
const activeSet=new Set(["awaiting_payment","paid","accepted","preparing","ready_for_pickup"]);const active=(orders??[]).filter((o:any)=>activeSet.has(o.order_status));const past=(orders??[]).filter((o:any)=>!activeSet.has(o.order_status));const balance=(wallets??[]).reduce((n:number,w:any)=>n+w.balance_cents,0);const tone=(s:string)=>s==="cancelled"||s==="refunded"?"red":s==="ready_for_pickup"||s==="collected"?"green":"amber";
---
<PortalLayout title="Canteen" section="Club canteen" session={session}><div class="grid gap-6"><PortalFeedback success={Astro.url.searchParams.get("success")} error={Astro.url.searchParams.get("error")??orderError?.message}/><header class="surface flex flex-col gap-5 p-6 md:flex-row md:items-center md:justify-between md:p-8"><div><p class="eyebrow">Greenacre Eagles</p><h1 class="mt-2 font-display text-4xl font-black uppercase leading-none md:text-6xl">Canteen</h1><p class="mt-3 max-w-2xl leading-7 text-eagles-ink/70">View your canteen orders, collection details and available benefits.</p></div><a class="inline-flex min-h-12 items-center justify-center bg-eagles-green px-6 py-3 font-black text-white" style="border-radius:8px" href="/portal/canteen/shop/">Go to canteen shop</a></header><section class="grid gap-3 sm:grid-cols-2"><article class="surface p-5"><p class="eyebrow">Canteen credit</p><p class="mt-2 font-display text-4xl font-black text-eagles-green">{formatMoney(balance)}</p><p class="mt-2 text-sm text-eagles-ink/65">Applied after item vouchers at checkout.</p></article><article class="surface p-5"><p class="eyebrow">Item vouchers</p><p class="mt-2 font-display text-4xl font-black text-eagles-green">{voucherCount??0}</p><p class="mt-2 text-sm text-eagles-ink/65">Eligible vouchers appear with matching cart items.</p></article></section>{(orders??[]).length===0?<EmptyState title="You have not placed any canteen orders yet" text="Visit the canteen shop to browse available food and drinks." href="/portal/canteen/shop/" action="Go to canteen shop"/>:<>{[["Active orders",active],["Past orders",past]].map(([heading,list]:any)=>list.length>0&&<section class="surface p-5 md:p-7"><h2 class="font-display text-3xl font-black uppercase">{heading}</h2><div class="mt-5 grid gap-4">{list.map((o:any)=><article class="border border-eagles-line p-4" style="border-radius:8px"><div class="flex flex-wrap items-start justify-between gap-3"><div><h3 class="text-lg font-black">Order {o.order_number}</h3><p class="text-sm text-eagles-ink/65">{formatDateTime(o.created_at)} · {formatMoney(o.amount_due_cents)} due</p></div><div class="flex flex-wrap gap-2"><StatusBadge label={canteenOrderLabel(o.order_status)} tone={tone(o.order_status)}/><StatusBadge label={canteenPaymentLabel(o.payment_status)} tone={o.payment_status==="paid"?"green":"amber"}/></div></div><div class="mt-3 grid gap-1">{(o.canteen_order_items??[]).map((i:any)=><p class="text-sm"><strong>{i.quantity}×</strong> {i.product_name_snapshot}</p>)}</div><a class="mt-4 inline-flex font-black text-eagles-green" href={`/portal/canteen/orders/${o.id}/`}>View order</a></article>)}</div></section>)}</>}</div></PortalLayout>