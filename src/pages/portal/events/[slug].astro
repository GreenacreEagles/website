---
import PortalLayout from "@layouts/PortalLayout.astro";
import StatusBadge from "@components/StatusBadge.astro";
import { requireUser } from "@lib/auth/guards";
import { formatDateTime,formatMoney,statusLabel } from "@lib/format";
import { getPublicMediaUrl, getSafeExternalImageUrl } from "@lib/media";
export const prerender=false;
const session=await requireUser(Astro);
if(!session)return Astro.redirect(`/login/?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
const slug=Astro.params.slug??"";
const {data:event}=await (session.supabase as any).from("club_events").select("id,slug,title,description,image_object_key,image_url,starts_at,ends_at,status,visibility,capacity,registration_opens_at,registration_closes_at,instructions,cancellation_notes,venue,club_event_ticket_types(id,name,description,price_cents,currency,capacity,max_per_order,sales_open_at,sales_close_at,active,sort_order)").eq("slug",slug).maybeSingle();
if(!event)return Astro.redirect("/portal/events/?error=Event unavailable.");
const {data:tickets}=await (session.supabase as any).from("club_event_tickets").select("id,ticket_code,status,issued_at,redeemed_at,club_event_ticket_types(name)").eq("owner_user_id",session.user.id).eq("event_id",event.id).order("issued_at",{ascending:false});
const canBuy=event.status==="active"&&event.visibility!=="private"&&new Date(event.starts_at)>new Date();
const imageUrl=getPublicMediaUrl(event.image_object_key,Astro)??getSafeExternalImageUrl(event.image_url);
---
<PortalLayout title={event.title} section="Events" session={session}>
 <div class="grid gap-6 lg:grid-cols-[1fr_360px]">
  <section class="surface overflow-hidden">{imageUrl&&<img src={imageUrl} alt={`${event.title} event`} class="h-72 w-full object-cover"/>}<div class="p-6">
   <p class="eyebrow">{formatDateTime(event.starts_at)}</p><h1 class="mt-3 page-title">{event.title}</h1>
   {event.description&&<p class="mt-5 text-lg leading-8 text-eagles-ink/75">{event.description}</p>}
   <div class="mt-5 flex flex-wrap gap-2"><StatusBadge label={event.venue??"Venue TBC"} tone="ink"/><StatusBadge label={statusLabel(event.status)} tone={event.status==="active"?"green":"amber"}/></div>
   {event.instructions&&<div class="mt-6 border-t border-eagles-line pt-5"><h2 class="card-title">Event instructions</h2><p class="mt-2 whitespace-pre-line">{event.instructions}</p></div>}
   {event.status==="cancelled"&&<p class="mt-6 border border-red-200 bg-red-50 p-4 font-bold text-red-700">This event has been cancelled. {event.cancellation_notes}</p>}
  </div></section>
  <aside class="grid content-start gap-5">
   <section class="surface p-5"><h2 class="panel-title">Tickets</h2>
    {!canBuy?<p class="mt-4">Tickets are not currently available for this event.</p>:
    (event.club_event_ticket_types??[]).filter((t:any)=>t.active).length===0?<p class="mt-4">No tickets are currently available for this event.</p>:
    <div class="mt-4 grid gap-4">{(event.club_event_ticket_types??[]).filter((t:any)=>t.active).sort((a:any,b:any)=>a.sort_order-b.sort_order).map((type:any)=><form class="border-t border-eagles-line pt-4" method="post" action="/api/portal/event-ticket-order">
      <input type="hidden" name="ticket_type_id" value={type.id}/><input type="hidden" name="event_slug" value={event.slug}/>
      <p class="font-black">{type.name} — {type.price_cents===0?"Free":formatMoney(type.price_cents)}</p>{type.description&&<p class="mt-1 text-sm text-eagles-ink/65">{type.description}</p>}
      <label class="mt-3 block"><span class="label">Quantity</span><input class="field" name="quantity" type="number" min="1" max={type.max_per_order} value="1" required/></label>
      <button class="mt-3 w-full bg-eagles-green px-4 py-3 font-black text-white" style="border-radius:8px" type="submit">{type.price_cents===0?"Claim tickets":"Continue to payment"}</button>
    </form>)}</div>}
   </section>
   <section class="surface p-5"><h2 class="card-title">My tickets</h2><div class="mt-4 grid gap-3">{(tickets??[]).length===0?<p>No tickets for this event yet.</p>:(tickets??[]).map((ticket:any)=><div class="border-t border-eagles-line pt-3"><p class="font-black">{ticket.club_event_ticket_types?.name??"Event ticket"}</p><StatusBadge label={statusLabel(ticket.status)} tone={ticket.status==="valid"?"green":"amber"}/></div>)}</div>{(tickets??[]).length>0&&<a class="mt-4 inline-flex font-black text-eagles-green" href="/portal/vouchers/">Open wallet</a>}</section>
  </aside>
 </div>
</PortalLayout>
