---
import EmptyState from "@components/EmptyState.astro";
import PortalLayout from "@layouts/PortalLayout.astro";
import StatusBadge from "@components/StatusBadge.astro";
import { requireUser } from "@lib/auth/guards";
import { formatDateTime, statusLabel } from "@lib/format";
import { createSupabaseServiceClient } from "@lib/supabase/server";

export const prerender = false;

const session = await requireUser(Astro);
if (!session) return Astro.redirect("/login/");
if (session.isChildAccount) return Astro.redirect("/portal/teams/");

const [{ data: announcements }, { data: news }, { data: events }, { data: sponsors }] = await Promise.all([
  createSupabaseServiceClient(Astro)
    .from("club_announcements")
    .select("id,title,message,priority,starts_at,ends_at,status,updated_at")
    .eq("status", "active")
    .order("priority", { ascending: false })
    .order("starts_at", { ascending: false, nullsFirst: false })
    .limit(40),
  session.supabase
    .from("content_articles")
    .select("id,title,summary,category,publish_at,updated_at")
    .eq("workflow_status", "active")
    .order("publish_at", { ascending: false, nullsFirst: false })
    .limit(40),
  session.supabase
    .from("club_events")
    .select("id,title,description,starts_at,status,venues(name)")
    .eq("status", "active")
    .order("starts_at", { ascending: true })
    .limit(20),
  session.supabase
    .from("sponsors")
    .select("id,name,tier,description,website_url,display_priority,status")
    .eq("status", "active")
    .order("display_priority", { ascending: true })
    .limit(12)
]);

const items = [
  ...((announcements ?? []) as any[]).map((item) => ({ ...item, type: "Important notice", date: item.starts_at ?? item.updated_at, title: item.title, text: item.message, pinned: item.priority > 0 })),
  ...((events ?? []) as any[]).map((item) => ({ ...item, type: "Event", date: item.starts_at, title: item.title, text: item.description ?? item.venues?.name ?? "Club event" })),
  ...((news ?? []) as any[]).map((item) => ({ ...item, type: item.category ?? "News", date: item.publish_at ?? item.updated_at, title: item.title, text: item.summary ?? "Club news update" })),
  ...((sponsors ?? []) as any[]).map((item) => ({ ...item, type: "Sponsor update", date: null, title: item.name, text: item.description ?? item.tier ?? "Club partner" }))
].sort((a, b) => Number(Boolean(b.pinned)) - Number(Boolean(a.pinned)) || new Date(b.date ?? 0).getTime() - new Date(a.date ?? 0).getTime());
---

<PortalLayout title="Club Notice Board" section="Member portal" session={session}>
  <section class="grid gap-4">
    {items.length === 0 && <EmptyState title="No active club notices" text="Announcements, events, news, highlights and sponsor updates will appear here when active." />}
    {items.map((item) => (
      <article class="surface p-5 md:p-7">
        <div class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
          <div>
            <div class="flex flex-wrap gap-2">
              {item.pinned && <StatusBadge label="Pinned" tone="green" />}
              <StatusBadge label={statusLabel(item.type)} tone="ink" />
            </div>
            <h2 class="mt-3 font-display text-3xl font-black uppercase leading-none text-eagles-ink">{item.title}</h2>
            <p class="mt-3 text-sm leading-6 text-eagles-ink/75">{item.text}</p>
          </div>
          {item.date && <p class="text-sm font-bold text-eagles-ink/60">{formatDateTime(item.date)}</p>}
        </div>
      </article>
    ))}
  </section>
</PortalLayout>
