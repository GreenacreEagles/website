---
import EmptyState from "@components/EmptyState.astro";
import PortalLayout from "@layouts/PortalLayout.astro";
import StatusBadge from "@components/StatusBadge.astro";
import { requireUser } from "@lib/auth/guards";
import { formatDateTime, statusLabel } from "@lib/format";

export const prerender = false;

const session = await requireUser(Astro);
if (!session) return Astro.redirect("/login/");
if (session.isChildAccount) return Astro.redirect("/portal/teams/");

const { data: announcements } = await session.supabase
  .from("club_announcements")
  .select("id,title,message,priority,starts_at,ends_at,status,updated_at")
  .eq("status", "active")
  .order("priority", { ascending: false })
  .order("starts_at", { ascending: false, nullsFirst: false })
  .limit(40);

const items = (announcements ?? []).map((item) => ({
  ...item,
  type: "Important notice",
  date: item.starts_at ?? item.updated_at,
  text: item.message,
  pinned: item.priority > 0
}));
---

<PortalLayout title="Club Notice Board" section="Member portal" session={session}>
  <section class="grid gap-4">
    {items.length === 0 && <EmptyState title="No active club notices" text="Active club announcements will appear here." />}
    {items.map((item) => (
      <article class="surface p-5 md:p-7">
        <div class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
          <div>
            <div class="flex flex-wrap gap-2">
              {item.pinned && <StatusBadge label="Pinned" tone="green" />}
              <StatusBadge label={statusLabel(item.type)} tone="ink" />
            </div>
            <h2 class="mt-3 font-display text-3xl font-black uppercase leading-none text-eagles-ink">{item.title}</h2>
            <p class="mt-3 text-sm leading-6 text-eagles-ink/75">{item.text}</p>
          </div>
          {item.date && <p class="text-sm font-bold text-eagles-ink/60">{formatDateTime(item.date)}</p>}
        </div>
      </article>
    ))}
  </section>
</PortalLayout>
