---
import PortalLayout from"@layouts/PortalLayout.astro";import StatusBadge from"@components/StatusBadge.astro";import{requireUser}from"@lib/auth/guards";import{formatDateTime,formatMoney,statusLabel}from"@lib/format";export const prerender=false;const session=await requireUser(Astro);if(!session)return Astro.redirect(`/login/?returnTo=${encodeURIComponent(Astro.url.pathname)}`);const{data:order}=await(session.supabase as any).from("shop_orders").select("id,order_number,status,payment_status,total_cents,subtotal_cents,created_at,updated_at,completed_at,shop_order_items(id,product_name_snapshot,variant_name_snapshot,category_snapshot,quantity,unit_price_cents,line_total_cents,fulfilment_type,status),shop_fulfilments(id,fulfilment_type,status,collected_at)").eq("id",Astro.params.id).eq("user_id",session.user.id).maybeSingle();if(!order)return Astro.redirect("/portal/orders/?error=Order unavailable.");
---
<PortalLayout title={`Order ${order.order_number}`} section="Club shop" session={session}><section class="surface p-5 md:p-7">{Astro.url.searchParams.get("success")&&<p class="mb-5 border border-eagles-green bg-green-50 p-4 font-bold text-eagles-green">{Astro.url.searchParams.get("success")}</p>}{Astro.url.searchParams.get("error")&&<p class="mb-5 border border-amber-200 bg-amber-50 p-4 font-bold text-amber-800">{Astro.url.searchParams.get("error")}</p>}<p class="eyebrow">Club order</p><h1 class="mt-2 font-display text-5xl font-black uppercase">{order.order_number}</h1><p class="mt-3">{formatDateTime(order.created_at)}</p><div class="mt-4 flex gap-2"><StatusBadge label={statusLabel(order.payment_status)} tone={["paid","not_required"].includes(order.payment_status)?"green":"amber"}/><StatusBadge label={statusLabel(order.status)} tone={["ready","completed"].includes(order.status)?"green":"amber"}/></div><div class="mt-7 grid gap-4">{order.shop_order_items.map((item:any)=><article class="border-t border-eagles-line pt-4"><div class="flex justify-between gap-4"><div><h2 class="font-black">{item.quantity}× {item.product_name_snapshot}</h2>{item.variant_name_snapshot&&<p class="text-sm">{item.variant_name_snapshot}</p>}<p class="text-sm text-eagles-ink/65">{item.category_snapshot} · {statusLabel(item.fulfilment_type)} · {statusLabel(item.status)}</p></div><p class="font-black">{formatMoney(item.line_total_cents)}</p></div></article>)}</div><p class="mt-6 border-t border-eagles-line pt-5 text-3xl font-black">Total {formatMoney(order.total_cents)}</p><div class="mt-6 grid gap-2">{order.shop_fulfilments.map((f:any)=><p class="font-bold">{statusLabel(f.fulfilment_type)}: {statusLabel(f.status)}{f.collected_at?` · ${formatDateTime(f.collected_at)}`:""}</p>)}</div><div class="mt-6 flex gap-4"><a class="font-black text-eagles-green" href="/portal/vouchers/">Open wallet</a><a class="font-black text-eagles-green" href="/contact/?type=shop-order">Ask about this order</a></div></section></PortalLayout>
