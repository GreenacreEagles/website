---
import QRCode from "qrcode";
import EmptyState from "@components/EmptyState.astro";
import StatusBadge from "@components/StatusBadge.astro";
import PortalLayout from "@layouts/PortalLayout.astro";
import { requireUser } from "@lib/auth/guards";
import { formatDateTime, formatMoney } from "@lib/format";
import { canteenOrderLabel, canteenPaymentLabel } from "@lib/canteen-store";
export const prerender = false;
const session=await requireUser(Astro); if(!session)return Astro.redirect("/login/");
const {data:order,error}=await (session.supabase as any).from("canteen_orders").select("id,order_number,order_status,payment_status,payment_method,subtotal_cents,discount_cents,voucher_discount_cents,wallet_credit_cents,amount_due_cents,total_cents,pickup_code,special_instructions,created_at,canteen_order_items(product_name_snapshot,unit_price_cents_snapshot,quantity,allergen_snapshot,line_total_cents)").eq("id",Astro.params.id).maybeSingle();
if(error)console.error(error); const qr=order?.pickup_code?await QRCode.toDataURL(order.pickup_code,{width:320,margin:2,errorCorrectionLevel:"M"}):null;
---
<PortalLayout title={order?`Order ${order.order_number}`:"Order not found"} section="Canteen" session={session}>
  {!order?<EmptyState title="Order not found" text="This order does not exist or does not belong to your account." href="/portal/canteen/" action="Back to canteen"/>:<div class="grid gap-6"><header class="surface p-6 md:p-8"><a class="font-black text-eagles-green" href="/portal/canteen/">&larr; Back to canteen</a><div class="mt-5 flex flex-col gap-4 md:flex-row md:items-end md:justify-between"><div><p class="eyebrow">Canteen order</p><h1 class="mt-2 font-display text-4xl font-black uppercase md:text-6xl">{order.order_number}</h1><p class="mt-3 text-eagles-ink/65">Placed {formatDateTime(order.created_at)}</p></div><div class="flex flex-wrap gap-2"><StatusBadge label={canteenOrderLabel(order.order_status)} tone={order.order_status==="cancelled"?"red":"green"}/><StatusBadge label={canteenPaymentLabel(order.payment_status)} tone={order.payment_status==="paid"?"green":"amber"}/></div></div></header><div class="grid gap-6 xl:grid-cols-[1fr_360px]"><section class="surface p-5 md:p-7"><h2 class="font-display text-3xl font-black uppercase">Order items</h2><div class="mt-5 grid gap-4">{(order.canteen_order_items??[]).map((item:any)=><article class="flex justify-between gap-4 border-t border-eagles-line pt-4"><div><h3 class="font-black">{item.quantity}&times; {item.product_name_snapshot}</h3><p class="text-sm text-eagles-ink/65">{formatMoney(item.unit_price_cents_snapshot)} each</p>{item.allergen_snapshot?.length>0&&<p class="mt-1 text-sm">Contains: {item.allergen_snapshot.join(", ")}</p>}</div><p class="font-black">{formatMoney(item.line_total_cents)}</p></article>)}</div>{order.special_instructions&&<div class="mt-6 bg-eagles-mist p-4" style="border-radius:8px"><p class="label">Collection notes</p><p class="mt-2 text-sm">{order.special_instructions}</p></div>}</section><aside class="grid h-fit gap-6"><section class="surface p-5"><h2 class="font-display text-3xl font-black uppercase">Payment summary</h2><dl class="mt-4 grid gap-3"><div class="flex justify-between"><dt>Subtotal</dt><dd>{formatMoney(order.subtotal_cents)}</dd></div><div class="flex justify-between"><dt>Item vouchers</dt><dd>&minus;{formatMoney(order.voucher_discount_cents)}</dd></div><div class="flex justify-between"><dt>Canteen credit</dt><dd>&minus;{formatMoney(order.wallet_credit_cents)}</dd></div><div class="flex justify-between border-t border-eagles-line pt-3 font-black"><dt>Due at collection</dt><dd>{formatMoney(order.amount_due_cents)}</dd></div></dl>{order.amount_due_cents>0?<p class="mt-4 text-sm font-bold text-amber-900">Payment is due when you collect your order from the club.</p>:<p class="mt-4 text-sm font-bold text-eagles-green">This order is fully covered by your benefits.</p>}</section>{qr&&<section class="surface p-5 text-center"><h2 class="font-display text-3xl font-black uppercase">Collection QR</h2><p class="mt-2 text-sm text-eagles-ink/65">Show this code to authorised canteen staff when your order is ready.</p><img class="mx-auto mt-4 w-full max-w-64" src={qr} alt={`Collection QR code for order ${order.order_number}`}/><p class="mt-3 break-all font-mono text-sm font-black">{order.pickup_code}</p></section>}</aside></div></div>}
</PortalLayout>
