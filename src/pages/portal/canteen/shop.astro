---
import EmptyState from "@components/EmptyState.astro";
import PortalFeedback from "@components/PortalFeedback.astro";
import StatusBadge from "@components/StatusBadge.astro";
import PortalLayout from "@layouts/PortalLayout.astro";
import { requireUser } from "@lib/auth/guards";
import { formatMoney } from "@lib/format";
import { getPublicMediaUrl, getSafeExternalImageUrl } from "@lib/media";
import { loadCanteenCart, canteenCartTotals } from "@lib/canteen-store";

export const prerender = false;
const session = await requireUser(Astro);
if (!session) return Astro.redirect(`/login/?returnTo=${encodeURIComponent("/portal/canteen/shop/")}`);
if (session.isChildAccount) return Astro.redirect("/portal/vouchers/");
const query = Astro.url.searchParams.get("q")?.trim().toLowerCase() ?? "";
const category = Astro.url.searchParams.get("category") ?? "";
const stock = Astro.url.searchParams.get("stock") ?? "all";
const now = new Date().toISOString();
const [{ data: products, error: productError }, { data: categories }, cart] = await Promise.all([
  (session.supabase as any).from("canteen_products").select("id,name,description,price_cents,image_url,image_object_key,dietary_info,allergen_info,stock_quantity,max_quantity_per_order,is_active,is_sold_out,available_from,available_until,sort_order,canteen_categories(id,name,display_order)")
    .eq("is_active", true).order("sort_order").order("name").limit(120),
  (session.supabase as any).from("canteen_categories").select("id,name,display_order").eq("is_active", true).order("display_order").order("name"),
  loadCanteenCart(session.supabase)
]);
const visible = (products ?? []).filter((p: any) => (!p.available_from || p.available_from <= now) && (!p.available_until || p.available_until > now));
const filtered = visible.filter((p: any) => {
  const text = [p.name, p.description, p.canteen_categories?.name, ...(p.dietary_info ?? []), ...(p.allergen_info ?? [])].filter(Boolean).join(" ").toLowerCase();
  const inStock = !p.is_sold_out && (p.stock_quantity === null || p.stock_quantity > 0);
  return (!query || text.includes(query)) && (!category || p.canteen_categories?.id === category)
    && (stock === "all" || (stock === "in_stock" ? inStock : !inStock));
});
const totals = canteenCartTotals(cart.items);
const success = Astro.url.searchParams.get("success"); const error = Astro.url.searchParams.get("error");
---
<PortalLayout title="Canteen Shop" section="Club canteen" session={session}>
  <div class="grid gap-6 pb-20 md:pb-0"><PortalFeedback success={success} error={error ?? productError?.message ?? cart.error} />
    <header class="surface flex flex-col gap-5 p-6 md:flex-row md:items-center md:justify-between md:p-8"><div><p class="eyebrow">Greenacre Eagles</p><h1 class="mt-2 font-display text-4xl font-black uppercase leading-none md:text-6xl">Canteen Shop</h1><p class="mt-3 max-w-2xl leading-7 text-eagles-ink/70">Browse the canteen menu, use eligible vouchers or credit, and collect your order at the club.</p></div><a class="inline-flex min-h-12 items-center justify-center gap-3 bg-eagles-ink px-5 py-3 font-black text-white hover:bg-eagles-green" style="border-radius:8px" href="/portal/canteen/shop/cart/" aria-label={`View canteen cart with ${totals.quantity} items`}>View cart <span class="bg-white px-2 py-1 text-xs text-eagles-ink" style="border-radius:999px">{totals.quantity}</span></a></header>
    <form class="surface grid gap-4 p-4 lg:grid-cols-[1fr_240px_190px_auto]" method="get" role="search"><label><span class="label">Search the menu</span><input class="field" type="search" name="q" value={Astro.url.searchParams.get("q") ?? ""} placeholder="Food, drinks or dietary needs" /></label><label><span class="label">Category</span><select class="field" name="category"><option value="">All products</option>{(categories ?? []).map((c: any) => <option value={c.id} selected={category === c.id}>{c.name}</option>)}</select></label><label><span class="label">Availability</span><select class="field" name="stock"><option value="all" selected={stock === "all"}>All availability</option><option value="in_stock" selected={stock === "in_stock"}>In stock</option><option value="sold_out" selected={stock === "sold_out"}>Sold out</option></select></label><div class="flex items-end gap-2"><button class="min-h-12 flex-1 bg-eagles-green px-5 py-3 font-black text-white" style="border-radius:8px">Apply</button><a class="inline-flex min-h-12 items-center px-3 font-black text-eagles-green" href="/portal/canteen/shop/">Reset</a></div></form>
    <section class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3" aria-label="Canteen products">{filtered.length === 0 && <div class="sm:col-span-2 xl:col-span-3"><EmptyState title="No menu items match" text="Try another search, category or availability filter." href="/portal/canteen/shop/" action="View all products" /></div>}{filtered.map((p: any) => { const soldOut = p.is_sold_out || p.stock_quantity === 0; const image = getPublicMediaUrl(p.image_object_key, Astro) ?? getSafeExternalImageUrl(p.image_url); return <article class="surface flex h-full flex-col overflow-hidden">{image ? <img src={image} alt={p.name} class="aspect-[4/3] w-full object-cover" width="800" height="600" loading="lazy" /> : <div class="flex aspect-[4/3] items-center justify-center bg-eagles-mist font-display text-3xl font-black uppercase text-eagles-ink/35" role="img" aria-label={`${p.name} image unavailable`}>Eagles Canteen</div>}<div class="flex flex-1 flex-col p-5"><div class="flex items-start justify-between gap-3"><p class="eyebrow">{p.canteen_categories?.name ?? "Canteen"}</p>{soldOut && <StatusBadge label="Sold out" tone="red" />}</div><h2 class="mt-2 font-display text-3xl font-black uppercase leading-none">{p.name}</h2><p class="mt-3 text-sm leading-6 text-eagles-ink/70">{p.description ?? "Available from the club canteen."}</p><p class="mt-4 text-xl font-black text-eagles-green">{formatMoney(p.price_cents)}</p>{(p.dietary_info ?? []).length > 0 && <p class="mt-3 text-sm"><strong>Dietary:</strong> {p.dietary_info.join(", ")}</p>}{(p.allergen_info ?? []).length > 0 && <p class="mt-2 text-sm text-eagles-ink/70"><strong>Contains:</strong> {p.allergen_info.join(", ")}</p>}<form class="mt-auto grid gap-3 pt-5" method="post" action="/api/portal/canteen-cart"><input type="hidden" name="action" value="add" /><input type="hidden" name="product_id" value={p.id} /><input type="hidden" name="return_to" value="/portal/canteen/shop/" /><label><span class="label">Quantity</span><input class="field" name="quantity" type="number" inputmode="numeric" min="1" max={p.max_quantity_per_order ?? 50} value="1" required disabled={soldOut} /></label><button class="min-h-12 bg-eagles-green px-5 py-3 font-black text-white disabled:cursor-not-allowed disabled:bg-eagles-ink/35" style="border-radius:8px" disabled={soldOut}>{soldOut ? "Currently sold out" : "Add to cart"}</button></form></div></article>; })}</section>
  </div><a class="fixed bottom-4 left-4 right-4 z-40 flex min-h-12 items-center justify-center gap-3 bg-eagles-ink px-5 py-3 font-black text-white shadow-xl md:hidden" style="border-radius:8px" href="/portal/canteen/shop/cart/">View cart <span class="bg-white px-2 py-1 text-xs text-eagles-ink" style="border-radius:999px">{totals.quantity}</span></a>
</PortalLayout>
