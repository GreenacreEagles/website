---
import EmptyState from "@components/EmptyState.astro";
import PortalFeedback from "@components/PortalFeedback.astro";
import PortalLayout from "@layouts/PortalLayout.astro";
import { requireUser } from "@lib/auth/guards";
import { formatMoney } from "@lib/format";
import { getPublicMediaUrl, getSafeExternalImageUrl } from "@lib/media";
import { loadCanteenCart, canteenCartTotals } from "@lib/canteen-store";
export const prerender = false;
const session = await requireUser(Astro);
if (!session) return Astro.redirect(`/login/?returnTo=${encodeURIComponent("/portal/canteen/shop/cart/")}`);
if (session.isChildAccount) return Astro.redirect("/portal/vouchers/");
const cart = await loadCanteenCart(session.supabase); const totals = canteenCartTotals(cart.items);
---
<PortalLayout title="Canteen cart" section="Canteen Shop" session={session}>
  <div class="grid gap-6"><PortalFeedback success={Astro.url.searchParams.get("success")} error={Astro.url.searchParams.get("error") ?? cart.error} />
    <header class="surface flex flex-col gap-4 p-6 md:flex-row md:items-end md:justify-between md:p-8"><div><p class="eyebrow">Canteen Shop</p><h1 class="mt-2 font-display text-4xl font-black uppercase leading-none md:text-6xl">Your cart</h1><p class="mt-3 text-eagles-ink/70">{totals.quantity} {totals.quantity === 1 ? "item" : "items"} ready to review.</p></div><a class="font-black text-eagles-green" href="/portal/canteen/shop/">&larr; Continue shopping</a></header>
    {cart.items.length === 0 ? <EmptyState title="Your canteen cart is empty" text="Browse the canteen shop and add products before checking out." href="/portal/canteen/shop/" action="Continue shopping" /> : <div class="grid gap-6 xl:grid-cols-[1fr_360px]"><section class="grid gap-4" aria-label="Canteen cart items">{cart.items.map((item) => { const image=getPublicMediaUrl(item.image_object_key,Astro)??getSafeExternalImageUrl(item.image_url); return <article class="surface grid gap-4 p-4 sm:grid-cols-[130px_1fr] sm:p-5">{image?<img src={image} alt={item.product_name} class="aspect-square w-full object-cover" width="260" height="260" style="border-radius:8px"/>:<div class="flex aspect-square items-center justify-center bg-eagles-mist font-display text-xl font-black uppercase text-eagles-ink/35">Eagles</div>}<div><p class="eyebrow">{item.category_name}</p><div class="mt-2 flex justify-between gap-3"><div><h2 class="font-display text-2xl font-black uppercase">{item.product_name}</h2><p class="mt-1 text-sm text-eagles-ink/65">{formatMoney(item.unit_price_cents)} each</p></div><p class="font-black text-eagles-green">{formatMoney(item.unit_price_cents*item.quantity)}</p></div>{!item.is_available&&<p class="mt-3 border border-red-200 bg-red-50 p-3 text-sm font-bold text-red-700" role="alert">{item.availability_message}</p>}<div class="mt-5 flex flex-wrap items-end gap-2"><form method="post" action="/api/portal/canteen-cart"><input type="hidden" name="action" value="adjust"/><input type="hidden" name="product_id" value={item.product_id}/><input type="hidden" name="quantity" value="-1"/><input type="hidden" name="return_to" value="/portal/canteen/shop/cart/"/><button class="min-h-11 min-w-11 border border-eagles-line text-xl font-black" style="border-radius:8px" aria-label={`Decrease ${item.product_name} quantity`}>?</button></form><form class="flex items-end gap-2" method="post" action="/api/portal/canteen-cart"><input type="hidden" name="action" value="set"/><input type="hidden" name="product_id" value={item.product_id}/><input type="hidden" name="return_to" value="/portal/canteen/shop/cart/"/><label><span class="label">Quantity</span><input class="field w-24" name="quantity" type="number" min="0" max="50" value={item.quantity}/></label><button class="min-h-11 bg-eagles-ink px-4 text-sm font-black text-white" style="border-radius:8px">Update</button></form><form method="post" action="/api/portal/canteen-cart"><input type="hidden" name="action" value="adjust"/><input type="hidden" name="product_id" value={item.product_id}/><input type="hidden" name="quantity" value="1"/><input type="hidden" name="return_to" value="/portal/canteen/shop/cart/"/><button class="min-h-11 min-w-11 border border-eagles-line text-xl font-black" style="border-radius:8px" aria-label={`Increase ${item.product_name} quantity`}>+</button></form><form class="ml-auto" method="post" action="/api/portal/canteen-cart"><input type="hidden" name="action" value="remove"/><input type="hidden" name="product_id" value={item.product_id}/><input type="hidden" name="quantity" value="0"/><input type="hidden" name="return_to" value="/portal/canteen/shop/cart/"/><button class="min-h-11 px-3 text-sm font-black text-red-700">Remove</button></form></div></div></article>})}</section><aside class="surface h-fit p-5 xl:sticky xl:top-24"><h2 class="font-display text-3xl font-black uppercase">Order summary</h2><dl class="mt-5 grid gap-3"><div class="flex justify-between"><dt>Items</dt><dd class="font-bold">{totals.quantity}</dd></div><div class="flex justify-between border-t border-eagles-line pt-3 text-lg"><dt class="font-black">Subtotal</dt><dd class="font-black">{formatMoney(totals.subtotalCents)}</dd></div></dl><p class="mt-4 text-sm text-eagles-ink/65">Vouchers, canteen credit, stock and prices are checked again at checkout.</p>{totals.canCheckout?<a class="mt-5 flex min-h-12 items-center justify-center bg-eagles-green px-5 py-3 font-black text-white" style="border-radius:8px" href="/portal/canteen/shop/checkout/">Proceed to checkout</a>:<p class="mt-5 bg-amber-50 p-3 text-sm font-bold text-amber-900">Update unavailable items before checkout.</p>}<a class="mt-3 flex min-h-11 items-center justify-center font-black text-eagles-green" href="/portal/canteen/shop/">Continue shopping</a><form class="mt-3 border-t border-eagles-line pt-3" method="post" action="/api/portal/canteen-cart"><input type="hidden" name="action" value="clear"/><input type="hidden" name="return_to" value="/portal/canteen/shop/cart/"/><button class="min-h-11 w-full text-sm font-black text-red-700">Clear cart</button></form></aside></div>}
  </div>
</PortalLayout>
