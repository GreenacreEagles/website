---
import PortalFeedback from "@components/PortalFeedback.astro";
import PortalLayout from "@layouts/PortalLayout.astro";
import { requireUser } from "@lib/auth/guards";
import { formatMoney } from "@lib/format";
import { loadCanteenCart, canteenCartTotals } from "@lib/canteen-store";
export const prerender = false;
const session = await requireUser(Astro);
if (!session) return Astro.redirect(`/login/?returnTo=${encodeURIComponent("/portal/canteen/shop/checkout/")}`);
if (session.isChildAccount) return Astro.redirect("/portal/vouchers/");
const [cart, { data: wallets }, { data: vouchers }] = await Promise.all([
  loadCanteenCart(session.supabase),
  (session.supabase as any).rpc("get_canteen_checkout_wallets"),
  (session.supabase as any).rpc("get_canteen_checkout_vouchers")
]);
if (cart.items.length === 0) return Astro.redirect("/portal/canteen/shop/cart/");
const totals = canteenCartTotals(cart.items); const requestKey = crypto.randomUUID();
const cartData = JSON.stringify(cart.items.map(i => ({ product_id:i.product_id, price:i.unit_price_cents, quantity:i.quantity })));
---
<PortalLayout title="Canteen checkout" section="Canteen Shop" session={session}>
  <div class="grid gap-6"><PortalFeedback error={Astro.url.searchParams.get("error") ?? cart.error} />
    <form id="canteen-checkout" data-cart={cartData} class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_minmax(16rem,22rem)]" method="post" action="/api/portal/canteen-checkout"><input type="hidden" name="request_key" value={requestKey}/><input id="wallet-cents" type="hidden" name="wallet_cents" value="0"/>
      <div class="grid gap-6"><section class="surface p-4 sm:p-5 md:p-6"><h2 class="panel-title">Customer and collection</h2><dl class="mt-4 grid gap-2 text-sm"><div><dt class="font-black">Name</dt><dd>{session.profile.full_name}</dd></div><div><dt class="font-black">Email</dt><dd>{session.profile.email ?? session.user.email}</dd></div></dl><p class="mt-5 text-sm"><strong>Collection point:</strong> Club canteen</p><label class="mt-4 block"><span class="label">Collection notes (optional)</span><textarea class="field min-h-24" name="notes" maxlength="500"></textarea></label></section>
        <section class="surface p-4 sm:p-5 md:p-6"><h2 class="panel-title">Items</h2><div class="mt-5 grid gap-3">{cart.items.map(item=><article class="flex justify-between gap-4 border-t border-eagles-line pt-3"><div><h3 class="font-black">{item.quantity}× {item.product_name}</h3>{item.allergen_info.length>0&&<p class="text-sm text-eagles-ink/65">Contains: {item.allergen_info.join(", ")}</p>}</div><p class="font-black">{formatMoney(item.unit_price_cents*item.quantity)}</p></article>)}</div></section>
        {(vouchers??[]).length>0&&<section class="surface p-4 sm:p-5 md:p-6"><h2 class="panel-title">Vouchers</h2><p class="mt-2 text-sm text-eagles-ink/65">Tick a voucher to cover one matching item.</p><div class="mt-4 grid gap-3">{(vouchers??[]).map((v:any)=><label class="flex min-h-11 items-start gap-3 border border-eagles-line p-3" style="border-radius:8px"><input class="mt-1" type="checkbox" name="voucher_ids" value={v.voucher_id} data-voucher data-products={JSON.stringify(v.allowed_product_ids)}/><span><strong>{v.voucher_name}</strong><span class="block text-sm text-eagles-ink/65">Covers one matching item</span></span></label>)}</div></section>}
        {(wallets??[]).length>0?<section class="surface p-4 sm:p-5 md:p-6"><h2 class="panel-title">Canteen credit</h2><div class="mt-4 grid gap-4"><label><span class="label">Credit</span><select id="wallet-id" class="field" name="wallet_id"><option value="">Don't use credit</option>{(wallets??[]).map((w:any)=><option value={w.wallet_id} data-balance={w.balance_cents}>{formatMoney(w.balance_cents)} available</option>)}</select></label><label><span class="label">Amount to use</span><input id="wallet-amount" class="field" type="number" min="0" step="0.01" value="0" aria-describedby="wallet-help"/></label><p id="wallet-help" class="text-sm text-eagles-ink/65">This cannot be more than your credit or the amount still to pay.</p></div></section>:<><input id="wallet-id" type="hidden" value=""/><input id="wallet-amount" type="hidden" value="0"/></>}
        <section class="surface p-4 sm:p-5 md:p-6"><h2 class="panel-title">Payment</h2><p class="mt-3 text-sm leading-6 text-eagles-ink/70">Pay whatever is left when you collect the order from the canteen.</p></section></div>
      <aside class="surface h-fit p-5 xl:sticky xl:top-24"><h2 class="panel-title">Confirmation</h2><dl class="mt-5 grid gap-3"><div class="flex justify-between"><dt>Product subtotal</dt><dd class="font-bold">{formatMoney(totals.subtotalCents)}</dd></div><div class="flex justify-between"><dt>Item vouchers</dt><dd id="voucher-total" class="font-bold">-$0.00</dd></div><div class="flex justify-between"><dt>Canteen credit</dt><dd id="wallet-total" class="font-bold">-$0.00</dd></div><div class="flex justify-between border-t border-eagles-line pt-3 text-lg"><dt class="font-black">Pay at collection</dt><dd id="amount-due" class="font-black">{formatMoney(totals.subtotalCents)}</dd></div></dl><p class="mt-4 text-sm text-eagles-ink/65">Prices are confirmed when you place the order.</p><button id="place-order" class="mt-5 min-h-12 w-full bg-eagles-green px-5 py-3 font-black text-white disabled:cursor-wait disabled:bg-eagles-ink/50" style="border-radius:8px" disabled={!totals.canCheckout}>Place order</button><a class="mt-3 flex min-h-11 items-center justify-center font-black text-eagles-green" href="/portal/canteen/shop/cart/">Back to cart</a></aside>
    </form>
  </div>
  <script>
    const form=document.querySelector<HTMLFormElement>("#canteen-checkout"); const money=(c:number)=>new Intl.NumberFormat("en-AU",{style:"currency",currency:"AUD"}).format(c/100);
    const refresh=()=>{if(!form)return; const items=JSON.parse(form.dataset.cart||"[]"); const used=new Map<string,number>(); let voucher=0; form.querySelectorAll<HTMLInputElement>("[data-voucher]:checked").forEach(box=>{const products=JSON.parse(box.dataset.products||"[]");const item=items.find((i:any)=>products.includes(i.product_id)&&(used.get(i.product_id)||0)<i.quantity);if(item){voucher+=item.price;used.set(item.product_id,(used.get(item.product_id)||0)+1);}}); const subtotal=items.reduce((n:number,i:any)=>n+i.price*i.quantity,0); const select=form.querySelector<HTMLSelectElement>("#wallet-id"); const amount=form.querySelector<HTMLInputElement>("#wallet-amount"); const option=select?.selectedOptions[0]; const max=Number(option?.dataset.balance||0); const requested=select?.value?Math.max(0,Math.round(Number(amount?.value||0)*100)):0; const wallet=Math.min(max,requested,Math.max(0,subtotal-voucher)); if(amount)amount.max=String(max/100); const hidden=form.querySelector<HTMLInputElement>("#wallet-cents");if(hidden)hidden.value=String(wallet); document.querySelector("#voucher-total")!.textContent=`-${money(voucher)}`;document.querySelector("#wallet-total")!.textContent=`-${money(wallet)}`;document.querySelector("#amount-due")!.textContent=money(Math.max(0,subtotal-voucher-wallet));};
    form?.addEventListener("change",refresh);form?.addEventListener("input",refresh);refresh();form?.addEventListener("submit",()=>{const b=document.querySelector<HTMLButtonElement>("#place-order");if(b){b.disabled=true;b.textContent="Placing order…";b.setAttribute("aria-busy","true");}});
  </script>
</PortalLayout>
