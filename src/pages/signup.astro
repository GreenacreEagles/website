---
import BaseLayout from "@layouts/BaseLayout.astro";
import TurnstileWidget from "@components/TurnstileWidget.astro";
import { getPortalSession } from "@lib/auth/session";
import { getTurnstileSiteKey } from "@lib/security/turnstile";

export const prerender = false;

const session = await getPortalSession(Astro);
if (session) return Astro.redirect("/portal/");

const success = Astro.url.searchParams.get("success");
const error = Astro.url.searchParams.get("error");
const turnstileSiteKey = getTurnstileSiteKey();
---

<BaseLayout title="Create account" description="Create a Greenacre Eagles FC portal account.">
  <section class="section-pad bg-eagles-mist">
    <div class="section-shell grid gap-10 lg:grid-cols-[.85fr_1.15fr] lg:items-start">
      <div>
        <p class="eyebrow">Club portal</p>
        <h1 class="mt-3 page-title">Create an account</h1>
        <p class="mt-5 text-lg leading-8 text-eagles-ink/70">
          New accounts start with general portal access. Club roles are reviewed and approved by authorised administrators.
        </p>
      </div>

      <div class="surface p-5 md:p-7">
        {success && <p class="mb-5 border border-eagles-green bg-green-50 p-4 text-sm font-bold text-eagles-pine" style="border-radius:8px">{success}</p>}
        {error && <p class="mb-5 border border-red-200 bg-red-50 p-4 text-sm font-bold text-red-700" style="border-radius:8px">{error}</p>}

        <form class="grid gap-5" method="post" action="/api/auth/signup">
          <label>
            <span class="label">Full name</span>
            <input class="field" name="fullName" autocomplete="name" required />
          </label>
          <label>
            <span class="label">Email</span>
            <input class="field" name="email" type="email" autocomplete="email" required />
          </label>
          <div class="grid gap-4 md:grid-cols-2">
            <label>
              <span class="label">Password</span>
              <input class="field" name="password" type="password" autocomplete="new-password" minlength="8" required />
            </label>
            <label>
              <span class="label">Confirm password</span>
              <input class="field" name="confirmPassword" type="password" autocomplete="new-password" minlength="8" required />
            </label>
          </div>
          <label class="flex items-start gap-3 text-sm leading-6 text-eagles-ink/70">
            <input class="mt-1" name="terms" type="checkbox" required />
            <span>I agree to the club terms and privacy requirements for using the Greenacre Eagles portal.</span>
          </label>
          <TurnstileWidget action="signup" />
          <button class="focus-ring inline-flex items-center justify-center bg-eagles-green px-5 py-3 text-sm font-black text-white hover:bg-eagles-ink" style="border-radius:8px" type="submit">
            Create account
          </button>
        </form>

        <p class="mt-6 border-t border-eagles-line pt-6 text-sm text-eagles-ink/70">
          Already have an account? <a class="font-black text-eagles-green hover:text-eagles-ink" href="/login/">Sign in</a>
        </p>
      </div>
    </div>
  </section>
  {turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
</BaseLayout>
