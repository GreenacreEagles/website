---
import BaseLayout from "@layouts/BaseLayout.astro";
import ButtonLink from "@components/ButtonLink.astro";
export const prerender = true;
---

<BaseLayout title="Club Merchandise" description="Shop Greenacre Eagles FC jackets, shirts and supporter gear.">
  <section class="section-pad bg-white">
    <div class="section-shell max-w-3xl">
      <p class="eyebrow">Club merchandise</p>
      <h1 class="mt-3 page-title">Club gear</h1>
      <p class="mt-5 text-lg leading-8 text-eagles-ink/70">Choose your size, place the order, then pay when you collect it from the club.</p>
      <div class="mt-7 flex flex-col gap-3 sm:flex-row">
        <ButtonLink href="/portal/shop/" variant="primary">Shop club gear</ButtonLink>
        <ButtonLink href="/contact/?type=merchandise" variant="secondary">Ask the club</ButtonLink>
      </div>
    </div>
  </section>
</BaseLayout>
