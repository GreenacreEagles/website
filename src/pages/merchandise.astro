---
import BaseLayout from "@layouts/BaseLayout.astro";
import ButtonLink from "@components/ButtonLink.astro";
export const prerender=true;
---
<BaseLayout title="Club Merchandise" description="Shop Greenacre Eagles FC jackets, shirts and supporter gear through the club member portal."><section class="section-pad bg-white"><div class="section-shell grid gap-10 lg:grid-cols-[.9fr_1.1fr] lg:items-center"><div><p class="eyebrow">Club merchandise</p><h1 class="mt-3 page-title">Wear the Eagles colours</h1><p class="mt-5 text-lg leading-8 text-eagles-ink/70">Club jackets, shirts, training gear and supporter items are managed separately from canteen ordering.</p><p class="mt-3 text-lg leading-8 text-eagles-ink/70">Members can browse available sizes, colours and stock in the dedicated merchandise area.</p><div class="mt-7 flex flex-col gap-3 sm:flex-row"><ButtonLink href="/portal/merchandise/" variant="primary">Shop club merchandise</ButtonLink><ButtonLink href="/contact/?type=merchandise" variant="secondary">Ask about merchandise</ButtonLink></div></div><article class="surface p-6"><h2 class="panel-title">Club gear</h2><p class="mt-4 leading-7 text-eagles-ink/70">Merchandise orders and their collection status remain separate from canteen orders.</p></article></div></section></BaseLayout>
