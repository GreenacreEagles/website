---
import BaseLayout from "@layouts/BaseLayout.astro";
import ButtonLink from "@components/ButtonLink.astro";
export const prerender=true;
---
<BaseLayout title="Club Merchandise" description="Shop Greenacre Eagles FC jackets, shirts and supporter gear."><section class="section-pad bg-white"><div class="section-shell grid gap-10 lg:grid-cols-[.9fr_1.1fr] lg:items-center"><div><p class="eyebrow">Club merchandise</p><h1 class="mt-3 page-title">Wear the Eagles colours</h1><p class="mt-5 text-lg leading-8 text-eagles-ink/70">Jackets, shirts, training gear and supporter items. Sign in to see sizes and colours, then collect your order from the club.</p><div class="mt-7 flex flex-col gap-3 sm:flex-row"><ButtonLink href="/portal/merchandise/" variant="primary">Shop club merchandise</ButtonLink><ButtonLink href="/contact/?type=merchandise" variant="secondary">Ask about merchandise</ButtonLink></div></div><article class="surface p-6"><h2 class="panel-title">Club gear</h2><p class="mt-4 leading-7 text-eagles-ink/70">Order online and pick it up from the club.</p></article></div></section></BaseLayout>
