---
import BaseLayout from "@layouts/BaseLayout.astro";
import FormPanel from "@components/FormPanel.astro";
import Icon from "@components/Icon.astro";
import SectionHeading from "@components/SectionHeading.astro";
import { site } from "@data/site";

export const prerender = false;
const enquiryType = Astro.url.searchParams.get("type") ?? "";
---

<BaseLayout title="Contact Greenacre Eagles" description="Contact Greenacre Eagles Football Club about registrations, teams, volunteering, sponsorship and club activities at Allum Park.">
  <section class="section-pad bg-eagles-mist">
    <div class="section-shell grid gap-10 lg:grid-cols-[.9fr_1.1fr]">
      <div>
        <SectionHeading eyebrow="Contact" title="Visit Greenacre Eagles at Allum Park" intro="Allum Park is the home of Greenacre Eagles Football Club and where our teams train, play and come together throughout the season." />
        <p class="mt-5 leading-7 text-eagles-ink/70">Whether you have a question about registrations, teams, volunteering, sponsorship, the canteen or club merchandise, send us a message and the right person from the club will get back to you.</p>
        <div class="mt-8 grid gap-4">
          <a class="surface flex items-center gap-4 p-5 hover:border-eagles-green" href={`mailto:${site.contactEmail}`}>
            <Icon name="mail" class="h-6 w-6 text-eagles-green" />
            <span><span class="block text-sm font-black uppercase text-eagles-green">Email</span><span class="font-bold">{site.contactEmail}</span></span>
          </a>
          <div class="surface flex items-center gap-4 p-5">
            <Icon name="phone" class="h-6 w-6 text-eagles-green" />
            <span><span class="block text-sm font-black uppercase text-eagles-green">Phone</span><span class="font-bold">{site.phone}</span></span>
          </div>
          <div class="surface flex items-center gap-4 p-5">
            <Icon name="mapPin" class="h-6 w-6 text-eagles-green" />
            <span><span class="block text-sm font-black uppercase text-eagles-green">Home</span><span class="font-bold">{site.homeGround}</span></span>
          </div>
        </div>
      </div>
      <FormPanel title="Send an enquiry" intro="Tell us what you need help with and the right person from the club will get back to you." intent="Greenacre Eagles enquiry" enquiryType={enquiryType} />
    </div>
  </section>
</BaseLayout>

