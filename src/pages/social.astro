---
import BaseLayout from "@layouts/BaseLayout.astro";
import SectionHeading from "@components/SectionHeading.astro";
import { createSupabaseServerClient } from "@lib/supabase/server";
import { getPublicSocial, type PublicSocialPost, type PublicSocialProfile } from "@lib/public-social";
export const prerender = false;
const platformName = (value: string) => value[0].toUpperCase() + value.slice(1);
let profiles: PublicSocialProfile[] = [];
let posts: PublicSocialPost[] = [];
try {
  ({ profiles, posts } = await getPublicSocial(createSupabaseServerClient(Astro), Astro));
} catch (error) {
  console.error("Unable to load public social content", error);
}
---
<BaseLayout title="Follow the Eagles" description="Follow Greenacre Eagles FC on Instagram, Facebook and TikTok for club news, match-day updates, photos and community stories.">
  <section class="section-pad bg-white">
    <div class="section-shell">
      <SectionHeading
        eyebrow="Social Hub"
        title="Follow the Eagles"
        intro="Follow Greenacre Eagles across Instagram, Facebook and TikTok for match-day updates, club announcements, photos and everything happening around the Eagles community."
      />
    </div>
  </section>

  <section class="section-pad bg-eagles-mist">
    <div class="section-shell">
      <SectionHeading eyebrow="Club channels" title="Where to follow" />
      {profiles.length === 0 ? (
        <p class="surface mt-8 p-6 text-base">Greenacre Eagles social links are being updated. Please check back soon.</p>
      ) : (
        <div class="tile-grid mt-8">
          {profiles.map((profile) => (
            <a class="surface block p-4 sm:p-5" href={profile.profileUrl} target="_blank" rel="noopener noreferrer">
              <p class="eyebrow">{platformName(profile.platform)}</p>
              <h2 class="mt-2 card-title text-eagles-ink">{profile.displayName}</h2>
              {profile.username && <p class="mt-2 break-all text-sm text-eagles-ink/65">{profile.username}</p>}
              <p class="mt-4 font-black text-eagles-green">Follow on {platformName(profile.platform)}</p>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="section-pad bg-white">
    <div class="section-shell">
      <SectionHeading eyebrow="Selected social posts" title="Latest from the Eagles" />
      {posts.length === 0 ? (
        <p class="surface mt-8 p-6 text-base">Follow our social pages for the latest Greenacre Eagles updates.</p>
      ) : (
        <div class="tile-grid mt-8">
          {posts.map((post) => (
            <a class="surface block overflow-hidden" href={post.postUrl} target="_blank" rel="noopener noreferrer">
              {post.imageUrl ? <img src={post.imageUrl} alt="" class="aspect-[16/10] w-full object-cover" loading="lazy" /> : <div class="flex aspect-[16/10] items-center justify-center bg-eagles-green text-center panel-title text-white" aria-hidden="true">{platformName(post.platform)}</div>}
              <div class="p-4 sm:p-5">
                <p class="eyebrow">{platformName(post.platform)}{post.featured ? " · Featured" : ""}</p>
                {post.title && <h3 class="mt-2 card-title text-eagles-ink">{post.title}</h3>}
                {post.caption && <p class="mt-2.5 line-clamp-4 text-sm leading-6 text-eagles-ink/70">{post.caption}</p>}
                {post.publishedAt && <time class="mt-3 block text-sm text-eagles-ink/60" datetime={post.publishedAt}>{new Date(post.publishedAt).toLocaleDateString("en-AU", { day:"numeric", month:"long", year:"numeric" })}</time>}
                <p class="mt-4 font-black text-eagles-green">View on {platformName(post.platform)}</p>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
