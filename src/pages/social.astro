---
import BaseLayout from "@layouts/BaseLayout.astro";
import { createSupabaseServerClient } from "@lib/supabase/server";
import { getPublicSocial, type PublicSocialPost, type PublicSocialProfile } from "@lib/public-social";
export const prerender = false;
const platformName = (value: string) => value[0].toUpperCase() + value.slice(1);
let profiles: PublicSocialProfile[] = [];
let posts: PublicSocialPost[] = [];
try {
  ({ profiles, posts } = await getPublicSocial(createSupabaseServerClient(Astro), Astro));
} catch (error) {
  console.error("Unable to load public social content", error);
}
---
<BaseLayout title="Follow the Eagles" description="Follow Greenacre Eagles FC on Instagram, Facebook and TikTok for club news, match-day updates, photos and community stories.">
  <section class="section-pad bg-eagles-pine text-white"><div class="section-shell">
    <p class="eyebrow text-eagles-lime">Greenacre Eagles Social</p>
    <h1 class="mt-4 font-display text-6xl font-black uppercase leading-none md:text-7xl">Follow the Eagles</h1>
    <p class="mt-6 max-w-3xl text-xl leading-9 text-white/80">Follow Greenacre Eagles across Instagram, Facebook and TikTok for match-day updates, club announcements, photos and everything happening around the Eagles community.</p>
  </div></section>
  <section class="section-pad bg-eagles-mist"><div class="section-shell">
    {profiles.length === 0 ? <p class="surface p-6 text-lg">Greenacre Eagles social links are being updated. Please check back soon.</p> :
      <div class="grid gap-5 md:grid-cols-3">{profiles.map((profile) =>
        <article class="surface p-6">
          <p class="eyebrow">{platformName(profile.platform)}</p>
          <h2 class="mt-3 font-display text-3xl font-black uppercase">{profile.displayName}</h2>
          {profile.username && <p class="mt-2 text-eagles-ink/65">{profile.username}</p>}
          <a class="focus-ring mt-6 inline-flex min-h-11 items-center bg-eagles-green px-4 py-3 font-black text-white" style="border-radius:8px" href={profile.profileUrl} target="_blank" rel="noopener noreferrer" aria-label={`Follow ${profile.displayName} on ${platformName(profile.platform)} (opens in a new tab)`}>Follow on {platformName(profile.platform)}</a>
        </article>)}</div>}
  </div></section>
  <section class="section-pad bg-white"><div class="section-shell">
    <p class="eyebrow">Selected social posts</p>
    <h2 class="mt-3 font-display text-5xl font-black uppercase leading-none">Latest from the Eagles</h2>
    {posts.length === 0 ? <p class="mt-8 text-lg">Follow our social pages for the latest Greenacre Eagles updates.</p> :
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">{posts.map((post) =>
        <article class="surface overflow-hidden">
          {post.imageUrl ? <img src={post.imageUrl} alt={post.imageAltText ?? ""} class="h-64 w-full object-cover" loading="lazy" /> : <div class="flex h-64 items-center justify-center bg-eagles-green text-center font-display text-4xl font-black uppercase text-white" aria-hidden="true">{platformName(post.platform)}</div>}
          <div class="p-5">
            <p class="eyebrow">{platformName(post.platform)}{post.featured ? " · Featured" : ""}</p>
            {post.title && <h3 class="mt-3 font-display text-2xl font-black uppercase">{post.title}</h3>}
            {post.caption && <p class="mt-3 line-clamp-4 leading-7 text-eagles-ink/70">{post.caption}</p>}
            {post.publishedAt && <time class="mt-4 block text-sm text-eagles-ink/60" datetime={post.publishedAt}>{new Date(post.publishedAt).toLocaleDateString("en-AU", { day:"numeric", month:"long", year:"numeric" })}</time>}
            <a class="focus-ring mt-5 inline-flex font-black text-eagles-green underline-offset-4 hover:underline" href={post.postUrl} target="_blank" rel="noopener noreferrer" aria-label={`View on ${platformName(post.platform)} (opens in a new tab)`}>View on {platformName(post.platform)}</a>
          </div>
        </article>)}</div>}
  </div></section>
</BaseLayout>
